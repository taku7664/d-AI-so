<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Daiso.Providers.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Daiso.Core\Daiso.Core.csproj" />
    <ProjectReference Include="..\..\src\Daiso.Providers.Claude\Daiso.Providers.Claude.csproj" />
    <ProjectReference Include="..\..\src\Daiso.Providers.Codex\Daiso.Providers.Codex.csproj" />
    <ProjectReference Include="..\..\src\Daiso.Providers.Antigravity\Daiso.Providers.Antigravity.csproj" />
    <ProjectReference Include="..\..\src\Daiso.Providers.Manifest\Daiso.Providers.Manifest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\fixtures\**\*" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <!-- 특성화 스냅샷. 없으면 테스트가 지금 값을 적어 두고 실패한다 (docs/PLUGIN_PLAN.md Stage 0) -->
    <!--
      LinkBase 를 쓰지 않는다. 프로젝트 안에 있는 파일은 LinkBase 를 무시하고 프로젝트 기준 상대 경로 그대로
      출력에 놓인다(Common/Snapshots). 테스트가 그 경로를 그대로 본다
    -->
    <Content Include="Common\Snapshots\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
