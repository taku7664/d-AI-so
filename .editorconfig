# 루트 설정. old/ 에도 걸리므로 C# 은 들여쓰기만 정하고 분석기 규칙은 건드리지 않는다
root = true

[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,cjs,json,css,html}]
charset = utf-8
indent_size = 2

[*.{cs,csproj,props,targets,xml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
