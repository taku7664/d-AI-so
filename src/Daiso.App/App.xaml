<Application
    x:Class="Daiso.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                화면 공통 규칙. (ARCHITECTURE §6.2)
                간격은 4의 배수, 본문 여백 24(WinUI 권장값), 본문 폭은 Reading 1280 / Wide 창 전체, 카드는 모서리 8. 골격은 Controls/PageBody 가 강제한다.
            -->
            <!--
                제목줄 크기. WinUI TitleBar 의 기본값을 덮어쓴다.
                내장 뒤로 버튼은 폭이 TitleBarBackButtonWidth 고, 세로는 Stretch + Margin 2 라 늘 "제목줄 높이 - 4" 다.
                LeftHeader 의 앞으로·메뉴 버튼은 36x32 로 박아 두었으므로,
                제목줄을 36 으로 낮추면 뒤로도 36x32 가 되어 세 단추가 같은 상자가 된다.
                기본값은 각각 32/48/40 이고, 이 창은 LeftHeader 가 있어 48 로 그려지고 있었다.
            -->
            <x:Double x:Key="TitleBarCompactHeight">36</x:Double>
            <x:Double x:Key="TitleBarExpandedHeight">36</x:Double>
            <x:Double x:Key="TitleBarBackButtonWidth">36</x:Double>

            <x:Double x:Key="PageMaxWidth">1280</x:Double>
            <Thickness x:Key="PagePadding">24</Thickness>

            <!-- 2단 화면의 목록 칸. 세션·내 규칙·내 프롬프트가 같은 값을 쓴다. 끌어서 바꾸고(PaneSplitter) 설정에 기억한다 -->
            <GridLength x:Key="ListPaneWidth">320</GridLength>
            <x:Double x:Key="ListPaneMinWidth">220</x:Double>
            <x:Double x:Key="ListPaneMaxWidth">600</x:Double>

            <!-- 푸터 바: 저장·안내가 놓이는 줄. 위에 구분선. 저장은 언제나 여기다 -->
            <Style x:Key="FooterBorder" TargetType="Border">
                <Setter Property="Padding" Value="0,12,0,0" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- 카드: 페이지 안의 한 덩어리 -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Padding" Value="20" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <!-- 알림용 옅은 판 (안내·빈 상태) -->
            <Style x:Key="NoticeBorder" TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>

            <!-- 상태 알약 (로그인됨 / 실행 중 …) -->
            <Style x:Key="PillBorder" TargetType="Border">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 페이지 제목 · 부제 -->
            <Style x:Key="PageTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="PageSubtitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 카드 제목 -->
            <Style x:Key="SectionTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 덜 중요한 설명 -->
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 경로·id처럼 글자 폭이 일정해야 읽히는 값 -->
            <Style x:Key="MonoText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!--
                코드가 직접 칠하는 색. 여기 말고 다른 곳에 색 값을 적지 않는다.
                테마 자원(ThemeResource)으로는 표현되지 않는 자리들이다:
                로그인 상태 점(요약 화면), 알림 점(PulseDot), 제목줄(AppWindow.TitleBar 는 Brush 가 아니라 Color 를 받는다).
            -->
            <SolidColorBrush x:Key="AuthOkBrush" Color="#FF10893E" />
            <SolidColorBrush x:Key="AuthWarnBrush" Color="#FFBF7A00" />
            <SolidColorBrush x:Key="AuthErrorBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="PulseDotBrush" Color="#FFE5484D" />

            <!-- 명시적 테마(라이트/다크)에서 창 바탕과 제목줄을 칠하는 색. Mica 를 끄는 경우에만 쓴다 -->
            <Color x:Key="WindowChromeLightBackground">#FFF3F3F3</Color>
            <Color x:Key="WindowChromeDarkBackground">#FF202020</Color>
            <Color x:Key="WindowChromeLightHover">#FFE2E2E2</Color>
            <Color x:Key="WindowChromeDarkHover">#FF3A3A3A</Color>

            <!-- 표의 숫자: 오른쪽 정렬 + 고정 폭 -->
            <Style x:Key="NumberText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="HorizontalTextAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
