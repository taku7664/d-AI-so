<Application
    x:Class="Daiso.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Daiso.App.Ui">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- 목록 한 줄의 생김새. 페이지에서 빼내 모은 것 (docs/REVIEW_BACKLOG.md A3) -->
                <ui:ItemTemplates />
            </ResourceDictionary.MergedDictionaries>

            <!--
                화면 공통 규칙. (ARCHITECTURE §6.2)
                간격은 4의 배수, 본문 여백 24(WinUI 권장값), 본문 폭은 Reading 1280 / Wide 창 전체, 카드는 모서리 8. 골격은 Controls/PageBody 가 강제한다.
            -->
            <!--
                제목줄 크기. WinUI TitleBar 의 기본값을 덮어쓴다.
                뒤로·앞으로·메뉴 셋 다 LeftHeader 에 36x32 로 직접 그린다(ShellWindow.xaml).
                제목줄을 36 으로 낮춰 그 셋이 제목줄 안에 딱 맞게 한다.
                기본값은 각각 32/48/40 이고, 이 창은 LeftHeader 가 있어 48 로 그려지고 있었다.
            -->

            <!--
                ── 토큰 ────────────────────────────────────────────────────────────
                글자 크기 · 모서리 · 간격의 정본. 다른 XAML 은 숫자를 적지 않고 여기를 참조한다.
                값을 바꾸면 화면 전체가 따라 바뀐다. (docs/UI_TOKENS_PLAN.md)
                이름에 밑줄을 쓰지 않는다 — StringResourceKeysTests 가 `접두어_이름` 을 문구 키로 본다.
            -->

            <!--
                글자 크기 — 다섯 단계. 값을 바꾸면 화면 전체가 따라 바뀐다.
                예전에는 열 단계였는데 18 · 20 · 28 이 각각 한 곳뿐이라 눈금이 아니라 목록이었다.
                남긴 다섯은 전부 이미 쓰이던 값이라, 접으면서 낯선 크기가 새로 생기지 않았다.
                접은 내역: 11→12 · 13→14 · 18→16 · 22→20 · 24→20 (docs/UI_TOKENS_PLAN.md A1)
            -->
            <x:Double x:Key="CaptionFontSize">12</x:Double>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="SubtitleFontSize">16</x:Double>
            <x:Double x:Key="TitleFontSize">20</x:Double>
            <x:Double x:Key="DisplayFontSize">28</x:Double>

            <!--
                치수 — 뜻이 같아서 함께 움직여야 하는 것만 올린다.
                같은 숫자라고 다 같은 결정은 아니다: 예를 들어 160 은 진행 막대 폭이자 표의 열 폭이자
                타일 최소 폭이었다. 그런 우연을 하나로 묶으면 한쪽을 고칠 때 다른 쪽이 딸려 온다.
                (재 본 결과와 남긴 이유: docs/REVIEW_BACKLOG.md A2)
            -->
            <x:Double x:Key="StatusDotSize">10</x:Double>
            <x:Double x:Key="FilterComboWidth">120</x:Double>
            <x:Double x:Key="SettingInputWidth">200</x:Double>
            <x:Double x:Key="TitleBarButtonWidth">36</x:Double>
            <x:Double x:Key="TitleBarButtonHeight">32</x:Double>

            <!-- 모서리 -->
            <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
            <CornerRadius x:Key="RadiusPill">10</CornerRadius>
            <CornerRadius x:Key="RadiusRound">14</CornerRadius>

            <!--
                간격 — 이제 정말 4의 배수다(1 · 2 · 3 · 6 은 아이콘·배지 안쪽이라 성격이 다르다).
                눈금 밖이던 10(27곳)·14(6곳)를 8·12 로 접었다. 가장 가까운 배수, 동점이면 내림이다 —
                올리면 33곳이 한꺼번에 벌어져 창 하한(1024x700)에서 내용이 아래로 밀린다.
            -->
            <x:Double x:Key="GapHair">1</x:Double>
            <x:Double x:Key="GapTiny">2</x:Double>
            <x:Double x:Key="GapMicro">3</x:Double>
            <x:Double x:Key="GapXSmall">4</x:Double>
            <x:Double x:Key="GapSmall">6</x:Double>
            <x:Double x:Key="GapMedium">8</x:Double>
            <x:Double x:Key="GapLarge">12</x:Double>
            <x:Double x:Key="GapXLarge">16</x:Double>
            <x:Double x:Key="GapHuge">28</x:Double>

            <x:Double x:Key="PageMaxWidth">1280</x:Double>
            <Thickness x:Key="PagePadding">24</Thickness>

            <!-- 2단 화면의 목록 칸. 세션·내 규칙·내 프롬프트가 같은 값을 쓴다. 끌어서 바꾸고(PaneSplitter) 설정에 기억한다 -->
            <GridLength x:Key="ListPaneWidth">320</GridLength>
            <x:Double x:Key="ListPaneMinWidth">220</x:Double>
            <x:Double x:Key="ListPaneMaxWidth">600</x:Double>

            <!-- 푸터 바: 저장·안내가 놓이는 줄. 위에 구분선. 저장은 언제나 여기다 -->
            <Style x:Key="FooterBorder" TargetType="Border">
                <Setter Property="Padding" Value="0,12,0,0" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!--
                <b>카드가 곧 버튼이다.</b> 요약 화면의 도구 카드 (2026-09-11 사람의 요청).
                CardBorder 를 감싸는 껍데기로 두었더니 트리가 한 겹 깊어져 PageDepthTests 예산을 넘겼다 —
                겹을 더하는 대신 <b>Border 를 없애고</b> 이 버튼이 카드 생김새를 직접 갖는다.
                값은 CardBorder 와 같게 둔다: 그래야 페이지 안의 다른 카드와 한 벌로 보인다.
            -->
            <Style x:Key="ToolCardButton" TargetType="Button">
                <Setter Property="Padding" Value="20" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <!--
                목록 한 줄. 호버 칠을 <b>단추가 스스로</b> 한다 — 예전에는 줄에
                PointerEntered 처리기를 달아 손으로 칠했는데, 그러면 생김새 사전이
                코드비하인드를 갖게 되어 ItemTemplateTests 가 막는다.
                담는 목록(ListView, SelectionMode=None)에 맡기는 길도 막혔다: 칠이 보이지 않았다.
                평소 배경은 투명이라 카드 위에 떠 보이지 않고, 마우스가 올라올 때만 칠이 뜬다
            -->
            <Style x:Key="ListRowButton" TargetType="Button">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <!-- 카드: 페이지 안의 한 덩어리 -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Padding" Value="20" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <!-- 알림용 옅은 판 (안내·빈 상태) -->
            <Style x:Key="NoticeBorder" TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>

            <!-- 상태 알약 (로그인됨 / 실행 중 …) -->
            <Style x:Key="PillBorder" TargetType="Border">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 페이지 제목 · 부제 -->
            <Style x:Key="PageTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="PageSubtitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 카드 제목 -->
            <Style x:Key="SectionTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 덜 중요한 설명 -->
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 경로·id처럼 글자 폭이 일정해야 읽히는 값 -->
            <Style x:Key="MonoText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!--
                코드가 직접 칠하는 색. 여기 말고 다른 곳에 색 값을 적지 않는다.
                테마 자원(ThemeResource)으로는 표현되지 않는 자리들이다:
                로그인 상태 점(요약 화면), 알림 점(PulseDot), 제목줄(AppWindow.TitleBar 는 Brush 가 아니라 Color 를 받는다).
            -->
            <SolidColorBrush x:Key="AuthOkBrush" Color="#FF10893E" />
            <SolidColorBrush x:Key="AuthWarnBrush" Color="#FFBF7A00" />
            <SolidColorBrush x:Key="AuthErrorBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="PulseDotBrush" Color="#FFE5484D" />

            <!--
                ── 코드가 입히는 스타일 ──────────────────────────────────────────
                코드가 <c>Application.Current.Resources["…Brush"]</c> 로 브러시를 직접 꺼내면 <b>앱 테마</b>로 풀린다.
                이 앱은 테마를 창의 RootGrid 에 입히므로(ShellWindow.ApplyTheme), 다크로 두어도 꺼내온 값은 라이트의 것이고
                테마를 바꿔도 따라오지 않는다 — 다크 모드에서 상태 줄 글씨가 검게 나왔다 (2026-09-11 사람의 지적).
                스타일 안의 ThemeResource 는 그 요소의 테마로 풀리고 테마가 바뀌면 다시 풀린다. 그래서 색이 아니라 스타일을 건넨다.
            -->
            <Style x:Key="StatusBarText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- 같은 자리에 실패를 적을 때. 빨강도 테마마다 다르다 -->
            <Style x:Key="StatusBarErrorText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <!-- 칸 나누는 손잡이의 선. 끌거나 얹었을 때만 강조색이 된다 -->
            <Style x:Key="SplitterLine" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="SplitterLineActive" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>

            <!-- 알림 점. 테두리는 카드 바탕색이라 테마를 탄다 -->
            <Style x:Key="PulseDotFace" TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource PulseDotBrush}" />
                <Setter Property="Stroke" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
            </Style>

            <!-- 덜 중요한 아이콘(고르개의 꺾쇠 등) -->
            <Style x:Key="MutedIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- 명시적 테마(라이트/다크)에서 창 바탕과 제목줄을 칠하는 색. Mica 를 끄는 경우에만 쓴다 -->
            <Color x:Key="WindowChromeLightBackground">#FFF3F3F3</Color>
            <Color x:Key="WindowChromeDarkBackground">#FF202020</Color>
            <Color x:Key="WindowChromeLightHover">#FFE2E2E2</Color>
            <Color x:Key="WindowChromeDarkHover">#FF3A3A3A</Color>

            <!-- 표의 숫자: 오른쪽 정렬 + 고정 폭 -->
            <Style x:Key="NumberText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="HorizontalTextAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
