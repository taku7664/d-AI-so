<Window
    x:Class="Daiso.App.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Daiso.App.Controls"
    Title="DAIso">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- 가속기 키 풍선(Ctrl+1 …)이 본문 어디에나 떠다니지 않게. 단축키는 설정 화면에 적혀 있다 -->
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- 페이지 이동 단축키. 왼쪽 메뉴 순서와 같다 -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number5" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number6" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number7" Invoked="OnNavAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            제목줄. WinUI TitleBar 컨트롤이 아이콘·제목·창 끌기 영역·뒤로 버튼을 준다 (UI_REFACTOR_PLAN §8.1).
            뒤로는 내장 버튼, 앞으로와 메뉴 접기는 LeftHeader 슬롯. 순서는 [뒤로][앞으로][☰] 아이콘 DAIso.
            이력(NavigationHistory)은 셸 것이므로 페이지는 뒤로/앞으로를 그리지 않는다.
            뒤로·앞으로·메뉴 셋 다 LeftHeader 에 직접 그린다. 내장 뒤로 단추를 쓰면 상자는 맞출 수 있어도
            글리프 크기를 WinUI 가 정해 버려 뒤로만 작게 보였다(2026-09-10 실물 확인). 셋을 같은 단추로 두면 그럴 일이 없다.
        -->
        <muxc:TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="DAIso"
            IsBackButtonVisible="False">
            <muxc:TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/daiso.ico" />
            </muxc:TitleBar.IconSource>
            <muxc:TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXSmall}" Margin="2,0,0,0" VerticalAlignment="Center">
                    <!-- 평평하게. 잠겨도 상자가 보이지 않게 잠김 상태의 배경·테두리를 지운다 -->
                    <StackPanel.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </StackPanel.Resources>
                    <Button
                        x:Name="BackButton"
                        Width="{StaticResource TitleBarButtonWidth}"
                        Height="{StaticResource TitleBarButtonHeight}"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.AutomationId="HistoryBackButton"
                        AutomationProperties.Name="{loc:Str Key=Common_Back}"
                        ToolTipService.ToolTip="{loc:Str Key=Common_BackTip}"
                        Click="OnBackClick">
                        <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource SubtitleFontSize}" />
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        Width="{StaticResource TitleBarButtonWidth}"
                        Height="{StaticResource TitleBarButtonHeight}"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.AutomationId="HistoryForwardButton"
                        AutomationProperties.Name="{loc:Str Key=Common_Forward}"
                        ToolTipService.ToolTip="{loc:Str Key=Common_ForwardTip}"
                        Click="OnForwardClick">
                        <FontIcon Glyph="&#xE72A;" FontSize="{StaticResource SubtitleFontSize}" />
                    </Button>
                    <Button
                        Width="{StaticResource TitleBarButtonWidth}"
                        Height="{StaticResource TitleBarButtonHeight}"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.AutomationId="PaneToggleButton"
                        AutomationProperties.Name="{loc:Str Key=Common_ToggleNav}"
                        ToolTipService.ToolTip="{loc:Str Key=Common_ToggleNav}"
                        Click="OnPaneToggleClick">
                        <FontIcon Glyph="&#xE700;" FontSize="{StaticResource SubtitleFontSize}" />
                    </Button>
                </StackPanel>
            </muxc:TitleBar.LeftHeader>
        </muxc:TitleBar>

        <muxc:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            SelectionChanged="OnSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Dashboard}" Tag="Dashboard" AutomationProperties.AutomationId="NavDashboard" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Usage}" Tag="Usage" AutomationProperties.AutomationId="NavUsage">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Terminal}" Tag="Terminal" AutomationProperties.AutomationId="NavTerminal">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </muxc:NavigationViewItem.Icon>
                    <!-- 어느 방이든 안 본 답이 있으면 빨간 점 -->
                    <muxc:NavigationViewItem.InfoBadge>
                        <muxc:InfoBadge Style="{ThemeResource SuccessDotInfoBadgeStyle}" Visibility="{x:Bind Rooms.UnseenVisibility, Mode=OneWay}" />
                    </muxc:NavigationViewItem.InfoBadge>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Sessions}" Tag="Sessions" AutomationProperties.AutomationId="NavSessions">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_RuleMaker}" Tag="RuleMaker" AutomationProperties.AutomationId="NavRuleMaker">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Prompts}" Tag="Prompts" AutomationProperties.AutomationId="NavPrompts">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Settings}" Tag="Settings" AutomationProperties.AutomationId="NavSettings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <!--
                Header 의 기본 여백(NavigationViewHeaderMargin = 56,44,0,0)은 상단 탐색용이라 본문 여백과 어긋난다.
                본문 여백 24 와 같은 줄에 놓이도록 덮어쓴다 (UI_REFACTOR_PLAN §6 규칙 2)
            -->
            <muxc:NavigationView.Resources>
                <Thickness x:Key="NavigationViewHeaderMargin">24,24,0,0</Thickness>
            </muxc:NavigationView.Resources>

            <!--
                페이지 제목은 셸이 그린다 (UI_REFACTOR_PLAN §6 규칙 1). 페이지는 IPageHeaderSource 로 제목·부제를 내놓고,
                Frame.Navigated 에서 그 PageHeader 를 Header 에 싣는다. 대제목 옆에 페이지 물건이 놓일 자리가 없다
            -->
            <muxc:NavigationView.HeaderTemplate>
                <DataTemplate x:DataType="controls:PageHeader">
                    <StackPanel Spacing="{StaticResource GapTiny}" Margin="0,0,24,0">
                        <TextBlock
                            AutomationProperties.AutomationId="PageTitle"
                            Text="{x:Bind Title, Mode=OneWay}"
                            Style="{StaticResource PageTitleText}" />
                        <TextBlock
                            AutomationProperties.AutomationId="PageSubtitle"
                            Text="{x:Bind Subtitle, Mode=OneWay}"
                            Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}"
                            Style="{StaticResource PageSubtitleText}" />
                    </StackPanel>
                </DataTemplate>
            </muxc:NavigationView.HeaderTemplate>

            <Frame x:Name="ContentFrame" Navigated="OnFrameNavigated" />
        </muxc:NavigationView>

        <Border
            x:Name="StatusBar"
            Grid.Row="2"
            Padding="12,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="{StaticResource GapLarge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 색은 ApplyStatus 가 스타일로 갈아 끼운다 (App.xaml 의 StatusBarText / StatusBarErrorText) -->
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="0"
                    Style="{StaticResource StatusBarText}" />

                <muxc:ProgressBar
                    x:Name="StatusProgress"
                    Grid.Column="1"
                    Width="160"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
