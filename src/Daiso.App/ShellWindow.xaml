<Window
    x:Class="Daiso.App.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="DAIso">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- 가속기 키 풍선(Ctrl+1 …)이 본문 어디에나 떠다니지 않게. 단축키는 설정 화면에 적혀 있다 -->
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- 페이지 이동 단축키. 왼쪽 메뉴 순서와 같다 -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number5" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number6" Invoked="OnNavAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number7" Invoked="OnNavAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 제목줄: 창 테마를 따라가도록 앱이 직접 그린다 -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="36"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Margin="14,0,0,0"
                VerticalAlignment="Center">
                <Image Source="Assets/daiso.ico" Width="16" Height="16" />
                <TextBlock
                    Text="DAIso"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            SelectionChanged="OnSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Dashboard}" Tag="Dashboard" AutomationProperties.AutomationId="NavDashboard" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Usage}" Tag="Usage" AutomationProperties.AutomationId="NavUsage">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Terminal}" Tag="Terminal" AutomationProperties.AutomationId="NavTerminal">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </muxc:NavigationViewItem.Icon>
                    <!-- 어느 방이든 안 본 답이 있으면 빨간 점 -->
                    <muxc:NavigationViewItem.InfoBadge>
                        <muxc:InfoBadge Style="{ThemeResource CriticalDotInfoBadgeStyle}" Visibility="{x:Bind Rooms.UnseenVisibility, Mode=OneWay}" />
                    </muxc:NavigationViewItem.InfoBadge>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Sessions}" Tag="Sessions" AutomationProperties.AutomationId="NavSessions">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_RuleMaker}" Tag="RuleMaker" AutomationProperties.AutomationId="NavRuleMaker">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Prompts}" Tag="Prompts" AutomationProperties.AutomationId="NavPrompts">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{loc:Str Key=Nav_Settings}" Tag="Settings" AutomationProperties.AutomationId="NavSettings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>

        <Border
            x:Name="StatusBar"
            Grid.Row="2"
            Padding="12,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Style="{ThemeResource CaptionTextBlockStyle}" />

                <muxc:ProgressBar
                    x:Name="StatusProgress"
                    Grid.Column="1"
                    Width="160"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
