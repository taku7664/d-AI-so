<!--
    목록 한 줄의 생김새. 페이지에서 빼내 여기에 모았다 (docs/REVIEW_BACKLOG.md A3).

    왜 사전인가: 이 파일은 x:Class 를 가진 ResourceDictionary 라 {x:Bind} 컴파일 바인딩이 그대로 산다.
    코드로 만든 컨트롤로 옮겼다면 PropertyChanged 를 손으로 구독하게 됐을 것이고,
    그게 터미널·내 규칙 화면의 코드비하인드가 800줄대가 된 길이다.

    여기 있는 것은 전부 **자기완결적**이다 — 이벤트 핸들러가 없고 페이지 멤버를 참조하지 않는다.
    핸들러를 가진 템플릿(요약·터미널·내 규칙)은 옮기지 않았다. 그건 코드비하인드 결합을 끊는 별개의 일이다.
-->
<ResourceDictionary
    x:Class="Daiso.App.Ui.ItemTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Daiso.App.Controls"
    xmlns:vm="using:Daiso.App.ViewModels"
    xmlns:prompts="using:Daiso.Core.Prompts">

    <DataTemplate x:Key="PromptGalleryItemTemplate" x:DataType="vm:PromptGalleryItemViewModel">
        <StackPanel Spacing="{StaticResource GapTiny}" Margin="0,6,0,6" ToolTipService.ToolTip="{x:Bind Description}">
            <TextBlock Text="{x:Bind Badge}" Style="{StaticResource MutedText}" />
            <!-- BodyStrong 스타일이 TextWrapping=Wrap 을 켜 둔다. 끄지 않으면 긴 제목이 두 줄로 접혀 줄 높이가 들쭉날쭉해진다 (2026-09-11 사람의 지적) -->
            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock
                Text="{x:Bind Description}"
                Style="{StaticResource MutedText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ProjectRowTemplate" x:DataType="vm:ProjectGroupViewModel">
        <TextBlock Text="{x:Bind ComboLabel}" ToolTipService.ToolTip="{x:Bind Path}" />
    </DataTemplate>

    <DataTemplate x:Key="SearchNodeTemplate" x:DataType="muxc:TreeViewNode">
        <muxc:TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
            <TextBlock
                Text="{Binding Content}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTipService.ToolTip="{Binding Content}" />
        </muxc:TreeViewItem>
    </DataTemplate>

    <DataTemplate x:Key="SessionRowTemplate" x:DataType="vm:SessionRowViewModel">
    <Grid Padding="0,10" ColumnSpacing="{StaticResource GapLarge}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

    <CheckBox
    Grid.Column="0"
    MinWidth="28"
    VerticalAlignment="Center"
    AutomationProperties.Name="{x:Bind TitleText}"
    IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />

    <controls:ToolIcon Grid.Column="1" Kind="{x:Bind Session.Tool}" Size="26" VerticalAlignment="Center" />

    <StackPanel Grid.Column="2" Spacing="{StaticResource GapMicro}">
        <TextBlock
            Text="{x:Bind TitleText}"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            TextWrapping="NoWrap"
            TextTrimming="CharacterEllipsis"
            ToolTipService.ToolTip="{x:Bind FirstPromptText}" />
        <TextBlock
            Style="{StaticResource MutedText}"
            Text="{x:Bind MetaText}"
            ToolTipService.ToolTip="{x:Bind IdShort}" />
    </StackPanel>

    <Border
                Grid.Column="3"
                Style="{StaticResource PillBorder}"
                Visibility="{x:Bind HasBadges}">
                <TextBlock Text="{x:Bind Badges}" FontSize="{StaticResource CaptionFontSize}" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MessageRowTemplate" x:DataType="vm:MessageViewModel">
    <Grid Margin="0,0,0,12" ColumnSpacing="{StaticResource GapMedium}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

    <Rectangle
    Grid.Column="0"
    Width="3"
    RadiusX="1.5"
    RadiusY="1.5"
    VerticalAlignment="Stretch"
    Fill="{ThemeResource AccentFillColorDefaultBrush}"
    Visibility="{x:Bind UserBarVisibility}" />

    <StackPanel Grid.Column="1" Visibility="{x:Bind PlainVisibility}" Spacing="{StaticResource GapMicro}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}">
            <Border Style="{StaticResource PillBorder}">
                <TextBlock
                    Text="{x:Bind RoleText}"
                    FontSize="{StaticResource CaptionFontSize}"
                    FontWeight="SemiBold" />
            </Border>
            <TextBlock
                Text="{x:Bind TimeText}"
                Style="{StaticResource MutedText}"
                VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock
            Text="{x:Bind DisplayText, Mode=OneWay}"
            Style="{ThemeResource BodyTextBlockStyle}"
            TextWrapping="Wrap"
            IsTextSelectionEnabled="True" />
        <HyperlinkButton
            Content="{x:Bind MoreText, Mode=OneWay}"
            Visibility="{x:Bind IsTruncated}"
            Command="{x:Bind ToggleExpandedCommand}"
            Padding="0"
            FontSize="{StaticResource CaptionFontSize}" />
    </StackPanel>

    <Expander
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind CollapsibleVisibility}">
                <Expander.Header>
                    <TextBlock Style="{StaticResource MutedText}">
                        <Run Text="{x:Bind RoleText}" />
                        <Run Text="·" />
                        <Run Text="{x:Bind TimeText}" />
                    </TextBlock>
                </Expander.Header>
                <StackPanel Spacing="{StaticResource GapXSmall}">
                    <TextBlock
                        Text="{x:Bind DisplayText, Mode=OneWay}"
                        Style="{StaticResource MonoText}"
                        TextTrimming="None"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <HyperlinkButton
                        Content="{x:Bind MoreText, Mode=OneWay}"
                        Visibility="{x:Bind IsTruncated}"
                        Command="{x:Bind ToggleExpandedCommand}"
                        Padding="0"
                        FontSize="{StaticResource CaptionFontSize}" />
                </StackPanel>
            </Expander>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ContextFileTemplate" x:DataType="vm:ContextFileViewModel">
    <Grid
        ColumnSpacing="{StaticResource GapMedium}"
        Padding="0,4"
        Opacity="{x:Bind Dim}"
        ToolTipService.ToolTip="{x:Bind Summary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

    <FontIcon
    Grid.Column="0"
    Glyph="{x:Bind StateGlyph}"
    FontSize="{StaticResource CaptionFontSize}"
    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

    <TextBlock
    Grid.Column="1"
    Text="{x:Bind PathText}"
    Style="{StaticResource MonoText}" />

    <TextBlock
                Grid.Column="2"
                Text="{x:Bind CharsText}"
                Style="{StaticResource NumberText}"
                FontSize="{StaticResource CaptionFontSize}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DuplicateLineTemplate" x:DataType="x:String">
        <TextBlock
            Text="{x:Bind}"
            Style="{StaticResource MutedText}"
            TextTrimming="None"
            TextWrapping="Wrap"
            Margin="0,0,0,4" />
    </DataTemplate>

    <DataTemplate x:Key="ConflictLineTemplate" x:DataType="x:String">
        <TextBlock
            Text="{x:Bind}"
            Style="{StaticResource MutedText}"
            TextTrimming="None"
            TextWrapping="Wrap"
            Margin="0,0,0,6" />
    </DataTemplate>

    <DataTemplate x:Key="ExtraLineTemplate" x:DataType="x:String">
        <TextBlock
            Text="{x:Bind}"
            Style="{StaticResource MutedText}"
            TextTrimming="None"
            TextWrapping="Wrap" />
    </DataTemplate>

    <DataTemplate x:Key="PresetGalleryItemTemplate" x:DataType="vm:PresetGalleryItemViewModel">
        <StackPanel Spacing="{StaticResource GapTiny}" Margin="0,6,0,6" ToolTipService.ToolTip="{x:Bind Description}">
            <TextBlock Text="{x:Bind Badge}" Style="{StaticResource MutedText}" />
            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock
                Text="{x:Bind Description}"
                Style="{StaticResource MutedText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RuleEditTemplate" x:DataType="vm:RuleEditViewModel">
        <TextBlock
            Text="{x:Bind Summary, Mode=OneWay}"
            TextWrapping="NoWrap"
            TextTrimming="CharacterEllipsis"
            ToolTipService.ToolTip="{x:Bind Summary, Mode=OneWay}"
            Padding="0,6" />
    </DataTemplate>

    <DataTemplate x:Key="ResumeCandidateTemplate" x:DataType="vm:ResumeCandidateViewModel">
        <Grid ColumnSpacing="{StaticResource GapLarge}" ToolTipService.ToolTip="{x:Bind Summary}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind When}" Style="{StaticResource MutedText}" VerticalAlignment="Center" MinWidth="72" />
            <!--
                MaxWidth 가 없으면 펼친 목록이 가장 긴 제목만큼 넓어져 콤보 칸 밖으로 삐져나간다
                (팝업은 무한 폭으로 재므로 TextTrimming 만으로는 안 줄어든다)
            -->
            <TextBlock Grid.Column="1" Text="{x:Bind Summary}" MaxWidth="520" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="2"
                Text="{x:Bind Counts}"
                ToolTipService.ToolTip="{x:Bind CountsTip}"
                Style="{StaticResource MutedText}"
                VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ChatBubbleTemplate" x:DataType="vm:ChatBubbleViewModel">
        <Grid>
            <Border Visibility="{x:Bind UserVisibility}" HorizontalAlignment="Right" MaxWidth="640"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="{StaticResource RadiusPill}" Padding="12,8">
                <TextBlock Text="{x:Bind Text, Mode=OneWay}" Foreground="White" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>
            <Grid Visibility="{x:Bind AssistantVisibility}" ColumnSpacing="{StaticResource GapMedium}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="{StaticResource RadiusRound}" VerticalAlignment="Top" Background="{x:Bind AvatarBrush}">
                    <TextBlock Text="{x:Bind Avatar}" Foreground="White" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="{StaticResource GapTiny}">
                    <TextBlock Text="{x:Bind SpeakerText}" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="{StaticResource BodyFontSize}" />
                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Grid>
            <muxc:Expander Visibility="{x:Bind ToolVisibility}" HorizontalAlignment="Stretch">
                <muxc:Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}">
                        <FontIcon Glyph="&#xE756;" FontSize="{StaticResource CaptionFontSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                    </StackPanel>
                </muxc:Expander.Header>
                <TextBlock Text="{x:Bind ResultText, Mode=OneWay}" Style="{StaticResource MonoText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind ResultVisibility, Mode=OneWay}" />
            </muxc:Expander>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SlashCommandTemplate" x:DataType="prompts:SlashCommand">
        <Grid ColumnSpacing="{StaticResource GapMedium}" Padding="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind Invocation}" Style="{StaticResource MonoText}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Description}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="UsageProjectRowTemplate" x:DataType="vm:UsageRowViewModel">
        <Grid ColumnSpacing="{StaticResource GapLarge}" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="{StaticResource GapHair}">
                <TextBlock
                    Text="{x:Bind PrimaryText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Label}" />
                <TextBlock
                    Text="{x:Bind SecondaryText}"
                    Style="{StaticResource MonoText}"
                    Visibility="{x:Bind HasSecondary}" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Text="{x:Bind TotalText}"
                Style="{StaticResource NumberText}"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{x:Bind TotalExact}" />
            <TextBlock
                Grid.Column="2"
                Text="{x:Bind PercentText}"
                Style="{StaticResource NumberText}"
                VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="UsageModelRowTemplate" x:DataType="vm:UsageRowViewModel">
        <Grid ColumnSpacing="{StaticResource GapLarge}" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="{x:Bind PrimaryText}"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{x:Bind Label}" />
            <TextBlock
                Grid.Column="1"
                Text="{x:Bind TotalText}"
                Style="{StaticResource NumberText}"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{x:Bind TotalExact}" />
            <TextBlock
                Grid.Column="2"
                Text="{x:Bind PercentText}"
                Style="{StaticResource NumberText}"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="3"
                Text="{x:Bind CostText}"
                Style="{StaticResource NumberText}"
                VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ToolCardTemplate" x:DataType="vm:ToolCardViewModel">
        <!--
            카드를 <b>포커스 가능한 껍데기</b>로 감싼다 (2026-09-11 사람의 요청).
            누르면 포커스가 오고, 포커스가 오면 띠가 그 카드를 가운데로 굴린다(`DashboardPage.CenterCard`).
            껍데기는 보이지 않는다 — 배경·테두리·여백이 없어 카드 생김새를 건드리지 않고
            누를 수 있다는 것과 포커스 테두리만 더한다.
            안쪽 단추(로그인·계정·부가 정보)는 제 클릭을 스스로 먹으므로 껍데기까지 올라오지 않는다.
        -->
        <Button Style="{StaticResource ToolCardButton}" AutomationProperties.Name="{x:Bind Title}">
            <StackPanel Spacing="{StaticResource GapLarge}">
                <!-- 제목 줄: 점 · 이름 · 상태 알약 -->
                <Grid ColumnSpacing="{StaticResource GapMedium}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 로고 원 + 오른쪽 아래 상태 점(로그인 초록/노랑/빨강) -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <controls:ToolIcon Kind="{x:Bind Kind}" Size="28" />
                        <Ellipse
                            Width="{StaticResource StatusDotSize}"
                            Height="{StaticResource StatusDotSize}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,-2,-2"
                            Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            StrokeThickness="1.5"
                            Fill="{x:Bind StateBrush, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Title}"
                        Style="{StaticResource SectionTitleText}" />
                    <Border Grid.Column="2" Style="{StaticResource PillBorder}">
                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="{StaticResource CaptionFontSize}" />
                    </Border>
                </Grid>
                <!--
                    계정 칸. <b>줄 뜻이 고정이다</b>: 이름 → 이메일 → 요금제 → 만료 → 설치.
                    값이 없어도 줄을 지우지 않는다 — 도구마다 줄 수가 달라지면 카드 셋을 나란히 놓고
                    같은 자리를 비교할 수 없다 (2026-09-11 사람의 지적). 없는 값은 "… 정보 없음"으로 말한다
                -->
                <StackPanel Spacing="{StaticResource GapMicro}">
                    <TextBlock
                        Text="{x:Bind AccountText, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        ToolTipService.ToolTip="{x:Bind AccountText, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind EmailText, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource MutedText}"
                        ToolTipService.ToolTip="{x:Bind EmailText, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind PlanText, Mode=OneWay}"
                        Style="{StaticResource MutedText}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                        <FontIcon
                            Glyph="&#xE823;"
                            FontSize="{StaticResource CaptionFontSize}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind ExpiresText, Mode=OneWay}"
                            Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind InstalledText, Mode=OneWay}"
                        Style="{StaticResource MutedText}" />
                </StackPanel>
                <!--
                    부가 정보는 <b>펼치지 않고 띄운다</b>. 카드는 UniformGridLayout 의 한 칸이라 모든 칸이 같은 높이를 쓴다 —
                    Expander 를 펼치면 그 줄의 카드 셋이 다 같이 늘고, 늘어난 만큼도 칸 높이에 못 미쳐 내용이 잘렸다.
                    팝오버는 카드 밖에 그려지므로 카드 높이가 그대로다 (2026-09-11 사람의 지적)
                -->
                <muxc:DropDownButton
                    HorizontalAlignment="Left"
                    Content="{loc:Str Key=Common_Extras}"
                    AutomationProperties.AutomationId="ExtrasButton"
                    Visibility="{x:Bind HasExtras, Mode=OneWay}">
                    <muxc:DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="16" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <!--
                                줄이 많으면 팝오버 안에서 스크롤한다. 세션 화면의 부가 정보 줄과 같은 것이다.
                                <b>폭은 팝오버가 아니라 이 목록이 정한다.</b> 껍데기(FlyoutPresenter)에만 MaxWidth 를 주면
                                안쪽 ScrollViewer 가 내용에 무한 폭을 내주어 TextBlock 이 줄바꿈을 포기하고,
                                긴 줄이 껍데기 끝에서 글자째로 잘려 나갔다 — `HorizontalScrollMode="Disabled"` 로도 막히지 않았다
                                (Antigravity 의 `로그인 보관: …` 줄. 2026-09-11 화면에서 확인).
                                목록이 폭을 들고 있으면 껍데기는 그 폭 + 여백으로 따라 커진다
                            -->
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    MaxWidth="448"
                                    ItemsSource="{x:Bind Extras}"
                                    ItemTemplate="{StaticResource ExtraLineTemplate}" />
                            </ScrollViewer>
                        </Flyout>
                    </muxc:DropDownButton.Flyout>
                </muxc:DropDownButton>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}">
                    <Button
                        Content="{x:Bind LoginLabel, Mode=OneWay}"
                        Visibility="{x:Bind ShowLogin, Mode=OneWay}"
                        Command="{x:Bind LoginCommand}" />
                    <!-- 계정 저장·전환은 그 도구 카드 안에서 한다 (ARCHITECTURE §6.1) -->
                    <muxc:DropDownButton
                        Content="{x:Bind AccountsButtonText, Mode=OneWay}"
                        AutomationProperties.AutomationId="AccountsButton">
                        <muxc:DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <!-- 기본 FlyoutPresenter는 456px에서 자른다. 계정 줄(이름·계정·시각·버튼 둘)이 들어가게 넓힌다 -->
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MaxWidth" Value="620" />
                                        <Setter Property="Padding" Value="16" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <!-- 팝오버는 무한 폭으로 재어지므로 폭을 고정해야 * 열이 줄어들고 버튼이 안 잘린다 -->
                                <StackPanel Spacing="{StaticResource GapMedium}" Width="540">
                                    <TextBlock
                                        Text="{loc:Str Key=AuthProfile_Hint}"
                                        Style="{StaticResource PageSubtitleText}" />
                                    <!--
                                        이름을 여기서 받는다. 대화상자로 물으면 그것이 뜨는 순간 이 팝오버가 닫혀
                                        아래 상태 줄("저장했습니다")을 사람이 볼 수 없었다 (2026-09-11 확인)
                                    -->
                                    <Grid ColumnSpacing="{StaticResource GapMedium}" Visibility="{x:Bind CanSaveProfile}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            AutomationProperties.AutomationId="ProfileNameBox"
                                            PlaceholderText="{loc:Str Key=AuthProfile_NamePlaceholder}"
                                            Text="{x:Bind ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Content="{loc:Str Key=AuthProfile_SaveCurrent}"
                                            AutomationProperties.AutomationId="SaveProfileButton"
                                            Command="{x:Bind SaveProfileCommand}" />
                                    </Grid>

                                    <!--
                                        로그인이 파일이 아니라 자격 증명 관리자에 있는 도구. 복사해도 계정이 안 바뀌므로
                                        보관 단추를 아예 내주지 않고 왜 없는지 적는다 (docs/REVIEW_BACKLOG.md L1)
                                    -->
                                    <Border Style="{StaticResource NoticeBorder}" Visibility="{x:Bind CannotSaveProfile}">
                                        <TextBlock
                                            AutomationProperties.AutomationId="ProfileNotSupportedNote"
                                            Text="{loc:Str Key=AuthProfile_NotInFiles}"
                                            Style="{StaticResource PageSubtitleText}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Border Style="{StaticResource NoticeBorder}" Visibility="{x:Bind HasNoProfiles, Mode=OneWay}">
                                        <TextBlock Text="{loc:Str Key=AuthProfile_Empty}" Style="{StaticResource PageSubtitleText}" />
                                    </Border>
                                    <ItemsControl
                                        AutomationProperties.AutomationId="ProfileList"
                                        Visibility="{x:Bind HasProfiles, Mode=OneWay}"
                                        ItemsSource="{x:Bind Profiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AuthProfileRowViewModel">
                                                <Grid ColumnSpacing="{StaticResource GapLarge}" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="{StaticResource GapHair}" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{x:Bind Name}"
                                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                            TextWrapping="NoWrap"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedText}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        Content="{loc:Str Key=AuthProfile_Use}"
                                                        AutomationProperties.AutomationId="UseProfileButton"
                                                        Command="{x:Bind UseCommand}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Content="{loc:Str Key=Common_Delete}"
                                                        AutomationProperties.AutomationId="RemoveProfileButton"
                                                        Command="{x:Bind RemoveCommand}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        AutomationProperties.AutomationId="ProfileStatus"
                                        Text="{x:Bind ProfileStatus, Mode=OneWay}"
                                        Style="{StaticResource MutedText}"
                                        TextTrimming="None"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </muxc:DropDownButton.Flyout>
                    </muxc:DropDownButton>
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!--
        최근 세션 한 줄. 할 일은 <b>우클릭 메뉴</b>에 있다 (2026-09-11 사람의 요청).
        줄마다 재생 단추를 달아 두었더니 할 수 있는 일이 하나로 못 박혀 있었고
        (터미널로 여는 것만), 줄 오른쪽을 단추가 늘 차지했다.
        메뉴는 늘 자리를 안 먹고, 할 일이 늘어도 줄 모양이 그대로다.
    -->
    <DataTemplate x:Key="RecentSessionTemplate" x:DataType="vm:RecentSessionViewModel">
        <!--
            줄 전체가 단추다. 마우스를 올리면 단추가 스스로 칠해 <b>우클릭할 것이 있다</b>는 신호를 준다
            (2026-09-11 사람의 요청). 재생 단추를 없앤 자리를 우클릭 메뉴가 대신한다.
            칠을 손으로 하지 않는 이유는 ListRowButton 주석에 적었다
        -->
        <Button Style="{StaticResource ListRowButton}" AutomationProperties.Name="{x:Bind ProjectText}">
            <Button.ContextFlyout>
                <MenuFlyout>
                    <!-- 아이콘은 좌측 메뉴의 터미널·세션 것과 같다. 가는 곳이 같으면 표시도 같아야 한다 -->
                    <MenuFlyoutItem
                        Text="{loc:Str Key=Dashboard_OpenInTerminal}"
                        AutomationProperties.AutomationId="ResumeRecentMenuItem"
                        Command="{x:Bind ResumeCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE756;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Text="{loc:Str Key=Dashboard_OpenDetails}"
                        AutomationProperties.AutomationId="OpenDetailsMenuItem"
                        Command="{x:Bind OpenDetailsCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8BD;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.ContextFlyout>
            <Grid ColumnSpacing="{StaticResource GapLarge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:ToolIcon Grid.Column="0" Kind="{x:Bind Session.Tool}" Size="24" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="{StaticResource GapHair}">
                    <TextBlock
                        Text="{x:Bind ProjectText}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind PathText}" />
                    <TextBlock Text="{x:Bind MetaText}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>

</ResourceDictionary>
