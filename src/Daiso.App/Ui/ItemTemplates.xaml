<!--
    목록 한 줄의 생김새. 페이지에서 빼내 여기에 모았다 (docs/REVIEW_BACKLOG.md A3).

    왜 사전인가: 이 파일은 x:Class 를 가진 ResourceDictionary 라 {x:Bind} 컴파일 바인딩이 그대로 산다.
    코드로 만든 컨트롤로 옮겼다면 PropertyChanged 를 손으로 구독하게 됐을 것이고,
    그게 터미널·내 규칙 화면의 코드비하인드가 800줄대가 된 길이다.

    여기 있는 것은 전부 **자기완결적**이다 — 이벤트 핸들러가 없고 페이지 멤버를 참조하지 않는다.
    핸들러를 가진 템플릿(요약·터미널·내 규칙)은 옮기지 않았다. 그건 코드비하인드 결합을 끊는 별개의 일이다.
-->
<ResourceDictionary
    x:Class="Daiso.App.Ui.ItemTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Daiso.App.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <DataTemplate x:Key="PromptGalleryItemTemplate" x:DataType="vm:PromptGalleryItemViewModel">
        <StackPanel Spacing="{StaticResource GapTiny}" Margin="0,6,0,6" ToolTipService.ToolTip="{x:Bind Description}">
            <TextBlock Text="{x:Bind Badge}" Style="{StaticResource MutedText}" />
            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock
                Text="{x:Bind Description}"
                Style="{StaticResource MutedText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ProjectRowTemplate" x:DataType="vm:ProjectGroupViewModel">
        <TextBlock Text="{x:Bind ComboLabel}" ToolTipService.ToolTip="{x:Bind Path}" />
    </DataTemplate>

    <DataTemplate x:Key="SearchNodeTemplate" x:DataType="muxc:TreeViewNode">
        <muxc:TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
            <TextBlock
                Text="{Binding Content}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTipService.ToolTip="{Binding Content}" />
        </muxc:TreeViewItem>
    </DataTemplate>

    <DataTemplate x:Key="SessionRowTemplate" x:DataType="vm:SessionRowViewModel">
    <Grid Padding="0,10" ColumnSpacing="{StaticResource GapLarge}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

    <CheckBox
    Grid.Column="0"
    MinWidth="28"
    VerticalAlignment="Center"
    AutomationProperties.Name="{x:Bind TitleText}"
    IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />

    <controls:ToolIcon Grid.Column="1" Kind="{x:Bind Session.Tool}" Size="26" VerticalAlignment="Center" />

    <StackPanel Grid.Column="2" Spacing="{StaticResource GapMicro}">
        <TextBlock
            Text="{x:Bind TitleText}"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            TextWrapping="NoWrap"
            TextTrimming="CharacterEllipsis"
            ToolTipService.ToolTip="{x:Bind FirstPromptText}" />
        <TextBlock
            Style="{StaticResource MutedText}"
            Text="{x:Bind MetaText}"
            ToolTipService.ToolTip="{x:Bind IdShort}" />
    </StackPanel>

    <Border
                Grid.Column="3"
                Style="{StaticResource PillBorder}"
                Visibility="{x:Bind HasBadges}">
                <TextBlock Text="{x:Bind Badges}" FontSize="{StaticResource CaptionFontSize}" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MessageRowTemplate" x:DataType="vm:MessageViewModel">
    <Grid Margin="0,0,0,12" ColumnSpacing="{StaticResource GapMedium}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

    <Rectangle
    Grid.Column="0"
    Width="3"
    RadiusX="1.5"
    RadiusY="1.5"
    VerticalAlignment="Stretch"
    Fill="{ThemeResource AccentFillColorDefaultBrush}"
    Visibility="{x:Bind UserBarVisibility}" />

    <StackPanel Grid.Column="1" Visibility="{x:Bind PlainVisibility}" Spacing="{StaticResource GapMicro}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}">
            <Border Style="{StaticResource PillBorder}">
                <TextBlock
                    Text="{x:Bind RoleText}"
                    FontSize="{StaticResource CaptionFontSize}"
                    FontWeight="SemiBold" />
            </Border>
            <TextBlock
                Text="{x:Bind TimeText}"
                Style="{StaticResource MutedText}"
                VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock
            Text="{x:Bind DisplayText, Mode=OneWay}"
            Style="{ThemeResource BodyTextBlockStyle}"
            TextWrapping="Wrap"
            IsTextSelectionEnabled="True" />
        <HyperlinkButton
            Content="{x:Bind MoreText, Mode=OneWay}"
            Visibility="{x:Bind IsTruncated}"
            Command="{x:Bind ToggleExpandedCommand}"
            Padding="0"
            FontSize="{StaticResource CaptionFontSize}" />
    </StackPanel>

    <Expander
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind CollapsibleVisibility}">
                <Expander.Header>
                    <TextBlock Style="{StaticResource MutedText}">
                        <Run Text="{x:Bind RoleText}" />
                        <Run Text="·" />
                        <Run Text="{x:Bind TimeText}" />
                    </TextBlock>
                </Expander.Header>
                <StackPanel Spacing="{StaticResource GapXSmall}">
                    <TextBlock
                        Text="{x:Bind DisplayText, Mode=OneWay}"
                        Style="{StaticResource MonoText}"
                        TextTrimming="None"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <HyperlinkButton
                        Content="{x:Bind MoreText, Mode=OneWay}"
                        Visibility="{x:Bind IsTruncated}"
                        Command="{x:Bind ToggleExpandedCommand}"
                        Padding="0"
                        FontSize="{StaticResource CaptionFontSize}" />
                </StackPanel>
            </Expander>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ContextFileTemplate" x:DataType="vm:ContextFileViewModel">
    <Grid
        ColumnSpacing="{StaticResource GapMedium}"
        Padding="0,4"
        Opacity="{x:Bind Dim}"
        ToolTipService.ToolTip="{x:Bind Summary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

    <FontIcon
    Grid.Column="0"
    Glyph="{x:Bind StateGlyph}"
    FontSize="{StaticResource CaptionFontSize}"
    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

    <TextBlock
    Grid.Column="1"
    Text="{x:Bind PathText}"
    Style="{StaticResource MonoText}" />

    <TextBlock
                Grid.Column="2"
                Text="{x:Bind CharsText}"
                Style="{StaticResource NumberText}"
                FontSize="{StaticResource CaptionFontSize}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DuplicateLineTemplate" x:DataType="x:String">
        <TextBlock
            Text="{x:Bind}"
            Style="{StaticResource MutedText}"
            TextTrimming="None"
            TextWrapping="Wrap"
            Margin="0,0,0,4" />
    </DataTemplate>

    <DataTemplate x:Key="ConflictLineTemplate" x:DataType="x:String">
        <TextBlock
            Text="{x:Bind}"
            Style="{StaticResource MutedText}"
            TextTrimming="None"
            TextWrapping="Wrap"
            Margin="0,0,0,6" />
    </DataTemplate>

    <DataTemplate x:Key="ExtraLineTemplate" x:DataType="x:String">
        <TextBlock
            Text="{x:Bind}"
            Style="{StaticResource MutedText}"
            TextTrimming="None"
            TextWrapping="Wrap" />
    </DataTemplate>

</ResourceDictionary>
