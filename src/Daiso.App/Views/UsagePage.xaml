<Page
    x:Class="Daiso.App.Views.UsagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Daiso.App.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <!-- 골격은 PageBody 가 정한다: 명령 줄 → 필터 줄 → 본문. 여백 24, 줄 사이 12, 폭은 Reading(1280 상한) (UI_REFACTOR_PLAN §6) -->
    <controls:PageBody Layout="Reading">
        <controls:PageBody.Commands>
            <StackPanel Spacing="{StaticResource GapLarge}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}">
                    <ComboBox
                        Width="120"
                        AutomationProperties.AutomationId="UsagePeriodCombo"
                        AutomationProperties.Name="{loc:Str Key=Common_Period}"
                        ItemsSource="{x:Bind Usage.Periods}"
                        SelectedIndex="{x:Bind Usage.PeriodIndex, Mode=TwoWay}" />

                    <Button
                        AutomationProperties.AutomationId="UsageReloadButton"
                        ToolTipService.ToolTip="{loc:Str Key=Common_ReloadTip}"
                        Command="{x:Bind Usage.LoadCommand}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}">
                            <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource BodyFontSize}" />
                            <TextBlock Text="{loc:Str Key=Common_Reload}" />
                        </StackPanel>
                    </Button>

                    <!-- 지금 보는 기간. 부제는 고정 설명이므로 상태값은 여기다 -->
                    <TextBlock
                        AutomationProperties.AutomationId="UsageStatus"
                        Text="{x:Bind Usage.StatusText, Mode=OneWay}"
                        Style="{StaticResource MutedText}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <muxc:ProgressBar
                    IsIndeterminate="True"
                    Visibility="{x:Bind Usage.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </controls:PageBody.Commands>

        <!-- 필터 줄: 전체 · 도구별. 아래 모든 카드가 탭을 따른다 (요약과 같은 규칙) -->
        <controls:PageBody.Filters>
                <muxc:SelectorBar x:Name="ToolTabs" SelectionChanged="OnToolTabChanged" AutomationProperties.AutomationId="ToolTabs">
                    <muxc:SelectorBarItem Text="{loc:Str Key=Common_All}" IsSelected="True" AutomationProperties.AutomationId="ToolTabAll" />
                    <muxc:SelectorBarItem Text="Codex" AutomationProperties.AutomationId="ToolTabCodex" />
                    <muxc:SelectorBarItem Text="Claude" AutomationProperties.AutomationId="ToolTabClaude" />
                    <muxc:SelectorBarItem Text="Antigravity" AutomationProperties.AutomationId="ToolTabAntigravity" />
                </muxc:SelectorBar>
        </controls:PageBody.Filters>

        <controls:PageBody.Body>
            <StackPanel Spacing="{StaticResource GapXLarge}">
                <!-- 추정 비용 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="{StaticResource GapMedium}">
                        <TextBlock
                            AutomationProperties.AutomationId="UsageCost"
                            Text="{x:Bind Usage.EstimatedCostText, Mode=OneWay}"
                            FontSize="{StaticResource TitleFontSize}"
                            FontWeight="SemiBold" />

                        <!-- 비어 있음 안내는 어디서나 NoticeBorder + 한 문장 (+ 다음에 할 일 버튼) 한 모양이다 -->
                        <Border Style="{StaticResource NoticeBorder}" Visibility="{x:Bind Usage.NeedsPrices, Mode=OneWay}">
                            <Grid ColumnSpacing="{StaticResource GapLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{loc:Str Key=Usage_PriceHint}" Style="{StaticResource PageSubtitleText}" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{loc:Str Key=Usage_OpenSettings}"
                                    AutomationProperties.AutomationId="GoToPricesButton"
                                    Click="OnGoToPricesClick" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 비어 있을 때 -->
                <Border
                    Style="{StaticResource NoticeBorder}"
                    Visibility="{x:Bind Usage.IsEmpty, Mode=OneWay}">
                    <TextBlock Text="{loc:Str Key=Usage_Empty}" Style="{StaticResource PageSubtitleText}" />
                </Border>

                <!-- 일별 -->
                <Border
                    Style="{StaticResource CardBorder}"
                    Visibility="{x:Bind Usage.HasData, Mode=OneWay}"
                    PointerMoved="OnDayAreaMoved"
                    PointerExited="OnDayAreaLeft"
                    PointerCanceled="OnDayAreaLeft"
                    PointerCaptureLost="OnDayAreaLeft">
                    <StackPanel Spacing="{StaticResource GapMedium}">
                        <TextBlock Text="{loc:Str Key=Usage_Daily}" Style="{StaticResource SectionTitleText}" />

                        <ItemsControl ItemsSource="{x:Bind Usage.Days}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UsageDayViewModel">
                                    <!-- 호버: 줄 배경이 켜지고(코드 비하인드) 정확한 수치·내역은 툴팁으로 나온다 -->
                                    <Grid
                                        ToolTipService.ToolTip="{x:Bind HoverText}"
                                        ColumnSpacing="{StaticResource GapLarge}"
                                        Margin="0,0,0,2"
                                        Padding="6,4"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Background="Transparent"
                                        Loaded="OnDayRowLoaded"
                                        Unloaded="OnDayRowUnloaded">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind DateText}"
                                            Style="{StaticResource MutedText}"
                                            VerticalAlignment="Center" />

                                        <Rectangle
                                            Grid.Column="1"
                                            Height="12"
                                            HorizontalAlignment="Left"
                                            RadiusX="6"
                                            RadiusY="6"
                                            Width="{x:Bind BarWidth}"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind TotalText}"
                                            Style="{StaticResource NumberText}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center" />

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 프로젝트별 -->
                <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind Usage.HasData, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource GapMedium}">
                        <TextBlock Text="{loc:Str Key=Usage_TopProjects}" Style="{StaticResource SectionTitleText}" />

                        <Grid ColumnSpacing="{StaticResource GapLarge}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str Key=Usage_ProjectColumn}" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Column="1" Text="{loc:Str Key=Usage_TokensColumn}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{loc:Str Key=Usage_ShareColumn}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind Usage.TopProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UsageRowViewModel">
                                    <Grid ColumnSpacing="{StaticResource GapLarge}" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="{StaticResource GapHair}">
                                            <TextBlock
                                                Text="{x:Bind PrimaryText}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Label}" />
                                            <TextBlock
                                                Text="{x:Bind SecondaryText}"
                                                Style="{StaticResource MonoText}"
                                                Visibility="{x:Bind HasSecondary}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind TotalText}"
                                            Style="{StaticResource NumberText}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind TotalExact}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind PercentText}"
                                            Style="{StaticResource NumberText}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 모델별 -->
                <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind Usage.HasData, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource GapMedium}">
                        <TextBlock Text="{loc:Str Key=Usage_ByModel}" Style="{StaticResource SectionTitleText}" />

                        <Grid ColumnSpacing="{StaticResource GapLarge}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str Key=Usage_ModelColumn}" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Column="1" Text="{loc:Str Key=Usage_TokensColumn}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{loc:Str Key=Usage_ShareColumn}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{loc:Str Key=Usage_CostColumn}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind Usage.ByModel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UsageRowViewModel">
                                    <Grid ColumnSpacing="{StaticResource GapLarge}" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind PrimaryText}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind Label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind TotalText}"
                                            Style="{StaticResource NumberText}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind TotalExact}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind PercentText}"
                                            Style="{StaticResource NumberText}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind CostText}"
                                            Style="{StaticResource NumberText}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="{loc:Str Key=Dashboard_CostNote}"
                    Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
        </controls:PageBody.Body>
    </controls:PageBody>
</Page>
