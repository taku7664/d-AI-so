<Page
    x:Class="Daiso.App.Views.RuleMakerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 제목 · 파일 메뉴 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{loc:Str Key=RuleMaker_Title}"
                Style="{StaticResource PageTitleText}" />

            <muxc:CommandBar
                Grid.Column="1"
                DefaultLabelPosition="Right"
                HorizontalAlignment="Left"
                Background="Transparent">
                <muxc:AppBarButton
                    Label="{loc:Str Key=RuleMaker_New}"
                    Icon="Add"
                    AutomationProperties.AutomationId="NewButton"
                    Command="{x:Bind ViewModel.NewCommand}" />
                <muxc:AppBarButton
                    Label="{loc:Str Key=Common_Open}"
                    Icon="OpenFile"
                    AutomationProperties.AutomationId="OpenButton"
                    Click="OnOpenClick">
                    <muxc:AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </muxc:AppBarButton.KeyboardAccelerators>
                </muxc:AppBarButton>
                <muxc:AppBarButton
                    Label="{loc:Str Key=Common_Save}"
                    Icon="Save"
                    AutomationProperties.AutomationId="SaveButton"
                    Click="OnSaveClick">
                    <muxc:AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </muxc:AppBarButton.KeyboardAccelerators>
                </muxc:AppBarButton>
                <muxc:AppBarSeparator />
                <muxc:AppBarButton
                    Label="{loc:Str Key=RuleMaker_Migrate}"
                    Icon="Sync"
                    AutomationProperties.AutomationId="MigrateButton"
                    Click="OnMigrateClick" />

                <muxc:CommandBar.SecondaryCommands>
                    <muxc:AppBarButton
                        Label="{loc:Str Key=RuleMaker_SaveAs}"
                        Icon="SaveLocal"
                        AutomationProperties.AutomationId="SaveAsButton"
                        Click="OnSaveAsClick" />
                    <muxc:AppBarButton
                        Label="{loc:Str Key=RuleMaker_Recent}"
                        Icon="Clock"
                        AutomationProperties.AutomationId="RecentButton">
                        <muxc:AppBarButton.Flyout>
                            <MenuFlyout x:Name="RecentFlyout" />
                        </muxc:AppBarButton.Flyout>
                    </muxc:AppBarButton>
                    <muxc:AppBarButton
                        Label="{loc:Str Key=RuleMaker_Library}"
                        Icon="Library"
                        AutomationProperties.AutomationId="LibraryButton">
                        <muxc:AppBarButton.Flyout>
                            <MenuFlyout x:Name="LibraryFlyout" />
                        </muxc:AppBarButton.Flyout>
                    </muxc:AppBarButton>
                    <muxc:AppBarButton
                        Label="{loc:Str Key=RuleMaker_LinkProject}"
                        Icon="Link"
                        AutomationProperties.AutomationId="LinkButton"
                        Click="OnLinkClick" />
                </muxc:CommandBar.SecondaryCommands>
            </muxc:CommandBar>
        </Grid>

        <!-- 이름 · 설명 · 프로젝트 폴더 -->
        <StackPanel Grid.Row="1" Spacing="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="{loc:Str Key=RuleMaker_Name}"
                    AutomationProperties.AutomationId="NameBox"
                    Text="{x:Bind ViewModel.PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    Grid.Column="1"
                    Header="{loc:Str Key=RuleMaker_Description}"
                    AutomationProperties.AutomationId="DescriptionBox"
                    Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="{loc:Str Key=RuleMaker_ProjectFolder}"
                    PlaceholderText="{loc:Str Key=RuleMaker_ProjectFolderPlaceholder}"
                    AutomationProperties.AutomationId="ProjectDirBox"
                    Text="{x:Bind ViewModel.ProjectDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="BrowseProjectButton"
                    Click="OnBrowseProjectClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="{loc:Str Key=Common_PickFolder}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Content="{loc:Str Key=RuleMaker_Link}"
                    VerticalAlignment="Bottom"
                    Style="{ThemeResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="LinkTypedButton"
                    Click="OnLinkTypedClick" />
            </Grid>
        </StackPanel>

        <!-- 본문 -->
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <!-- 항상 적용되는 행동 -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{loc:Str Key=RuleMaker_GlobalHeader}"
                                    Style="{StaticResource SectionTitleText}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="AddGlobalButton"
                                    Command="{x:Bind ViewModel.AddGlobalActionCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                                        <TextBlock Text="{loc:Str Key=RuleMaker_AddAction}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Global}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionEditViewModel">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                Grid.Column="0"
                                                PlaceholderText="{loc:Str Key=RuleMaker_ActionPlaceholder}"
                                                Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <ComboBox
                                                Grid.Column="1"
                                                SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="MUST" />
                                                <ComboBoxItem Content="SHOULD" />
                                                <ComboBoxItem Content="MAY" />
                                            </ComboBox>

                                            <Button
                                                Grid.Column="2"
                                                AutomationProperties.Name="{loc:Str Key=RuleMaker_MoveUp}"
                                                ToolTipService.ToolTip="{loc:Str Key=RuleMaker_MoveUp}"
                                                Click="OnGlobalUpClick"
                                                DataContext="{x:Bind}">
                                                <FontIcon Glyph="&#xE74A;" FontSize="12" />
                                            </Button>
                                            <Button
                                                Grid.Column="3"
                                                AutomationProperties.Name="{loc:Str Key=RuleMaker_MoveDown}"
                                                ToolTipService.ToolTip="{loc:Str Key=RuleMaker_MoveDown}"
                                                Click="OnGlobalDownClick"
                                                DataContext="{x:Bind}">
                                                <FontIcon Glyph="&#xE74B;" FontSize="12" />
                                            </Button>
                                            <Button
                                                Grid.Column="4"
                                                AutomationProperties.Name="{loc:Str Key=Common_Delete}"
                                                ToolTipService.ToolTip="{loc:Str Key=Common_Delete}"
                                                Click="OnGlobalRemoveClick"
                                                DataContext="{x:Bind}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 규칙 목록 -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{loc:Str Key=RuleMaker_Rules}"
                                    Style="{StaticResource SectionTitleText}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="AddRuleButton"
                                    Command="{x:Bind ViewModel.AddRuleCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                                        <TextBlock Text="{loc:Str Key=RuleMaker_AddRule}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ListView
                                AutomationProperties.AutomationId="RuleList"
                                ItemsSource="{x:Bind ViewModel.Rules}"
                                SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}"
                                MaxHeight="150">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuleEditViewModel">
                                        <TextBlock
                                            Text="{x:Bind Summary, Mode=OneWay}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Padding="0,6" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- 선택한 규칙 -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{loc:Str Key=RuleMaker_ConditionTree}"
                                    Style="{StaticResource SectionTitleText}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{loc:Str Key=RuleMaker_SelectedNodeHint}"
                                    Style="{StaticResource MutedText}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <muxc:DropDownButton AutomationProperties.AutomationId="AddNodeButton">
                                    <muxc:DropDownButton.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                                            <TextBlock Text="{loc:Str Key=RuleMaker_Add}" />
                                        </StackPanel>
                                    </muxc:DropDownButton.Content>
                                    <muxc:DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{loc:Str Key=RuleMaker_AddLeaf}" AutomationProperties.AutomationId="AddLeafButton" Click="OnAddLeafClick" />
                                            <MenuFlyoutItem Text="{loc:Str Key=RuleMaker_AddAnd}" Click="OnAddAndClick" />
                                            <MenuFlyoutItem Text="{loc:Str Key=RuleMaker_AddOr}" Click="OnAddOrClick" />
                                            <MenuFlyoutItem Text="{loc:Str Key=RuleMaker_AddNot}" Click="OnAddNotClick" />
                                        </MenuFlyout>
                                    </muxc:DropDownButton.Flyout>
                                </muxc:DropDownButton>

                                <muxc:DropDownButton AutomationProperties.AutomationId="WrapNodeButton">
                                    <muxc:DropDownButton.Content>
                                        <TextBlock Text="{loc:Str Key=RuleMaker_Wrap}" />
                                    </muxc:DropDownButton.Content>
                                    <muxc:DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{loc:Str Key=RuleMaker_WrapAnd}" AutomationProperties.AutomationId="WrapAndButton" Click="OnWrapAndClick" />
                                            <MenuFlyoutItem Text="{loc:Str Key=RuleMaker_WrapOr}" Click="OnWrapOrClick" />
                                            <MenuFlyoutItem Text="{loc:Str Key=RuleMaker_WrapNot}" Click="OnWrapNotClick" />
                                        </MenuFlyout>
                                    </muxc:DropDownButton.Flyout>
                                </muxc:DropDownButton>

                                <Button
                                    AutomationProperties.Name="{loc:Str Key=RuleMaker_MoveUp}"
                                    ToolTipService.ToolTip="{loc:Str Key=RuleMaker_MoveUp}"
                                    Click="OnNodeUpClick">
                                    <FontIcon Glyph="&#xE74A;" FontSize="12" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{loc:Str Key=RuleMaker_MoveDown}"
                                    ToolTipService.ToolTip="{loc:Str Key=RuleMaker_MoveDown}"
                                    Click="OnNodeDownClick">
                                    <FontIcon Glyph="&#xE74B;" FontSize="12" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{loc:Str Key=RuleMaker_DeleteNode}"
                                    ToolTipService.ToolTip="{loc:Str Key=RuleMaker_DeleteNode}"
                                    Click="OnNodeDeleteClick">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>

                            <muxc:TreeView
                                x:Name="ConditionTree"
                                AutomationProperties.AutomationId="ConditionTree"
                                SelectionMode="Single"
                                CanDragItems="True"
                                AllowDrop="True"
                                CanReorderItems="True"
                                MinHeight="160"
                                DragItemsCompleted="OnTreeDragCompleted">
                                <muxc:TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConditionNodeViewModel">
                                        <muxc:TreeViewItem
                                            ItemsSource="{x:Bind Children}"
                                            IsExpanded="True">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind Label, Mode=OneWay}"
                                                    VerticalAlignment="Center" />

                                                <TextBox
                                                    Grid.Column="1"
                                                    MinWidth="220"
                                                    Visibility="{x:Bind LeafVisibility, Mode=OneWay}"
                                                    PlaceholderText="{loc:Str Key=RuleMaker_ConditionPlaceholder}"
                                                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </muxc:TreeViewItem>
                                    </DataTemplate>
                                </muxc:TreeView.ItemTemplate>
                            </muxc:TreeView>

                            <Border Style="{StaticResource NoticeBorder}">
                                <TextBlock
                                    AutomationProperties.AutomationId="ConditionPreview"
                                    Text="{x:Bind ViewModel.SelectedRule.ConditionPreview, Mode=OneWay}"
                                    Style="{StaticResource MonoText}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    TextTrimming="None"
                                    TextWrapping="Wrap" />
                            </Border>

                            <Grid ColumnSpacing="12" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{loc:Str Key=RuleMaker_Actions}"
                                    Style="{StaticResource SectionTitleText}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="AddRuleActionButton"
                                    Click="OnAddRuleActionClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                                        <TextBlock Text="{loc:Str Key=RuleMaker_AddAction}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedRule.Actions, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionEditViewModel">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                Grid.Column="0"
                                                PlaceholderText="{loc:Str Key=RuleMaker_ActionPlaceholder}"
                                                Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <ComboBox
                                                Grid.Column="1"
                                                SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="MUST" />
                                                <ComboBoxItem Content="SHOULD" />
                                                <ComboBoxItem Content="MAY" />
                                            </ComboBox>

                                            <Button
                                                Grid.Column="2"
                                                AutomationProperties.Name="{loc:Str Key=RuleMaker_MoveUp}"
                                                ToolTipService.ToolTip="{loc:Str Key=RuleMaker_MoveUp}"
                                                Click="OnRuleActionUpClick"
                                                DataContext="{x:Bind}">
                                                <FontIcon Glyph="&#xE74A;" FontSize="12" />
                                            </Button>
                                            <Button
                                                Grid.Column="3"
                                                AutomationProperties.Name="{loc:Str Key=RuleMaker_MoveDown}"
                                                ToolTipService.ToolTip="{loc:Str Key=RuleMaker_MoveDown}"
                                                Click="OnRuleActionDownClick"
                                                DataContext="{x:Bind}">
                                                <FontIcon Glyph="&#xE74B;" FontSize="12" />
                                            </Button>
                                            <Button
                                                Grid.Column="4"
                                                AutomationProperties.Name="{loc:Str Key=Common_Delete}"
                                                ToolTipService.ToolTip="{loc:Str Key=Common_Delete}"
                                                Click="OnRuleActionRemoveClick"
                                                DataContext="{x:Bind}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button
                                Content="{loc:Str Key=RuleMaker_DeleteRule}"
                                Click="OnRemoveRuleClick"
                                HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 미리보기 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="{loc:Str Key=RuleMaker_Preview}"
                        Style="{StaticResource SectionTitleText}" />

                    <Border
                        Grid.Row="1"
                        Style="{StaticResource NoticeBorder}"
                        VerticalAlignment="Top"
                        Visibility="{x:Bind ViewModel.PreviewIsEmpty, Mode=OneWay}">
                        <TextBlock Text="{loc:Str Key=RuleMaker_PreviewEmpty}" Style="{StaticResource PageSubtitleText}" />
                    </Border>

                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{x:Bind ViewModel.PreviewHasContent, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.AutomationId="MarkdownPreview"
                            Text="{x:Bind ViewModel.MarkdownPreview, Mode=OneWay}"
                            Style="{StaticResource MonoText}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            TextTrimming="None"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 상태 -->
        <TextBlock
            Grid.Row="3"
            AutomationProperties.AutomationId="RuleMakerStatus"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            Style="{StaticResource MutedText}" />
    </Grid>
</Page>
