<Page
    x:Class="Daiso.App.Views.RuleMakerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 파일 메뉴 -->
        <muxc:CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
            <muxc:AppBarButton
                Label="{loc:Str Key=RuleMaker_New}"
                Icon="Add"
                AutomationProperties.AutomationId="NewButton"
                Command="{x:Bind ViewModel.NewCommand}" />
            <muxc:AppBarButton
                Label="{loc:Str Key=Common_Open}"
                Icon="OpenFile"
                AutomationProperties.AutomationId="OpenButton"
                Click="OnOpenClick" />
            <muxc:AppBarButton
                Label="{loc:Str Key=Common_Save}"
                Icon="Save"
                AutomationProperties.AutomationId="SaveButton"
                Click="OnSaveClick" />
            <muxc:AppBarButton
                Label="{loc:Str Key=RuleMaker_SaveAs}"
                Icon="SaveLocal"
                AutomationProperties.AutomationId="SaveAsButton"
                Click="OnSaveAsClick" />
            <muxc:AppBarSeparator />
            <muxc:AppBarButton Label="{loc:Str Key=RuleMaker_Recent}" Icon="Clock" AutomationProperties.AutomationId="RecentButton">
                <muxc:AppBarButton.Flyout>
                    <MenuFlyout x:Name="RecentFlyout" />
                </muxc:AppBarButton.Flyout>
            </muxc:AppBarButton>
            <muxc:AppBarButton Label="{loc:Str Key=RuleMaker_Library}" Icon="Library" AutomationProperties.AutomationId="LibraryButton">
                <muxc:AppBarButton.Flyout>
                    <MenuFlyout x:Name="LibraryFlyout" />
                </muxc:AppBarButton.Flyout>
            </muxc:AppBarButton>
            <muxc:AppBarSeparator />
            <muxc:AppBarButton
                Label="{loc:Str Key=RuleMaker_LinkProject}"
                Icon="Link"
                AutomationProperties.AutomationId="LinkButton"
                Click="OnLinkClick" />
            <muxc:AppBarButton
                Label="{loc:Str Key=RuleMaker_Migrate}"
                Icon="Sync"
                AutomationProperties.AutomationId="MigrateButton"
                Click="OnMigrateClick" />
        </muxc:CommandBar>

        <!-- 헤더 -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Header="{loc:Str Key=RuleMaker_Name}"
                AutomationProperties.AutomationId="NameBox"
                Text="{x:Bind ViewModel.PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox
                Grid.Column="1"
                Header="{loc:Str Key=RuleMaker_Description}"
                AutomationProperties.AutomationId="DescriptionBox"
                Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Grid.Column="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="{loc:Str Key=RuleMaker_ProjectFolder}"
                    PlaceholderText="{loc:Str Key=RuleMaker_ProjectFolderPlaceholder}"
                    AutomationProperties.AutomationId="ProjectDirBox"
                    Text="{x:Bind ViewModel.ProjectDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="1"
                    Content="{loc:Str Key=Common_PickFolder}"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="BrowseProjectButton"
                    Click="OnBrowseProjectClick" />

                <Button
                    Grid.Column="2"
                    Content="{loc:Str Key=RuleMaker_Link}"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="LinkTypedButton"
                    Click="OnLinkTypedClick" />
            </Grid>
        </Grid>

        <!-- 본문 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="14">

                    <!-- Global 행동 -->
                    <Border
                        Padding="14"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{loc:Str Key=RuleMaker_GlobalHeader}"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    Content="{loc:Str Key=RuleMaker_AddAction}"
                                    AutomationProperties.AutomationId="AddGlobalButton"
                                    Command="{x:Bind ViewModel.AddGlobalActionCommand}" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Global}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionEditViewModel">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                Grid.Column="0"
                                                PlaceholderText="{loc:Str Key=RuleMaker_ActionPlaceholder}"
                                                Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <ComboBox
                                                Grid.Column="1"
                                                SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="MUST" />
                                                <ComboBoxItem Content="SHOULD" />
                                                <ComboBoxItem Content="MAY" />
                                            </ComboBox>

                                            <Button Grid.Column="2" Content="↑" Click="OnGlobalUpClick" DataContext="{x:Bind}" />
                                            <Button Grid.Column="3" Content="↓" Click="OnGlobalDownClick" DataContext="{x:Bind}" />
                                            <Button Grid.Column="4" Content="{loc:Str Key=Common_Delete}" Click="OnGlobalRemoveClick" DataContext="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 규칙 목록 -->
                    <Border
                        Padding="14"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{loc:Str Key=RuleMaker_Rules}"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    Content="{loc:Str Key=RuleMaker_AddRule}"
                                    AutomationProperties.AutomationId="AddRuleButton"
                                    Command="{x:Bind ViewModel.AddRuleCommand}" />
                            </Grid>

                            <ListView
                                AutomationProperties.AutomationId="RuleList"
                                ItemsSource="{x:Bind ViewModel.Rules}"
                                SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}"
                                MaxHeight="160">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuleEditViewModel">
                                        <TextBlock
                                            Text="{x:Bind Summary, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            Padding="0,6" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- 선택한 규칙 편집 -->
                    <Border
                        Padding="14"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Str Key=RuleMaker_ConditionTree}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{loc:Str Key=RuleMaker_AddLeaf}" AutomationProperties.AutomationId="AddLeafButton" Click="OnAddLeafClick" />
                                <Button Content="{loc:Str Key=RuleMaker_AddAnd}" Click="OnAddAndClick" />
                                <Button Content="{loc:Str Key=RuleMaker_AddOr}" Click="OnAddOrClick" />
                                <Button Content="{loc:Str Key=RuleMaker_AddNot}" Click="OnAddNotClick" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{loc:Str Key=RuleMaker_WrapAnd}" AutomationProperties.AutomationId="WrapAndButton" Click="OnWrapAndClick" />
                                <Button Content="{loc:Str Key=RuleMaker_WrapOr}" Click="OnWrapOrClick" />
                                <Button Content="{loc:Str Key=RuleMaker_WrapNot}" Click="OnWrapNotClick" />
                                <Button Content="↑" Click="OnNodeUpClick" />
                                <Button Content="↓" Click="OnNodeDownClick" />
                                <Button Content="{loc:Str Key=RuleMaker_DeleteNode}" Click="OnNodeDeleteClick" />
                            </StackPanel>

                            <muxc:TreeView
                                x:Name="ConditionTree"
                                AutomationProperties.AutomationId="ConditionTree"
                                SelectionMode="Single"
                                CanDragItems="True"
                                AllowDrop="True"
                                CanReorderItems="True"
                                MinHeight="180"
                                DragItemsCompleted="OnTreeDragCompleted">
                                <muxc:TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConditionNodeViewModel">
                                        <muxc:TreeViewItem
                                            ItemsSource="{x:Bind Children}"
                                            IsExpanded="True">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind Label, Mode=OneWay}"
                                                    VerticalAlignment="Center" />

                                                <TextBox
                                                    Grid.Column="1"
                                                    MinWidth="200"
                                                    Visibility="{x:Bind LeafVisibility, Mode=OneWay}"
                                                    PlaceholderText="{loc:Str Key=RuleMaker_ConditionPlaceholder}"
                                                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </muxc:TreeViewItem>
                                    </DataTemplate>
                                </muxc:TreeView.ItemTemplate>
                            </muxc:TreeView>

                            <TextBlock
                                AutomationProperties.AutomationId="ConditionPreview"
                                Text="{x:Bind ViewModel.SelectedRule.ConditionPreview, Mode=OneWay}"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap" />

                            <TextBlock Text="{loc:Str Key=RuleMaker_Actions}" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{loc:Str Key=RuleMaker_AddAction}" AutomationProperties.AutomationId="AddRuleActionButton" Click="OnAddRuleActionClick" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedRule.Actions, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionEditViewModel">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                Grid.Column="0"
                                                PlaceholderText="{loc:Str Key=RuleMaker_ActionPlaceholder}"
                                                Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <ComboBox
                                                Grid.Column="1"
                                                SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="MUST" />
                                                <ComboBoxItem Content="SHOULD" />
                                                <ComboBoxItem Content="MAY" />
                                            </ComboBox>

                                            <Button Grid.Column="2" Content="↑" Click="OnRuleActionUpClick" DataContext="{x:Bind}" />
                                            <Button Grid.Column="3" Content="↓" Click="OnRuleActionDownClick" DataContext="{x:Bind}" />
                                            <Button Grid.Column="4" Content="{loc:Str Key=Common_Delete}" Click="OnRuleActionRemoveClick" DataContext="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="{loc:Str Key=RuleMaker_DeleteRule}" Click="OnRemoveRuleClick" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 미리보기 -->
            <Border
                Grid.Column="1"
                Padding="14"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Str Key=RuleMaker_Preview}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <ScrollViewer Grid.Row="1">
                        <TextBlock
                            AutomationProperties.AutomationId="MarkdownPreview"
                            Text="{x:Bind ViewModel.MarkdownPreview, Mode=OneWay}"
                            FontFamily="Consolas"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 상태 -->
        <TextBlock
            Grid.Row="3"
            AutomationProperties.AutomationId="RuleMakerStatus"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</Page>
