<Page
    x:Class="Daiso.App.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="18" MaxWidth="900">

            <TextBlock Text="Terminal" Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- 폴더 -->
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Str Key=Terminal_WorkFolder}" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Str Key=Terminal_FolderPath}" />

                    <Button Grid.Column="1" Content="{loc:Str Key=Common_PickFolder}" Click="OnPickFolderClick" />
                </Grid>

                <TextBlock Text="{loc:Str Key=Terminal_RecentFolders}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8" />

                <ListView
                    ItemsSource="{x:Bind ViewModel.RecentFolders}"
                    SelectionMode="Single"
                    MaxHeight="200"
                    SelectionChanged="OnRecentSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- 인자 -->
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Str Key=Terminal_OptionArgs}" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <TextBox
                    Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{loc:Str Key=Terminal_ArgsPlaceholder}" />

                <TextBlock Text="{loc:Str Key=Terminal_ClaudePresets}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.ClaudePresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <muxc:ItemsWrapGrid
                                xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{x:Bind}" Margin="0,0,8,8" Click="OnPresetClick" Tag="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{loc:Str Key=Terminal_CodexPresets}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.CodexPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <muxc:ItemsWrapGrid
                                xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{x:Bind}" Margin="0,0,8,8" Click="OnPresetClick" Tag="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 실행 -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    Content="{loc:Str Key=Terminal_OpenClaude}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.LaunchClaudeCommand}"
                    IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}" />
                <Button
                    Content="{loc:Str Key=Terminal_OpenCodex}"
                    Command="{x:Bind ViewModel.LaunchCodexCommand}"
                    IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}" />
            </StackPanel>

            <TextBlock
                Text="{x:Bind ViewModel.LastCommand, Mode=OneWay}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.8"
                TextWrapping="Wrap" />

            <TextBlock
                Text="{loc:Str Key=Terminal_ShellNote}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.6"
                TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</Page>
