<Page
    x:Class="Daiso.App.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <ScrollViewer Padding="{StaticResource PagePadding}" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource ContentMaxWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,0,20">

            <StackPanel Spacing="2">
                <TextBlock Text="{loc:Str Key=Terminal_Title}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{loc:Str Key=Terminal_ShellNote}" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>

            <!-- 작업 폴더 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Str Key=Terminal_WorkFolder}" Style="{StaticResource SectionTitleText}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            AutomationProperties.AutomationId="WorkingDirBox"
                            AutomationProperties.Name="{loc:Str Key=Terminal_FolderPath}"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{loc:Str Key=Terminal_FolderPath}" />

                        <muxc:DropDownButton
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ProjectPickerButton">
                            <muxc:DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Str Key=Common_KnownProjects}" />
                                </StackPanel>
                            </muxc:DropDownButton.Content>
                            <muxc:DropDownButton.Flyout>
                                <MenuFlyout x:Name="ProjectFlyout" Opening="OnProjectFlyoutOpening" />
                            </muxc:DropDownButton.Flyout>
                        </muxc:DropDownButton>
                    </Grid>

                    <TextBlock Text="{loc:Str Key=Terminal_RecentFolders}" Style="{StaticResource MutedText}" />

                    <ListView
                        AutomationProperties.AutomationId="RecentFolderList"
                        ItemsSource="{x:Bind ViewModel.RecentFolders}"
                        SelectionMode="Single"
                        MaxHeight="150"
                        SelectionChanged="OnRecentSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    Text="{x:Bind}"
                                    Style="{StaticResource MonoText}"
                                    ToolTipService.ToolTip="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Style="{StaticResource NoticeBorder}" Visibility="{x:Bind ViewModel.HasNoRecentFolders, Mode=OneWay}">
                        <TextBlock Text="{loc:Str Key=Terminal_NoRecent}" Style="{StaticResource PageSubtitleText}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 인자 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Str Key=Terminal_OptionArgs}" Style="{StaticResource SectionTitleText}" />

                    <TextBox
                        AutomationProperties.AutomationId="ArgumentsBox"
                        AutomationProperties.Name="{loc:Str Key=Terminal_OptionArgs}"
                        Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Str Key=Terminal_ArgsPlaceholder}" />

                    <!-- 도구마다 프리셋 한 묶음 -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tools}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolLaunchViewModel">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind PresetsTitle}" Style="{StaticResource MutedText}" />
                                    <ItemsRepeater ItemsSource="{x:Bind Presets}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                MinItemWidth="170"
                                                MinRowSpacing="8"
                                                MinColumnSpacing="8"
                                                ItemsStretch="None" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Content="{x:Bind}" Tag="{x:Bind}" Click="OnPresetClick" HorizontalAlignment="Stretch" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- 실행 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Str Key=Terminal_Launch}" Style="{StaticResource SectionTitleText}" />

                    <!-- 도구마다 버튼 하나. 설치돼 있으면 열기, 아니면 설치. 설치가 도는 동안은 잠긴다 -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tools}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="240"
                                MinRowSpacing="10"
                                MinColumnSpacing="10"
                                ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolLaunchViewModel">
                                <StackPanel Spacing="6">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                        Command="{x:Bind LaunchCommand, Mode=OneWay}"
                                        CommandParameter="{x:Bind}"
                                        IsEnabled="{x:Bind CanPress, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" />
                                            <TextBlock Text="{x:Bind ButtonText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        Text="{x:Bind Hint, Mode=OneWay}"
                                        Visibility="{x:Bind HasHint, Mode=OneWay}"
                                        Style="{StaticResource MutedText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Str Key=Terminal_Preview}" Style="{StaticResource MutedText}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tools}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolLaunchViewModel">
                                    <TextBlock
                                        Text="{x:Bind Preview, Mode=OneWay}"
                                        Style="{StaticResource MonoText}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasLastCommand, Mode=OneWay}">
                        <TextBlock Text="{loc:Str Key=Terminal_LastCommand}" Style="{StaticResource MutedText}" />
                        <TextBlock
                            AutomationProperties.AutomationId="LastCommand"
                            Text="{x:Bind ViewModel.LastCommand, Mode=OneWay}"
                            Style="{StaticResource MonoText}"
                            TextTrimming="None"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
