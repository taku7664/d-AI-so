<Page
    x:Class="Daiso.App.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Daiso.App.ViewModels"
    xmlns:controls="using:Daiso.App.Controls"
    xmlns:terminal="using:Daiso.App.Terminal"
    xmlns:prompts="using:Daiso.Core.Prompts"
    NavigationCacheMode="Required">

    <!-- 위는 탭 띠 하나: [＋ 새 터미널] [방 탭…]. 그 아래 도구 줄(방일 때만, 아이콘만·툴팁), 그 아래 본문.
         새 터미널 탭이면 새 세션 카드, 방 탭이면 그 방의 터미널이 화면을 채운다. 방은 RoomManager가 들고 있어 화면을 옮겨도 산다. (ARCHITECTURE §5.3)
         NavigationCacheMode=Required: 화면을 떠났다 돌아와도 WebView2를 다시 만들거나 버퍼를 재생하지 않는다 -->
    <Page.Resources>
        <!-- 도구 줄 아이콘 버튼: 포토샵·게임 엔진 도구 모음처럼 32px 정사각, 글 없이 아이콘만, 툴팁으로 설명 -->
        <Style x:Key="ToolbarIconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        </Style>
        <Style x:Key="ToolbarIconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        </Style>
        <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 아코디언 단계 머리. 높이를 고정해 접힘/펼침에도 카드가 흔들리지 않는다 (TERMINAL_CARD_PLAN §4.1) -->
        <!-- 단계 머리. 누르는 곳이 아니라 버튼이 아니다 — 단계는 답을 따라서만 열리고 닫히지 않는다 -->
        <Style x:Key="StepHeader" TargetType="Grid">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="ColumnSpacing" Value="{StaticResource GapMedium}" />
        </Style>

        <!-- 펼쳐진 단계의 몸 -->
        <Style x:Key="StepBody" TargetType="StackPanel">
            <Setter Property="Spacing" Value="{StaticResource GapMedium}" />
            <Setter Property="Margin" Value="30,2,0,14" />
        </Style>
    </Page.Resources>

    <!-- 골격은 PageBody 가 정한다: 탭 띠·방 도구 줄(필터 줄) → 본문. 폭은 Wide — 방 화면은 창을 다 쓴다 (UI_REFACTOR_PLAN §6, §8.2) -->
    <!--
        파일 끌어놓기는 셸의 FileDropTarget(OLE)이 받아 이 페이지(IFileDropSink)에 넘긴다. XAML AllowDrop 은 이 환경에서 동작하지 않는다.
        끄는 동안 DropOverlay 를 터미널 위에 덮어 어디에 놓이는지 보여 준다. 방이 있을 때만 파일을 CLI 에 준다
    -->
    <controls:PageBody x:Name="Root" Layout="Wide">
        <controls:PageBody.Filters>
        <StackPanel Spacing="{StaticResource GapMedium}">

        <!-- ───── 탭 띠 ───── -->
        <Grid ColumnSpacing="{StaticResource GapMedium}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                새 터미널 탭. 방이 하나도 선택되지 않았을 때 켜진다.
                방 탭과 같은 높이(40)의 정사각형이다 — 내용 크기대로 두면 탭 줄에서 혼자 작고 가운데 떠 보였다
            -->
            <ToggleButton
                x:Name="NewTab"
                Grid.Column="0"
                Width="40"
                Height="40"
                Padding="0"
                CornerRadius="{StaticResource RadiusSmall}"
                IsChecked="True"
                Click="OnNewTabClick"
                AutomationProperties.AutomationId="NewTerminalButton"
                AutomationProperties.Name="{loc:Str Key=Room_NewTerminal}"
                ToolTipService.ToolTip="{loc:Str Key=Room_NewTerminalTip}"
                VerticalAlignment="Center">
                <FontIcon Glyph="&#xE710;" FontSize="{StaticResource BodyFontSize}" />
            </ToggleButton>

            <ListView
                x:Name="RoomTabs"
                Grid.Column="1"
                SelectionMode="Single"
                SelectionChanged="OnRoomTabChanged"
                AutomationProperties.AutomationId="RoomTabs"
                ScrollViewer.HorizontalScrollMode="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="MinWidth" Value="0" />
                        <!-- 새 터미널(+) 단추와 같은 높이. 둘이 한 줄의 탭이다 -->
                        <Setter Property="Height" Value="40" />
                        <Setter Property="MinHeight" Value="40" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:IRoom">
                        <Grid ColumnSpacing="{StaticResource GapMedium}" Padding="6,2" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
                                <controls:ToolIcon Kind="{x:Bind Tool}" Size="22" />
                                <!-- 안 본 새 답: 빨간 점이 퍼진다 -->
                                <controls:PulseDot HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="{x:Bind UnseenVisibility, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{x:Bind ShortTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                            <Button
                                Grid.Column="2"
                                Padding="4"
                                Background="Transparent"
                                BorderThickness="0"
                                AutomationProperties.Name="{loc:Str Key=Common_Close}"
                                ToolTipService.ToolTip="{loc:Str Key=Room_CloseTabTip}"
                                Click="OnCloseRoomClick"
                                DataContext="{x:Bind}">
                                <FontIcon Glyph="&#xE711;" FontSize="{StaticResource CaptionFontSize}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--
            ───── 방 도구 줄(터미널 방일 때만): 아이콘만, 호버 툴팁 ─────

            폭이 넘치지 않는 것이 이 줄의 첫 규칙이다. 창 하한(1024)에서 이 줄이 쓸 수 있는 폭은
            좌측 메뉴 210 과 본문 여백 48 을 빼고 766px 뿐인데, 예전에는 아이콘 294 + 방 이름 고정 520 =
            814px 이라 이미 넘쳤고, 찾기를 열면 옆에 덧붙어 1084px 까지 갔다. 넘친 만큼 잘려 나갔다.
            그래서 셋을 바꿨다 (2026-09-10):
              · 방 이름은 고정 폭이 아니라 남는 폭(* 열)만 쓴다 — 어떤 창 크기에서도 넘치지 않는다
              · 찾기는 덧붙지 않고 줄 자체를 찾기 모드로 바꾼다 — 폭이 늘지 않는다
              · 늘 쓰지 않는 셋(입력 비우기·같은 폴더로 새 터미널·규칙 편집)은 더보기 안으로 넣었다
        -->
        <Border
            x:Name="RoomTools"
            Padding="4,2"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="{StaticResource GapMedium}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 평소 줄: 늘 쓰는 넷 + 더보기 -->
                <StackPanel x:Name="RoomToolIcons" Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource GapTiny}">
                    <ToggleButton x:Name="FindToggle" Style="{StaticResource ToolbarIconToggle}" Click="OnFindToggleClick" AutomationProperties.AutomationId="TerminalFindToggle" ToolTipService.ToolTip="{loc:Str Key=Room_FindTip}">
                        <FontIcon Glyph="&#xE721;" FontSize="{StaticResource BodyFontSize}" />
                    </ToggleButton>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button x:Name="RoomPromptButton" Style="{StaticResource ToolbarIconButton}" AutomationProperties.AutomationId="RoomPromptButton" AutomationProperties.Name="{loc:Str Key=Room_ApplyPrompt}" ToolTipService.ToolTip="{loc:Str Key=Room_ApplyPromptHint}">
                        <FontIcon Glyph="&#xE8BD;" FontSize="{StaticResource BodyFontSize}" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="RoomPromptFlyout" Opening="OnRoomPromptFlyoutOpening" Placement="BottomEdgeAlignedLeft" />
                        </Button.Flyout>
                    </Button>

                    <!-- 파일 첨부: 끌어놓기와 같은 길이지만, 눈에 보이는 길은 이것뿐이다 -->
                    <Button Style="{StaticResource ToolbarIconButton}" Click="OnRoomAttachClick" AutomationProperties.AutomationId="RoomAttachButton" AutomationProperties.Name="{loc:Str Key=Room_AttachFile}" ToolTipService.ToolTip="{loc:Str Key=Room_AttachFileTip}">
                        <FontIcon Glyph="&#xE723;" FontSize="{StaticResource BodyFontSize}" />
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button Style="{StaticResource ToolbarIconButton}" Click="OnRoomOpenFolderClick" AutomationProperties.AutomationId="RoomOpenFolderButton" AutomationProperties.Name="{loc:Str Key=Room_OpenFolder}" ToolTipService.ToolTip="{loc:Str Key=Room_OpenFolderTip}">
                        <FontIcon Glyph="&#xE838;" FontSize="{StaticResource BodyFontSize}" />
                    </Button>

                    <!-- 가끔 쓰는 것들. 아이콘 자리를 늘 차지할 값어치는 없지만 없어도 안 된다 -->
                    <Button x:Name="RoomMoreButton" Style="{StaticResource ToolbarIconButton}" AutomationProperties.AutomationId="RoomMoreButton" AutomationProperties.Name="{loc:Str Key=Room_More}" ToolTipService.ToolTip="{loc:Str Key=Room_More}">
                        <FontIcon Glyph="&#xE712;" FontSize="{StaticResource BodyFontSize}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem AutomationProperties.AutomationId="RoomClearInputButton" Text="{loc:Str Key=Room_ClearInput}" ToolTipService.ToolTip="{loc:Str Key=Room_ClearInputTip}" Click="OnRoomClearInputClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE894;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem AutomationProperties.AutomationId="RoomDuplicateButton" Text="{loc:Str Key=Room_Duplicate}" ToolTipService.ToolTip="{loc:Str Key=Room_DuplicateTip}" Click="OnRoomDuplicateClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <!-- 화면에 보이는 글자 그대로. 오류를 어디 붙여넣어 물어볼 때 쓴다 -->
                                <MenuFlyoutItem AutomationProperties.AutomationId="RoomCopyScreenButton" Text="{loc:Str Key=Room_CopyScreen}" ToolTipService.ToolTip="{loc:Str Key=Room_CopyScreenTip}" Click="OnRoomCopyScreenClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem AutomationProperties.AutomationId="RoomSaveScreenButton" Text="{loc:Str Key=Room_SaveScreen}" ToolTipService.ToolTip="{loc:Str Key=Room_SaveScreenTip}" Click="OnRoomSaveScreenClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />
                                <!-- 이 방에 하는 일이 아니라 다른 화면으로 나가는 것이라 아래에 따로 둔다 -->
                                <MenuFlyoutItem AutomationProperties.AutomationId="RoomRulesButton" Text="{loc:Str Key=Terminal_EditRules}" ToolTipService.ToolTip="{loc:Str Key=Room_EditRulesHint}" Click="OnRoomRulesClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- 찾기 줄: 평소 줄을 대신한다. 덧붙지 않으므로 폭이 늘지 않는다 -->
                <StackPanel x:Name="FindPanel" Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource GapTiny}" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE721;" FontSize="{StaticResource BodyFontSize}" Margin="6,0,2,0" VerticalAlignment="Center" />
                    <TextBox
                        x:Name="FindBox"
                        Width="{StaticResource SettingInputWidth}"
                        Height="30"
                        VerticalAlignment="Center"
                        PlaceholderText="{loc:Str Key=Room_FindPlaceholder}"
                        AutomationProperties.AutomationId="TerminalFindBox"
                        TextChanged="OnFindTextChanged"
                        KeyDown="OnFindKeyDown" />
                    <Button Style="{StaticResource ToolbarIconButton}" Click="OnFindPrevClick" ToolTipService.ToolTip="{loc:Str Key=Room_FindPrev}" AutomationProperties.Name="{loc:Str Key=Room_FindPrev}">
                        <FontIcon Glyph="&#xE70E;" FontSize="{StaticResource CaptionFontSize}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="OnFindNextClick" ToolTipService.ToolTip="{loc:Str Key=Room_FindNext}" AutomationProperties.Name="{loc:Str Key=Room_FindNext}">
                        <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource CaptionFontSize}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="OnFindCloseClick" AutomationProperties.AutomationId="TerminalFindClose" ToolTipService.ToolTip="{loc:Str Key=Room_FindClose}" AutomationProperties.Name="{loc:Str Key=Room_FindClose}">
                        <FontIcon Glyph="&#xE711;" FontSize="{StaticResource CaptionFontSize}" />
                    </Button>
                </StackPanel>

                <!-- 방 이름(도구 · 폴더 · 프로세스 제목). 도구가 아니라 표시라 오른쪽에 두고, 남는 폭만 쓴다 -->
                <TextBlock
                    x:Name="RoomTitleText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MutedText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </Border>
        </StackPanel>
        </controls:PageBody.Filters>

        <!-- ───── 본문 ───── -->
        <controls:PageBody.Body>
        <Grid>

            <!--
                새 세션 카드. 폭은 골격이 정한다(Wide) — 카드가 따로 폭을 정하지 않는다.
                안은 두 칸: 위는 스크롤되는 단계들, 아래는 카드 바닥에 붙는 실행 줄.
                단계가 길어져도 "무엇이 실행되는가"와 시작 버튼은 늘 보인다 (TERMINAL_CARD_PLAN §7.5)
            -->
            <Border x:Name="NewSessionPanel" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                        <!--
                            세 단계 + 자세한 설정 + (카드 바닥의) 실행 줄.
                            단계는 답을 따라서만 열린다. 필수 답이 채워지면 바로 아래 다음 단계가 열리고("다음" 버튼은 두지 않는다),
                            그 단계 머리로 부드럽게 굴러가 답할 칸에 포커스가 옮겨 간다(OnStepRevealRequested).
                            한 번 열린 단계는 닫히지 않고, 머리는 누르는 곳이 아니다. 자세한 설정은 3단계와 함께 열린다.
                            (2026-09-10 사람의 요청으로 "한 번에 한 단계만" 아코디언을 걷어냈다. docs/TERMINAL_CARD_PLAN.md 끝)

                            단계가 쌓이므로 카드에 "남은 높이"가 없다. 줄은 모두 Auto 이고, 지난 대화는 폴더처럼 콤보박스 하나라 높이를 먹지 않는다
                        -->
                        <ScrollViewer x:Name="StepsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" ViewChanged="OnStepsScrollViewChanged">
                        <Grid x:Name="StepsGrid" Padding="20,4,20,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ───── 1. 어떤 AI로 시작할까요? ───── -->
                            <Grid Grid.Row="0" Style="{StaticResource StepHeader}" x:Name="StepToolHeader" AutomationProperties.AutomationId="StepToolHeader">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Height="20">
                                        <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind ViewModel.ToolMarkCheck, Mode=OneWay}" />
                                        <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.ToolMarkCurrent, Mode=OneWay}" />
                                        <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" StrokeThickness="1" Stroke="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.ToolMarkPending, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{loc:Str Key=Terminal_StepTool}" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                            </Grid>

                            <!--
                                AI 카드 3장. 순서·이름·제작사·로고는 전부 ToolLook 이 정한다 — XAML 에 도구 이름을 적지 않는다.
                                도구가 늘어도 이 markup 은 그대로다. 목록(ListView)을 쓰는 이유는 고른 카드의 강조·키보드 이동을
                                WinUI 가 테마에 맞게 알아서 해 주기 때문이다 (직접 칠하면 라이트/다크에서 어긋난다)
                            -->
                            <StackPanel Grid.Row="1" Style="{StaticResource StepBody}" Visibility="{x:Bind ViewModel.ToolExpanded, Mode=OneWay}">
                                <ListView
                                    x:Name="ToolCards"
                                    ItemsSource="{x:Bind ViewModel.Tools}"
                                    SelectedIndex="{x:Bind ViewModel.ToolSelection, Mode=OneWay}"
                                    SelectionChanged="OnToolCardChanged"
                                    SelectionMode="Single"
                                    AutomationProperties.AutomationId="ToolCards"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    ScrollViewer.HorizontalScrollMode="Disabled">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.Resources>
                                        <!--
                                            목록 컨테이너는 채움을 칠하지 않는다(전부 투명). WinUI 의 ListViewItemPresenter 는 선택·호버 채움을
                                            위아래 2px 안쪽에 모서리 없이 그려서, 둥근 테두리 카드와 어긋나 "카드 끝까지 안 칠해진" 모양이 났다.
                                            채움은 카드(Border)가 직접 칠한다 — OnCardLoaded / OnCardPointerEntered / OnCardPointerExited / 선택 변경 시 PaintCards
                                        -->
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Default">
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Light">
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </ListView.Resources>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolLaunchViewModel">
                                            <!-- 테두리를 둬서 "고르는 카드"로 보이게 한다. 글자만 있으면 눌러도 되는지 알 수 없다. 채움(고름·호버)은 코드가 이 Border 에 직접 칠한다 — 컨테이너 채움은 카드와 어긋난다 -->
                                            <Border Width="132" Padding="10,12" CornerRadius="{StaticResource RadiusMedium}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" AutomationProperties.AutomationId="{x:Bind AutomationId}" Background="Transparent" Loaded="OnCardLoaded" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" PointerCanceled="OnCardPointerExited" PointerCaptureLost="OnCardPointerExited">
                                                <StackPanel Spacing="{StaticResource GapXSmall}">
                                                    <controls:ToolIcon Kind="{x:Bind Kind}" Size="30" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind Title}" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Vendor}" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="{x:Bind InstallStateText, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <!-- ───── 2. 어느 폴더에서 일할까요? ───── -->
                            <Grid Grid.Row="2" Style="{StaticResource StepHeader}" x:Name="StepFolderHeader" Opacity="{x:Bind ViewModel.FolderHeaderOpacity, Mode=OneWay}" AutomationProperties.AutomationId="StepFolderHeader">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Height="20">
                                        <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind ViewModel.FolderMarkCheck, Mode=OneWay}" />
                                        <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.FolderMarkCurrent, Mode=OneWay}" />
                                        <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" StrokeThickness="1" Stroke="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.FolderMarkPending, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{loc:Str Key=Terminal_WorkFolder}" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="3" Style="{StaticResource StepBody}" Visibility="{x:Bind ViewModel.FolderExpanded, Mode=OneWay}">
                                <Grid ColumnSpacing="{StaticResource GapMedium}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Text는 x:Bind 대신 코드에서 잇는다. 편집형 ComboBox는 로드 때 SelectedItem=null로 Text를 비워 바인딩 값을 덮는다 -->
                                    <!-- 목록 하나에 최근 폴더 + 아는 프로젝트가 다 들어 있다. 새 폴더는 찾아보기로만 간다 (§2-B6) -->
                                    <ComboBox
                                        x:Name="FolderBox"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        IsEditable="True"
                                        AutomationProperties.AutomationId="WorkingDirBox"
                                        AutomationProperties.Name="{loc:Str Key=Terminal_FolderPath}"
                                        ToolTipService.ToolTip="{loc:Str Key=Terminal_FolderTip}"
                                        FontFamily="Consolas"
                                        ItemsSource="{x:Bind ViewModel.FolderChoices}"
                                        TextSubmitted="OnFolderTextSubmitted"
                                        SelectionChanged="OnFolderSelectionChanged"
                                        PlaceholderText="{loc:Str Key=Terminal_FolderPath}" />
                                    <Button Grid.Column="1" Click="OnPickFolderClick" AutomationProperties.AutomationId="ProjectPickerButton" ToolTipService.ToolTip="{loc:Str Key=Terminal_BrowseTip}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource BodyFontSize}" />
                                            <TextBlock Text="{loc:Str Key=Common_Browse}" />
                                        </StackPanel>
                                    </Button>

                                    <!--
                                        마지막에 쓴 폴더가 미리 채워져 있을 때만 나온다. 목록에서 같은 항목을 다시 골라도
                                        SelectionChanged 가 오지 않아 확인할 길이 없었다 — 그래서 그 자리에 단추를 낸다.
                                        다른 폴더를 고르면 그것으로 답이 되므로 이 단추는 사라진다
                                    -->
                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource AccentButtonStyle}"
                                        AutomationProperties.AutomationId="ConfirmFolderButton"
                                        Visibility="{x:Bind ViewModel.FolderNeedsConfirm, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ConfirmFolderCommand}"
                                        ToolTipService.ToolTip="{loc:Str Key=Terminal_UseThisFolderTip}"
                                        Content="{loc:Str Key=Terminal_UseThisFolder}" />
                                </Grid>

                                <!-- 그런 폴더가 없다. 다음 단계로 못 가는 이유를 그 자리에서 말한다 -->
                                <Border Style="{StaticResource NoticeBorder}" Visibility="{x:Bind ViewModel.FolderMissing, Mode=OneWay}">
                                    <TextBlock Text="{loc:Str Key=Terminal_FolderMissing}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <!-- ───── 3. (필수) 대화를 선택해주세요 ───── -->
                            <Grid Grid.Row="4" Style="{StaticResource StepHeader}" x:Name="StepSessionHeader" Opacity="{x:Bind ViewModel.SessionHeaderOpacity, Mode=OneWay}" AutomationProperties.AutomationId="StepSessionHeader">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Height="20">
                                        <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind ViewModel.SessionMarkCheck, Mode=OneWay}" />
                                        <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.SessionMarkCurrent, Mode=OneWay}" />
                                        <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" StrokeThickness="1" Stroke="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.SessionMarkPending, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{loc:Str Key=Terminal_Session}" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                            </Grid>

                            <!--
                                3단계 몸. 다른 단계와 같은 StepBody(StackPanel) 다.
                                예전에는 Grid + RowSpacing 이었는데, Grid 는 접힌 줄에도 간격을 붙여서 "이어서"를 고르면
                                숨은 프롬프트 두 줄 몫의 간격이 남아 "대화" 칸만 아래로 밀렸다. StackPanel 은 숨은 것에 간격을 주지 않는다
                            -->
                            <StackPanel Grid.Row="5" Style="{StaticResource StepBody}" Visibility="{x:Bind ViewModel.SessionExpanded, Mode=OneWay}">
                                <!-- 앞 단계를 바꿔 이 답이 무효가 됐다. 조용히 지우면 "왜 없어졌지"가 된다 (§4.9) -->
                                <Border Style="{StaticResource NoticeBorder}" Visibility="{x:Bind ViewModel.HasInvalidationNotice, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.InvalidationNotice, Mode=OneWay}" TextWrapping="Wrap" />
                                </Border>

                                <!-- 카드 2장. 각 카드에 부연 한 줄을 붙여 고르기 전에 무엇이 기다리는지 알려 준다 (§4.5) -->
                                <ListView
                                    x:Name="SessionModeRadios"
                                    AutomationProperties.AutomationId="SessionModeRadios"
                                    SelectedIndex="{x:Bind ViewModel.SessionModeSelection, Mode=OneWay}"
                                    SelectionChanged="OnSessionModeChanged"
                                    SelectionMode="Single"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    ScrollViewer.HorizontalScrollMode="Disabled">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.Resources>
                                        <!--
                                            목록 컨테이너는 채움을 칠하지 않는다(전부 투명). WinUI 의 ListViewItemPresenter 는 선택·호버 채움을
                                            위아래 2px 안쪽에 모서리 없이 그려서, 둥근 테두리 카드와 어긋나 "카드 끝까지 안 칠해진" 모양이 났다.
                                            채움은 카드(Border)가 직접 칠한다 — OnCardLoaded / OnCardPointerEntered / OnCardPointerExited / 선택 변경 시 PaintCards
                                        -->
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Default">
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Light">
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </ListView.Resources>
                                    <!-- AI 카드와 같은 테두리 카드. 두 화면이 같은 "고르는 카드" 문법을 쓴다 -->
                                    <ListViewItem AutomationProperties.AutomationId="NewSessionRadio" ToolTipService.ToolTip="{loc:Str Key=Terminal_NewSessionTip}">
                                        <Border Width="200" Padding="12,10" CornerRadius="{StaticResource RadiusMedium}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="Transparent" Loaded="OnCardLoaded" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" PointerCanceled="OnCardPointerExited" PointerCaptureLost="OnCardPointerExited">
                                            <StackPanel Spacing="{StaticResource GapTiny}">
                                                <TextBlock Text="{loc:Str Key=Terminal_NewSession}" FontWeight="SemiBold" />
                                                <TextBlock Text="{loc:Str Key=Terminal_NewSessionSub}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </ListViewItem>
                                    <ListViewItem AutomationProperties.AutomationId="ResumeSessionRadio" ToolTipService.ToolTip="{loc:Str Key=Terminal_ResumeSessionTip}" IsEnabled="{x:Bind ViewModel.HasAnyResume, Mode=OneWay}">
                                        <Border Width="200" Padding="12,10" CornerRadius="{StaticResource RadiusMedium}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="Transparent" Loaded="OnCardLoaded" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" PointerCanceled="OnCardPointerExited" PointerCaptureLost="OnCardPointerExited">
                                            <StackPanel Spacing="{StaticResource GapTiny}">
                                                <TextBlock Text="{loc:Str Key=Terminal_ResumeSession}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind ViewModel.ResumeCountText, Mode=OneWay}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </ListViewItem>
                                </ListView>

                                <!-- 시작 프롬프트는 4단계(선택)로 옮겼다 — 필수 단계는 "새로/이어서"까지만 묻는다 (2026-09-10 사람의 요청) -->

                                <!--
                                    이어서: 이 폴더·도구의 지난 대화. 폴더 칸처럼 콤보박스 하나로 고른다 — 목록이 카드 높이를 먹지 않는다.
                                    예전의 검색칸 + 날짜 묶음 목록은 답한 단계가 쌓이면서 걷어냈다(최근 30개라 훑어 고를 수 있다)
                                -->
                                <Grid ColumnSpacing="{StaticResource GapLarge}" Visibility="{x:Bind ViewModel.ShowResumeList, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Str Key=Terminal_ResumeLabel}" VerticalAlignment="Center" />
                                    <ComboBox
                                        x:Name="ResumeBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="ResumeSessionBox"
                                        AutomationProperties.Name="{loc:Str Key=Terminal_ResumeLabel}"
                                        PlaceholderText="{loc:Str Key=Terminal_ResumePick}"
                                        ItemsSource="{x:Bind ViewModel.ResumeCandidates}"
                                        SelectedItem="{x:Bind ViewModel.SelectedResume, Mode=TwoWay}"
                                        ItemTemplate="{StaticResource ResumeCandidateTemplate}">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </Grid>
                                <TextBlock
                                    Text="{x:Bind ViewModel.NoResumeCandidatesText, Mode=OneWay}"
                                    Style="{StaticResource MutedText}"
                                    Visibility="{x:Bind ViewModel.HasNoResumeCandidates, Mode=OneWay}" />
                            </StackPanel>

                            <!--
                                ───── 4. (선택) 세부 설정을 원하시나요? ─────
                                1~3 단계와 같은 머리 + 몸이다. 3단계가 열릴 때 함께 열리고, 사람이 접고 펴지 않는다.
                                답할 것이 없는 단계라 ✓ 가 없고, 시작 버튼을 막지 않는다(CanStart 는 1~3 단계만 본다).
                                규칙 편집도 여기 둔다 — 폴더를 고르는 자리에서 규칙까지 들이밀면 필수 단계가 길어진다 (2026-09-10 사람의 요청)
                            -->
                            <Grid Grid.Row="6" Style="{StaticResource StepHeader}" x:Name="StepAdvancedHeader" Opacity="{x:Bind ViewModel.SessionHeaderOpacity, Mode=OneWay}" AutomationProperties.AutomationId="StepAdvancedHeader">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center" Height="20">
                                    <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.AdvancedMarkCurrent, Mode=OneWay}" />
                                    <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" StrokeThickness="1" Stroke="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.AdvancedMarkPending, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{loc:Str Key=Terminal_Advanced}" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="7" Style="{StaticResource StepBody}" Visibility="{x:Bind ViewModel.SessionExpanded, Mode=OneWay}" AutomationProperties.AutomationId="StepAdvancedBody">
                                <!-- 규칙: 이 폴더의 규칙 파일이 있는지 + 편집. 폴더 단계에 있다가 여기로 옮겼다 -->
                                <Grid ColumnSpacing="{StaticResource GapMedium}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="OnEditRulesClick" AutomationProperties.AutomationId="EditRulesButton" ToolTipService.ToolTip="{loc:Str Key=Room_EditRulesHint}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                                            <FontIcon Glyph="&#xE8A1;" FontSize="{StaticResource BodyFontSize}" />
                                            <TextBlock Text="{loc:Str Key=Terminal_EditRules}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource GapSmall}" VerticalAlignment="Center">
                                        <!-- 있음/없음이 회색 본문 한 줄이면 한눈에 안 갈린다 (§2-E3) -->
                                        <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.HasRules, Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE738;" FontSize="{StaticResource BodyFontSize}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ViewModel.HasNoRules, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.RulesStatusText, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.RulesStatusText, Mode=OneWay}"
                                            Style="{StaticResource MutedText}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!--
                                    프롬프트: 새로 시작할 때 첫 메시지로 보낼 것. 골라도 되고 안 골라도 된다.
                                    3단계에 있다가 여기로 옮겼다 — 필수 단계에서 선택 사항을 물으면 답이 끝난 줄 모른다 (2026-09-10 사람의 요청).
                                    "이어서"에는 첫 메시지라는 것이 없으므로 새로 시작을 고른 뒤에만 보인다
                                -->
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="StartPromptBox"
                                    Header="{loc:Str Key=Terminal_PromptLabel}"
                                    ToolTipService.ToolTip="{loc:Str Key=Terminal_PromptHint}"
                                    Visibility="{x:Bind ViewModel.ShowNewSessionOptions, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.PromptChoices}"
                                    SelectedItem="{x:Bind ViewModel.SelectedPrompt, Mode=TwoWay}"
                                    DisplayMemberPath="Name" />
                                <TextBlock Text="{loc:Str Key=Terminal_PromptHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ShowNewSessionOptions, Mode=OneWay}" />

                                <!-- 모델: 도구가 알려 준 목록. 고르면 아래 인자 칸의 모델 플래그를 고쳐 쓴다. 칸이 곧 실행될 인자다 -->
                                <ComboBox
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="ModelPicker"
                                        Header="{loc:Str Key=Terminal_ModelHeader}"
                                        ToolTipService.ToolTip="{loc:Str Key=Terminal_ModelTip}"
                                        ItemsSource="{x:Bind ViewModel.SelectedTool.ModelChoices, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedTool.SelectedModel, Mode=OneWay}"
                                        DisplayMemberPath="Name"
                                        SelectionChanged="OnModelPicked" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedTool.ModelStatusText, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.SelectedTool.HasModelStatus, Mode=OneWay}"
                                        Style="{StaticResource MutedText}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        AutomationProperties.AutomationId="ArgumentsBox"
                                        AutomationProperties.Name="{loc:Str Key=Terminal_OptionArgs}"
                                        ToolTipService.ToolTip="{loc:Str Key=Terminal_ArgsTip}"
                                        Text="{x:Bind ViewModel.SelectedTool.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{loc:Str Key=Terminal_ArgsPlaceholder}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTool.PresetsTitle, Mode=OneWay}" Style="{StaticResource MutedText}" Visibility="{x:Bind ViewModel.SelectedTool.HasPresets, Mode=OneWay}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedTool.Presets, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="160" MinRowSpacing="{StaticResource GapMedium}" MinColumnSpacing="{StaticResource GapMedium}" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ArgumentPreset">
                                                <Button Tag="{x:Bind Flag}" Click="OnPresetClick" HorizontalAlignment="Stretch" ToolTipService.ToolTip="{loc:Str Key=Terminal_PresetTip}">
                                                    <StackPanel Spacing="{StaticResource GapHair}" Padding="2">
                                                        <TextBlock Text="{x:Bind Label}" />
                                                        <TextBlock Text="{x:Bind Flag}" Style="{StaticResource MutedText}" FontSize="{StaticResource CaptionFontSize}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>

                            <!-- ───── 실행 줄: 남은 것 한 문장 + 사람 말 + 명령 + 버튼. 카드 바닥에 붙는다 ───── -->
                            <!-- 바닥 띠는 세로로 아낀다(여백 12, 줄 사이 8). 여기서 아낀 픽셀이 위 지난 대화 목록의 줄 수가 된다 -->
                            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="20,12,20,12">
                                <StackPanel Spacing="{StaticResource GapMedium}">

                                    <TextBlock
                                        AutomationProperties.AutomationId="RemainingHint"
                                        Text="{x:Bind ViewModel.RemainingHint, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasRemainingHint, Mode=OneWay}"
                                        Style="{StaticResource MutedText}"
                                        TextWrapping="Wrap" />

                                    <!--
                                        사람 말이 위, 기계 말이 아래. 지금까지 이 화면에서 "무엇이 실행되는가"를
                                        알려 주는 곳은 버튼 옆 회색 잔글씨 하나였고 그나마 잘렸다 (§2-D1)
                                    -->
                                    <TextBlock
                                        AutomationProperties.AutomationId="PreviewSentence"
                                        Text="{x:Bind ViewModel.PreviewSentence, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasPreviewSentence, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="{StaticResource GapMedium}" Visibility="{x:Bind ViewModel.ShowPreview, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            AutomationProperties.AutomationId="LaunchPreview"
                                            Text="{x:Bind ViewModel.Preview, Mode=OneWay}"
                                            Style="{StaticResource MonoText}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center"
                                            IsTextSelectionEnabled="True"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Preview, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="1"
                                            Padding="8,4"
                                            Click="OnCopyPreviewClick"
                                            AutomationProperties.AutomationId="CopyPreviewButton"
                                            ToolTipService.ToolTip="{loc:Str Key=Common_Copy}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="{StaticResource CaptionFontSize}" />
                                                <TextBlock Text="{loc:Str Key=Common_Copy}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid ColumnSpacing="{StaticResource GapLarge}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            MinWidth="200"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            AutomationProperties.AutomationId="OpenTerminalButton"
                                            ToolTipService.ToolTip="{loc:Str Key=Terminal_OpenTerminalTip}"
                                            Click="OnOpenTerminalClick"
                                            IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}" HorizontalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind ViewModel.SelectedTool.Glyph, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" />
                                                <TextBlock Text="{x:Bind ViewModel.StartButtonText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="LaunchButton"
                                            Command="{x:Bind ViewModel.LaunchCommand}"
                                            CommandParameter="{x:Bind ViewModel.SelectedTool, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.SelectedTool.IsInstalled, Mode=OneWay}"
                                            ToolTipService.ToolTip="{loc:Str Key=Terminal_OpenExternalTip}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="{StaticResource BodyFontSize}" />
                                                <TextBlock Text="{loc:Str Key=Terminal_OpenExternal}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedTool.Hint, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.SelectedTool.HasHint, Mode=OneWay}"
                                        Style="{StaticResource MutedText}"
                                        TextWrapping="Wrap" />
                                    <TextBlock x:Name="EmbeddedStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" Visibility="Collapsed" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.LastCommand, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasLastCommand, Mode=OneWay}"
                                        Style="{StaticResource MonoText}"
                                        Opacity="0.7"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True"
                                        ToolTipService.ToolTip="{loc:Str Key=Terminal_LastCommand}" />
                                </StackPanel>
                            </Border>
                </Grid>
            </Border>

            <!-- 방 본문: 종류에 따라 챗봇(말풍선) 또는 터미널(xterm). 탭·RoomManager는 IRoom 공통 -->
            <Grid x:Name="RoomCard" Visibility="Collapsed">

                <!-- 챗봇 패널: 말풍선 + 입력. DataContext = StreamingRoomViewModel. 지금은 UI 비공개(여는 버튼 없음), 코드는 유지 -->
                <Grid x:Name="ChatbotPanel" RowSpacing="{StaticResource GapMedium}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PillBorder}" HorizontalAlignment="Left" Visibility="{Binding ThinkingVisibility}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                            <muxc:ProgressRing Width="12" Height="12" IsActive="True" />
                            <TextBlock Text="{loc:Str Key=Room_Thinking}" FontSize="{StaticResource CaptionFontSize}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid>
                            <Border Style="{StaticResource NoticeBorder}" VerticalAlignment="Top" Visibility="{Binding EmptyVisibility}">
                                <TextBlock Text="{loc:Str Key=Room_ChatEmpty}" Style="{StaticResource PageSubtitleText}" />
                            </Border>
                            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater AutomationProperties.AutomationId="ChatBubbles" ItemsSource="{Binding Bubbles}"
                                ItemTemplate="{StaticResource ChatBubbleTemplate}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="{StaticResource GapMedium}" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="{StaticResource GapMedium}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="RoomInput"
                            Grid.Column="0"
                            AutomationProperties.AutomationId="RoomInputBox"
                            PlaceholderText="{loc:Str Key=Room_InputPlaceholder}"
                            Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding Suggestions}"
                            TextChanged="OnRoomInputTextChanged"
                            SuggestionChosen="OnRoomSuggestionChosen"
                            QuerySubmitted="OnRoomQuerySubmitted"
                            ItemTemplate="{StaticResource SlashCommandTemplate}">
                        </AutoSuggestBox>
                        <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Content="{loc:Str Key=Room_Send}"
                                AutomationProperties.AutomationId="RoomSendButton" Command="{Binding SendCommand}" />
                    </Grid>
                </Grid>

                <!-- 터미널 패널: 진짜 터미널(xterm)이 남은 높이를 다 쓴다. DataContext = TerminalRoomViewModel -->
                <Border x:Name="TerminalPanel" Style="{StaticResource CardBorder}" Padding="0" Visibility="Collapsed">
                    <terminal:TerminalHost x:Name="Embedded" />
                </Border>

                <!-- 끌어놓기 안내 판. 끄는 동안만 보이고, 놓거나 나가면 사라진다 (IFileDropSink) -->
                <Border
                    x:Name="DropOverlay"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    CornerRadius="{StaticResource RadiusLarge}"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource GapMedium}">
                        <FontIcon Glyph="&#xE723;" FontSize="{StaticResource DisplayFontSize}" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Str Key=Room_DropHint}" Style="{StaticResource PageSubtitleText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </controls:PageBody.Body>
    </controls:PageBody>
</Page>
