<Page
    x:Class="Daiso.App.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer Padding="{StaticResource PagePadding}" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource ContentMaxWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,0,20">

            <StackPanel Spacing="2">
                <TextBlock Text="{loc:Str Key=Terminal_Title}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{loc:Str Key=Terminal_ShellNote}" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>

            <!-- 작업 폴더 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Str Key=Terminal_WorkFolder}" Style="{StaticResource SectionTitleText}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            AutomationProperties.AutomationId="WorkingDirBox"
                            AutomationProperties.Name="{loc:Str Key=Terminal_FolderPath}"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{loc:Str Key=Terminal_FolderPath}" />

                        <muxc:DropDownButton
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ProjectPickerButton">
                            <muxc:DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Str Key=Common_KnownProjects}" />
                                </StackPanel>
                            </muxc:DropDownButton.Content>
                            <muxc:DropDownButton.Flyout>
                                <MenuFlyout x:Name="ProjectFlyout" Opening="OnProjectFlyoutOpening" />
                            </muxc:DropDownButton.Flyout>
                        </muxc:DropDownButton>
                    </Grid>

                    <TextBlock Text="{loc:Str Key=Terminal_RecentFolders}" Style="{StaticResource MutedText}" />

                    <ListView
                        AutomationProperties.AutomationId="RecentFolderList"
                        ItemsSource="{x:Bind ViewModel.RecentFolders}"
                        SelectionMode="Single"
                        MaxHeight="150"
                        SelectionChanged="OnRecentSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    Text="{x:Bind}"
                                    Style="{StaticResource MonoText}"
                                    ToolTipService.ToolTip="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Style="{StaticResource NoticeBorder}" Visibility="{x:Bind ViewModel.HasNoRecentFolders, Mode=OneWay}">
                        <TextBlock Text="{loc:Str Key=Terminal_NoRecent}" Style="{StaticResource PageSubtitleText}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 인자 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Str Key=Terminal_OptionArgs}" Style="{StaticResource SectionTitleText}" />

                    <TextBox
                        AutomationProperties.AutomationId="ArgumentsBox"
                        AutomationProperties.Name="{loc:Str Key=Terminal_OptionArgs}"
                        Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Str Key=Terminal_ArgsPlaceholder}" />

                    <TextBlock Text="{loc:Str Key=Terminal_ClaudePresets}" Style="{StaticResource MutedText}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ClaudePresets}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="170"
                                MinRowSpacing="8"
                                MinColumnSpacing="8"
                                ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}" Tag="{x:Bind}" Click="OnPresetClick" HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock Text="{loc:Str Key=Terminal_CodexPresets}" Style="{StaticResource MutedText}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.CodexPresets}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="170"
                                MinRowSpacing="8"
                                MinColumnSpacing="8"
                                ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}" Tag="{x:Bind}" Click="OnPresetClick" HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock Text="{loc:Str Key=Terminal_GeminiPresets}" Style="{StaticResource MutedText}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.GeminiPresets}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="170"
                                MinRowSpacing="8"
                                MinColumnSpacing="8"
                                ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}" Tag="{x:Bind}" Click="OnPresetClick" HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- 실행 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Str Key=Terminal_Launch}" Style="{StaticResource SectionTitleText}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="LaunchClaudeButton"
                            Command="{x:Bind ViewModel.LaunchClaudeCommand}"
                            IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE756;" FontSize="14" />
                                <TextBlock Text="{loc:Str Key=Terminal_OpenClaude}" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="LaunchCodexButton"
                            Command="{x:Bind ViewModel.LaunchCodexCommand}"
                            IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE756;" FontSize="14" />
                                <TextBlock Text="{loc:Str Key=Terminal_OpenCodex}" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="LaunchGeminiButton"
                            Command="{x:Bind ViewModel.LaunchGeminiCommand}"
                            IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE756;" FontSize="14" />
                                <TextBlock Text="{loc:Str Key=Terminal_OpenGemini}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Str Key=Terminal_Preview}" Style="{StaticResource MutedText}" />
                        <TextBlock
                            AutomationProperties.AutomationId="ClaudePreview"
                            Text="{x:Bind ViewModel.ClaudePreview, Mode=OneWay}"
                            Style="{StaticResource MonoText}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            AutomationProperties.AutomationId="CodexPreview"
                            Text="{x:Bind ViewModel.CodexPreview, Mode=OneWay}"
                            Style="{StaticResource MonoText}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            AutomationProperties.AutomationId="GeminiPreview"
                            Text="{x:Bind ViewModel.GeminiPreview, Mode=OneWay}"
                            Style="{StaticResource MonoText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasLastCommand, Mode=OneWay}">
                        <TextBlock Text="{loc:Str Key=Terminal_LastCommand}" Style="{StaticResource MutedText}" />
                        <TextBlock
                            AutomationProperties.AutomationId="LastCommand"
                            Text="{x:Bind ViewModel.LastCommand, Mode=OneWay}"
                            Style="{StaticResource MonoText}"
                            TextTrimming="None"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
