<Page
    x:Class="Daiso.App.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Daiso.App.ViewModels"
    xmlns:terminal="using:Daiso.App.Terminal"
    xmlns:prompts="using:Daiso.Core.Prompts"
    NavigationCacheMode="Required">

    <!-- 화면은 두 상태다. 로비(도구·폴더·인자를 고르는 카드 하나)와 방(열린 터미널이 화면을 채운다).
         방을 열면 로비가 사라지고 터미널이 뜬다. 방 머리의 "새 터미널"로 로비에 돌아온다. (ARCHITECTURE §5.3)
         NavigationCacheMode=Required: 화면을 떠났다 돌아와도 WebView2를 다시 만들거나 버퍼를 재생하지 않는다 -->
    <Grid>

        <!-- ───── 로비 ───── -->
        <ScrollViewer x:Name="Lobby" Padding="{StaticResource PagePadding}" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource ContentMaxWidth}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,0,20">

                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Str Key=Terminal_Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Str Key=Terminal_ShellNote}" Style="{StaticResource PageSubtitleText}" />
                    </StackPanel>

                    <!-- 이미 열린 방이 있을 때만: 로비에서 방으로 돌아가는 길 -->
                    <Border x:Name="OpenRoomsNotice" Style="{StaticResource NoticeBorder}" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OpenRoomsText" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource PageSubtitleText}" />
                            <Button Grid.Column="1" Content="{loc:Str Key=Terminal_ShowRooms}" Click="OnShowRoomsClick" AutomationProperties.AutomationId="ShowRoomsButton" />
                        </Grid>
                    </Border>

                    <!-- 도구 탭이 붙은 카드 하나. 탭 띠가 카드 머리에 있고 폴더·인자·실행이 그 아래 이어진다. 순서는 ToolLook.DisplayOrder -->
                    <Border Style="{StaticResource CardBorder}" Padding="0">
                        <StackPanel>
                            <Border
                                Padding="12,8,12,0"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <muxc:SelectorBar x:Name="ToolTabs" SelectionChanged="OnToolTabChanged" AutomationProperties.AutomationId="ToolTabs">
                                    <muxc:SelectorBarItem Text="Codex" IsSelected="True" AutomationProperties.AutomationId="ToolTabCodex">
                                        <muxc:SelectorBarItem.Icon>
                                            <FontIcon Glyph="&#xE756;" />
                                        </muxc:SelectorBarItem.Icon>
                                    </muxc:SelectorBarItem>
                                    <muxc:SelectorBarItem Text="Claude" AutomationProperties.AutomationId="ToolTabClaude">
                                        <muxc:SelectorBarItem.Icon>
                                            <FontIcon Glyph="&#xE756;" />
                                        </muxc:SelectorBarItem.Icon>
                                    </muxc:SelectorBarItem>
                                    <muxc:SelectorBarItem Text="Gemini" AutomationProperties.AutomationId="ToolTabGemini">
                                        <muxc:SelectorBarItem.Icon>
                                            <FontIcon Glyph="&#xE756;" />
                                        </muxc:SelectorBarItem.Icon>
                                    </muxc:SelectorBarItem>
                                </muxc:SelectorBar>
                            </Border>

                            <StackPanel Spacing="14" Padding="20,16,20,20">

                                <!-- 작업 폴더: 모든 도구가 같은 폴더를 쓴다 -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Str Key=Terminal_WorkFolder}" Style="{StaticResource SectionTitleText}" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            Grid.Column="0"
                                            AutomationProperties.AutomationId="WorkingDirBox"
                                            AutomationProperties.Name="{loc:Str Key=Terminal_FolderPath}"
                                            FontFamily="Consolas"
                                            Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{loc:Str Key=Terminal_FolderPath}" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <muxc:DropDownButton AutomationProperties.AutomationId="ProjectPickerButton">
                                                <muxc:DropDownButton.Content>
                                                    <TextBlock Text="{loc:Str Key=Common_KnownProjects}" />
                                                </muxc:DropDownButton.Content>
                                                <muxc:DropDownButton.Flyout>
                                                    <MenuFlyout x:Name="ProjectFlyout" Opening="OnProjectFlyoutOpening" />
                                                </muxc:DropDownButton.Flyout>
                                            </muxc:DropDownButton>

                                            <muxc:DropDownButton AutomationProperties.AutomationId="PromptPickerButton">
                                                <muxc:DropDownButton.Content>
                                                    <TextBlock Text="{loc:Str Key=Terminal_MyPrompts}" />
                                                </muxc:DropDownButton.Content>
                                                <muxc:DropDownButton.Flyout>
                                                    <MenuFlyout x:Name="PromptFlyout" Opening="OnPromptFlyoutOpening" />
                                                </muxc:DropDownButton.Flyout>
                                            </muxc:DropDownButton>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 최근 폴더: 있으면 짧은 목록, 없으면 한 줄 안내 -->
                                    <ListView
                                        AutomationProperties.AutomationId="RecentFolderList"
                                        AutomationProperties.Name="{loc:Str Key=Terminal_RecentFolders}"
                                        ItemsSource="{x:Bind ViewModel.RecentFolders}"
                                        SelectionMode="Single"
                                        MaxHeight="120"
                                        Visibility="{x:Bind ViewModel.HasRecentFolders, Mode=OneWay}"
                                        SelectionChanged="OnRecentSelectionChanged">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="30" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock
                                                    Text="{x:Bind}"
                                                    Style="{StaticResource MonoText}"
                                                    ToolTipService.ToolTip="{x:Bind}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock
                                        Text="{loc:Str Key=Terminal_NoRecent}"
                                        Style="{StaticResource MutedText}"
                                        Visibility="{x:Bind ViewModel.HasNoRecentFolders, Mode=OneWay}" />
                                </StackPanel>

                                <!-- 인자 -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Str Key=Terminal_OptionArgs}" Style="{StaticResource SectionTitleText}" />
                                    <TextBox
                                        AutomationProperties.AutomationId="ArgumentsBox"
                                        AutomationProperties.Name="{loc:Str Key=Terminal_OptionArgs}"
                                        Text="{x:Bind ViewModel.SelectedTool.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{loc:Str Key=Terminal_ArgsPlaceholder}" />

                                    <TextBlock Text="{x:Bind ViewModel.SelectedTool.PresetsTitle, Mode=OneWay}" Style="{StaticResource MutedText}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedTool.Presets, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                MinItemWidth="170"
                                                MinRowSpacing="8"
                                                MinColumnSpacing="8"
                                                ItemsStretch="None" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Content="{x:Bind}" Tag="{x:Bind}" Click="OnPresetClick" HorizontalAlignment="Stretch" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <!-- 실행: 기본은 앱 안 터미널. 설치돼 있지 않으면 같은 버튼이 설치가 된다. 새 창은 보조 -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Str Key=Terminal_Launch}" Style="{StaticResource SectionTitleText}" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            MinWidth="200"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            AutomationProperties.AutomationId="OpenTerminalButton"
                                            Click="OnOpenTerminalClick"
                                            IsEnabled="{x:Bind ViewModel.SelectedTool.CanPress, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind ViewModel.SelectedTool.Glyph, Mode=OneWay}" FontSize="14" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedTool.EmbeddedButtonText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            AutomationProperties.AutomationId="LaunchButton"
                                            Command="{x:Bind ViewModel.LaunchCommand}"
                                            CommandParameter="{x:Bind ViewModel.SelectedTool, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.SelectedTool.CanPress, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.SelectedTool.IsInstalled, Mode=OneWay}"
                                            Content="{loc:Str Key=Terminal_OpenExternal}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTool.ButtonText, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedTool.Hint, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.SelectedTool.HasHint, Mode=OneWay}"
                                        Style="{StaticResource MutedText}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        x:Name="EmbeddedStatus"
                                        Style="{StaticResource MutedText}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Str Key=Terminal_Preview}" Style="{StaticResource MutedText}" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="LaunchPreview"
                                            Text="{x:Bind ViewModel.SelectedTool.Preview, Mode=OneWay}"
                                            Style="{StaticResource MonoText}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTool.Preview, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasLastCommand, Mode=OneWay}">
                                        <TextBlock Text="{loc:Str Key=Terminal_LastCommand}" Style="{StaticResource MutedText}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.LastCommand, Mode=OneWay}"
                                            Style="{StaticResource MonoText}"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ───── 방: 열린 터미널이 화면을 채운다 ───── -->
        <Grid x:Name="RoomView" Padding="{StaticResource PagePadding}" RowSpacing="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 머리: 새 터미널(로비로) + 방 탭 띠 + 찾기(터미널 방만). 방은 RoomManager가 들고 있어 화면을 옮겨도 산다 -->
            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 찾기: xterm search 애드온. Enter 다음, Shift+Enter 이전, 비우면 표시 지움 -->
                <StackPanel x:Name="FindPanel" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBox
                        x:Name="FindBox"
                        Width="200"
                        PlaceholderText="{loc:Str Key=Room_FindPlaceholder}"
                        AutomationProperties.AutomationId="TerminalFindBox"
                        TextChanged="OnFindTextChanged"
                        KeyDown="OnFindKeyDown" />
                    <Button Padding="6" Click="OnFindPrevClick" ToolTipService.ToolTip="{loc:Str Key=Room_FindPrev}" AutomationProperties.Name="{loc:Str Key=Room_FindPrev}">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button Padding="6" Click="OnFindNextClick" ToolTipService.ToolTip="{loc:Str Key=Room_FindNext}" AutomationProperties.Name="{loc:Str Key=Room_FindNext}">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                </StackPanel>

                <Button Grid.Column="0" Click="OnBackToLobbyClick" AutomationProperties.AutomationId="NewTerminalButton" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="{loc:Str Key=Room_NewTerminal}" />
                    </StackPanel>
                </Button>

                <ListView
                    x:Name="RoomTabs"
                    Grid.Column="1"
                    SelectionMode="Single"
                    SelectionChanged="OnRoomTabChanged"
                    AutomationProperties.AutomationId="RoomTabs"
                    ScrollViewer.HorizontalScrollMode="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="MinWidth" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:IRoom">
                            <Grid ColumnSpacing="8" Padding="6,2" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{x:Bind AvatarBrush}">
                                        <TextBlock Text="{x:Bind Avatar}" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- 안 본 새 답 점 -->
                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                             Fill="{ThemeResource SystemFillColorAttentionBrush}" Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="1.5"
                                             Visibility="{x:Bind UnseenVisibility, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{x:Bind ShortTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                <Button
                                    Grid.Column="2"
                                    Padding="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    AutomationProperties.Name="{loc:Str Key=Common_Close}"
                                    ToolTipService.ToolTip="{loc:Str Key=Common_Close}"
                                    Click="OnCloseRoomClick"
                                    DataContext="{x:Bind}">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 방 본문: 종류에 따라 챗봇(말풍선) 또는 터미널(xterm). 탭·RoomManager는 IRoom 공통 -->
            <Grid x:Name="RoomCard" Grid.Row="1">

                <!-- 챗봇 패널: 말풍선 + 입력. DataContext = StreamingRoomViewModel. 지금은 UI 비공개(여는 버튼 없음), 코드는 유지 -->
                <Grid x:Name="ChatbotPanel" RowSpacing="10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PillBorder}" HorizontalAlignment="Left" Visibility="{Binding ThinkingVisibility}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <muxc:ProgressRing Width="12" Height="12" IsActive="True" />
                            <TextBlock Text="{loc:Str Key=Room_Thinking}" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid>
                            <Border Style="{StaticResource NoticeBorder}" VerticalAlignment="Top" Visibility="{Binding EmptyVisibility}">
                                <TextBlock Text="{loc:Str Key=Room_ChatEmpty}" Style="{StaticResource PageSubtitleText}" />
                            </Border>
                            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater AutomationProperties.AutomationId="ChatBubbles" ItemsSource="{Binding Bubbles}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChatBubbleViewModel">
                                            <Grid>
                                                <Border Visibility="{x:Bind UserVisibility}" HorizontalAlignment="Right" MaxWidth="640"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="12,8">
                                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" Foreground="White" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                </Border>
                                                <Grid Visibility="{x:Bind AssistantVisibility}" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top" Background="{x:Bind AvatarBrush}">
                                                        <TextBlock Text="{x:Bind Avatar}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind SpeakerText}" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" />
                                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    </StackPanel>
                                                </Grid>
                                                <muxc:Expander Visibility="{x:Bind ToolVisibility}" HorizontalAlignment="Stretch">
                                                    <muxc:Expander.Header>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                                                        </StackPanel>
                                                    </muxc:Expander.Header>
                                                    <TextBlock Text="{x:Bind ResultText, Mode=OneWay}" Style="{StaticResource MonoText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind ResultVisibility, Mode=OneWay}" />
                                                </muxc:Expander>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="RoomInput"
                            Grid.Column="0"
                            AutomationProperties.AutomationId="RoomInputBox"
                            PlaceholderText="{loc:Str Key=Room_InputPlaceholder}"
                            Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding Suggestions}"
                            TextChanged="OnRoomInputTextChanged"
                            SuggestionChosen="OnRoomSuggestionChosen"
                            QuerySubmitted="OnRoomQuerySubmitted">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="prompts:SlashCommand">
                                    <Grid ColumnSpacing="10" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Invocation}" Style="{StaticResource MonoText}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Description}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                        <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Content="{loc:Str Key=Room_Send}"
                                AutomationProperties.AutomationId="RoomSendButton" Command="{Binding SendCommand}" />
                    </Grid>
                </Grid>

                <!-- 터미널 패널: 진짜 터미널(xterm)이 남은 높이를 다 쓴다. DataContext = TerminalRoomViewModel -->
                <Border x:Name="TerminalPanel" Visibility="Collapsed" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <terminal:TerminalHost x:Name="Embedded" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
