<Page
    x:Class="Daiso.App.Views.PromptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Daiso.App.ViewModels"
    xmlns:controls="using:Daiso.App.Controls">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 제목 · 명령바. 다른 화면과 같은 자리 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{loc:Str Key=Prompts_Title}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{loc:Str Key=Prompts_Subtitle}" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>

            <muxc:CommandBar
                Grid.Column="1"
                DefaultLabelPosition="Right"
                HorizontalAlignment="Left"
                Background="Transparent">
                <muxc:AppBarButton
                    Label="{loc:Str Key=Prompts_New}"
                    Icon="Add"
                    AutomationProperties.AutomationId="PromptNewButton"
                    Command="{x:Bind ViewModel.NewCommand}" />
                <muxc:AppBarButton
                    Label="{loc:Str Key=Prompts_SaveToLibrary}"
                    Icon="Save"
                    AutomationProperties.AutomationId="PromptSaveButton"
                    IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SaveToLibraryCommand}">
                    <muxc:AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </muxc:AppBarButton.KeyboardAccelerators>
                </muxc:AppBarButton>
                <muxc:AppBarButton
                    Label="{loc:Str Key=Common_Delete}"
                    Icon="Delete"
                    AutomationProperties.AutomationId="PromptDeleteButton"
                    IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
                    Click="OnDeleteClick" />
            </muxc:CommandBar>
        </Grid>

        <!-- 왼쪽 목록 · 끌 수 있는 구분선 · 오른쪽 편집기. 구분선 자체가 간격 노릇을 한다 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="280" MinWidth="180" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
                <ListView
                    AutomationProperties.AutomationId="PromptList"
                    ItemsSource="{x:Bind ViewModel.Gallery}"
                    SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                    SelectionMode="Single"
                    ContainerContentChanging="OnPromptContainerChanging">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PromptGalleryItemViewModel">
                            <StackPanel Spacing="2" Margin="0,6,0,6">
                                <TextBlock Text="{x:Bind Badge}" Style="{StaticResource MutedText}" FontSize="11" />
                                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind Description}"
                                    Style="{StaticResource MutedText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <controls:PaneSplitter Grid.Column="1" SettingsKey="Prompts" />

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Header="{loc:Str Key=Prompts_Name}"
                            AutomationProperties.AutomationId="PromptNameBox"
                            Text="{x:Bind ViewModel.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Grid.Column="1"
                            Header="{loc:Str Key=Prompts_Description}"
                            Text="{x:Bind ViewModel.EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            MinWidth="140"
                            Header="{loc:Str Key=Prompts_Category}"
                            ItemsSource="{x:Bind ViewModel.Categories}"
                            SelectedIndex="{x:Bind ViewModel.CategoryIndex, Mode=TwoWay}" />
                        <TextBox
                            Grid.Column="1"
                            Header="{loc:Str Key=Prompts_Output}"
                            PlaceholderText="{loc:Str Key=Prompts_OutputPlaceholder}"
                            Text="{x:Bind ViewModel.EditOutput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBox
                        Grid.Row="2"
                        Header="{loc:Str Key=Prompts_Body}"
                        AutomationProperties.AutomationId="PromptBodyBox"
                        Text="{x:Bind ViewModel.EditBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VerticalAlignment="Stretch" />

                    <!-- 프로젝트에 넣기: 폴더 고르고 파일로 쓴 뒤 시작 메시지를 복사한다 -->
                    <StackPanel Grid.Row="3" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Header="{loc:Str Key=Prompts_ProjectFolder}"
                                PlaceholderText="{loc:Str Key=Prompts_ProjectFolderPlaceholder}"
                                AutomationProperties.AutomationId="PromptProjectBox"
                                Text="{x:Bind ViewModel.ProjectDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <muxc:DropDownButton
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Content="{loc:Str Key=Prompts_KnownProjects}"
                                AutomationProperties.AutomationId="PromptProjectPicker">
                                <muxc:DropDownButton.Flyout>
                                    <MenuFlyout x:Name="ProjectFlyout" Opening="OnProjectFlyoutOpening" />
                                </muxc:DropDownButton.Flyout>
                            </muxc:DropDownButton>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Style="{ThemeResource AccentButtonStyle}"
                                Content="{loc:Str Key=Prompts_WriteIntoProject}"
                                AutomationProperties.AutomationId="PromptWriteButton"
                                Click="OnWriteClick" />
                        </Grid>

                        <Border Style="{StaticResource NoticeBorder}" Visibility="{x:Bind ViewModel.HasStarter, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{loc:Str Key=Prompts_StarterLabel}" Style="{StaticResource MutedText}" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="PromptStarterText"
                                        Text="{x:Bind ViewModel.StarterMessage, Mode=OneWay}"
                                        Style="{StaticResource MonoText}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{loc:Str Key=Prompts_CopyStarter}"
                                    AutomationProperties.AutomationId="PromptCopyStarterButton"
                                    Click="OnCopyStarterClick" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="{loc:Str Key=Prompts_CopyBody}"
                                AutomationProperties.AutomationId="PromptCopyBodyButton"
                                Click="OnCopyBodyClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="2"
            AutomationProperties.AutomationId="PromptStatus"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            Style="{StaticResource MutedText}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
