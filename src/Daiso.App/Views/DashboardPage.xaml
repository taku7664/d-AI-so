<Page
    x:Class="Daiso.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Daiso.App.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <!-- 골격은 PageBody 가 정한다: 명령 줄 → 필터 줄 → 본문. 여백 24, 줄 사이 12, 폭은 Reading(1280 상한) (UI_REFACTOR_PLAN §6) -->
    <controls:PageBody Layout="Reading">
        <controls:PageBody.Commands>
            <StackPanel Spacing="{StaticResource GapLarge}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}">
                    <Button
                        AutomationProperties.AutomationId="DashboardReloadButton"
                        ToolTipService.ToolTip="{loc:Str Key=Common_ReloadTip}"
                        Command="{x:Bind ViewModel.LoadCommand}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}">
                            <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource BodyFontSize}" />
                            <TextBlock Text="{loc:Str Key=Common_Reload}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <muxc:ProgressBar
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </controls:PageBody.Commands>

        <!-- 필터 줄: 전체 · 도구별. 카드·최근 세션·통계가 탭을 따라간다 -->
        <controls:PageBody.Filters>
                <muxc:SelectorBar x:Name="ToolTabs" SelectionChanged="OnToolTabChanged" AutomationProperties.AutomationId="ToolTabs">
                    <muxc:SelectorBarItem Text="{loc:Str Key=Common_All}" IsSelected="True" AutomationProperties.AutomationId="ToolTabAll" />
                    <muxc:SelectorBarItem Text="Codex" AutomationProperties.AutomationId="ToolTabCodex" />
                    <muxc:SelectorBarItem Text="Claude" AutomationProperties.AutomationId="ToolTabClaude" />
                    <muxc:SelectorBarItem Text="Antigravity" AutomationProperties.AutomationId="ToolTabAntigravity" />
                </muxc:SelectorBar>
        </controls:PageBody.Filters>

        <controls:PageBody.Body>
            <StackPanel Spacing="{StaticResource GapXLarge}">
                <TextBlock Text="{loc:Str Key=Dashboard_ToolStatus}" Style="{StaticResource SectionTitleText}" />

                <!-- 도구 카드: 도구 수만큼. 넓으면 한 줄에 셋, 좁으면 줄을 바꾼다 -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibleTools}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="330"
                            MaximumRowsOrColumns="3"
                            MinRowSpacing="{StaticResource GapXLarge}"
                            MinColumnSpacing="{StaticResource GapXLarge}"
                            ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolCardViewModel">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel Spacing="{StaticResource GapLarge}">

                                    <!-- 제목 줄: 점 · 이름 · 상태 알약 -->
                                    <Grid ColumnSpacing="{StaticResource GapMedium}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 로고 원 + 오른쪽 아래 상태 점(로그인 초록/노랑/빨강) -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <controls:ToolIcon Kind="{x:Bind Kind}" Size="28" />
                                            <Ellipse
                                                Width="{StaticResource StatusDotSize}"
                                                Height="{StaticResource StatusDotSize}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,-2,-2"
                                                Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                StrokeThickness="1.5"
                                                Fill="{x:Bind StateBrush, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Title}"
                                            Style="{StaticResource SectionTitleText}" />

                                        <Border Grid.Column="2" Style="{StaticResource PillBorder}">
                                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="{StaticResource CaptionFontSize}" />
                                        </Border>
                                    </Grid>

                                    <!-- 계정 -->
                                    <StackPanel Spacing="{StaticResource GapMicro}">
                                        <TextBlock
                                            Text="{x:Bind AccountLabel, Mode=OneWay}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            ToolTipService.ToolTip="{x:Bind AccountLabel, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind Email, Mode=OneWay}"
                                            Style="{StaticResource MutedText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                                            <FontIcon
                                                Glyph="&#xE823;"
                                                FontSize="{StaticResource CaptionFontSize}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ExpiresText, Mode=OneWay}"
                                                Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{x:Bind InstalledText, Mode=OneWay}"
                                            Style="{StaticResource MutedText}" />
                                    </StackPanel>

                                    <!-- Expander 기본값은 내용을 가운데 놓는다. 키: 값 줄은 왼쪽에 붙어야 위아래가 한 표로 읽힌다 -->
                                    <Expander
                                        Header="{loc:Str Key=Common_Extras}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Visibility="{x:Bind HasExtras, Mode=OneWay}">
                                        <!-- 세션 화면의 부가 정보 줄과 같은 것이다. 사전에서 가져다 쓴다 -->
                                        <ItemsControl
                                            ItemsSource="{x:Bind Extras}"
                                            ItemTemplate="{StaticResource ExtraLineTemplate}" />
                                    </Expander>

                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMedium}">
                                        <Button
                                            Content="{x:Bind LoginLabel, Mode=OneWay}"
                                            Visibility="{x:Bind NeedsLogin, Mode=OneWay}"
                                            Click="OnLoginClick"
                                            DataContext="{x:Bind}" />

                                        <!-- 계정 저장·전환은 그 도구 카드 안에서 한다 (ARCHITECTURE §6.1) -->
                                        <muxc:DropDownButton
                                            Content="{x:Bind AccountsButtonText, Mode=OneWay}"
                                            AutomationProperties.AutomationId="AccountsButton">
                                            <muxc:DropDownButton.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <!-- 기본 FlyoutPresenter는 456px에서 자른다. 계정 줄(이름·계정·시각·버튼 둘)이 들어가게 넓힌다 -->
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="MaxWidth" Value="620" />
                                                            <Setter Property="Padding" Value="16" />
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <!-- 팝오버는 무한 폭으로 재어지므로 폭을 고정해야 * 열이 줄어들고 버튼이 안 잘린다 -->
                                                    <StackPanel Spacing="{StaticResource GapMedium}" Width="540">
                                                        <TextBlock
                                                            Text="{loc:Str Key=AuthProfile_Hint}"
                                                            Style="{StaticResource PageSubtitleText}" />

                                                        <Button
                                                            Content="{loc:Str Key=AuthProfile_SaveCurrent}"
                                                            AutomationProperties.AutomationId="SaveProfileButton"
                                                            Click="OnSaveProfileClick"
                                                            DataContext="{x:Bind}" />

                                                        <Border Style="{StaticResource NoticeBorder}" Visibility="{x:Bind HasNoProfiles, Mode=OneWay}">
                                                            <TextBlock Text="{loc:Str Key=AuthProfile_Empty}" Style="{StaticResource PageSubtitleText}" />
                                                        </Border>

                                                        <ItemsControl
                                                            AutomationProperties.AutomationId="ProfileList"
                                                            Visibility="{x:Bind HasProfiles, Mode=OneWay}"
                                                            ItemsSource="{x:Bind Profiles}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:AuthProfileRowViewModel">
                                                                    <Grid ColumnSpacing="{StaticResource GapLarge}" Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0" Spacing="{StaticResource GapHair}" VerticalAlignment="Center">
                                                                            <TextBlock
                                                                                Text="{x:Bind Name}"
                                                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                                TextWrapping="NoWrap"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedText}" />
                                                                        </StackPanel>

                                                                        <Button
                                                                            Grid.Column="1"
                                                                            Content="{loc:Str Key=AuthProfile_Use}"
                                                                            AutomationProperties.AutomationId="UseProfileButton"
                                                                            Click="OnUseProfileClick"
                                                                            DataContext="{x:Bind}" />

                                                                        <Button
                                                                            Grid.Column="2"
                                                                            Content="{loc:Str Key=Common_Delete}"
                                                                            AutomationProperties.AutomationId="RemoveProfileButton"
                                                                            Click="OnRemoveProfileClick"
                                                                            DataContext="{x:Bind}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock
                                                            AutomationProperties.AutomationId="ProfileStatus"
                                                            Text="{x:Bind ProfileStatus, Mode=OneWay}"
                                                            Style="{StaticResource MutedText}"
                                                            TextTrimming="None"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Flyout>
                                            </muxc:DropDownButton.Flyout>
                                        </muxc:DropDownButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>


                <!-- 최근 세션 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="{StaticResource GapLarge}">
                        <TextBlock Text="{loc:Str Key=Dashboard_Recent}" Style="{StaticResource SectionTitleText}" />

                        <Border
                            Style="{StaticResource NoticeBorder}"
                            Visibility="{x:Bind ViewModel.HasNoRecentSessions, Mode=OneWay}">
                            <TextBlock Text="{loc:Str Key=Dashboard_RecentEmpty}" Style="{StaticResource PageSubtitleText}" />
                        </Border>

                        <ItemsControl
                            AutomationProperties.AutomationId="RecentSessionList"
                            ItemsSource="{x:Bind ViewModel.RecentSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentSessionViewModel">
                                    <Grid ColumnSpacing="{StaticResource GapLarge}" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <controls:ToolIcon Grid.Column="0" Kind="{x:Bind Session.Tool}" Size="24" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Spacing="{StaticResource GapHair}">
                                            <TextBlock
                                                Text="{x:Bind ProjectText}"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind PathText}" />
                                            <TextBlock Text="{x:Bind MetaText}" Style="{StaticResource MutedText}" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="ResumeRecentButton"
                                            AutomationProperties.Name="{loc:Str Key=Dashboard_ResumeHere}"
                                            ToolTipService.ToolTip="{loc:Str Key=Dashboard_ResumeHere}"
                                            Click="OnResumeRecentClick"
                                            DataContext="{x:Bind}">
                                            <FontIcon Glyph="&#xE768;" FontSize="{StaticResource BodyFontSize}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- 세션 요약 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="{StaticResource GapLarge}">
                        <Grid ColumnSpacing="{StaticResource GapLarge}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{loc:Str Key=Dashboard_Sessions}"
                                Style="{StaticResource SectionTitleText}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource GapXSmall}">
                                <HyperlinkButton
                                    Content="{loc:Str Key=Dashboard_OpenSessions}"
                                    AutomationProperties.AutomationId="GoToSessionsButton"
                                    Click="OnGoToSessionsClick" />
                                <HyperlinkButton
                                    Content="{loc:Str Key=Dashboard_OpenUsage}"
                                    AutomationProperties.AutomationId="GoToUsageButton"
                                    Click="OnGoToUsageClick" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="{StaticResource GapHuge}" AutomationProperties.AutomationId="SessionSummary">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="{StaticResource GapTiny}">
                                <TextBlock Text="{loc:Str Key=Dashboard_StatSessions}" Style="{StaticResource MutedText}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SessionCount, Mode=OneWay}"
                                    FontSize="{StaticResource TitleFontSize}"
                                    FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="{StaticResource GapTiny}">
                                <TextBlock Text="{loc:Str Key=Dashboard_StatSize}" Style="{StaticResource MutedText}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.TotalSizeText, Mode=OneWay}"
                                    FontSize="{StaticResource TitleFontSize}"
                                    FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="{StaticResource GapTiny}">
                                <TextBlock Text="{x:Bind ViewModel.UsageHeaderText}" Style="{StaticResource MutedText}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.RecentTokensText, Mode=OneWay}"
                                    FontSize="{StaticResource TitleFontSize}"
                                    FontWeight="SemiBold"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.RecentTokensExact, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="{x:Bind ViewModel.RecentUsageText, Mode=OneWay}"
                            Style="{StaticResource MutedText}"
                            TextTrimming="None"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{x:Bind ViewModel.RecentUsageExact, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:PageBody.Body>
    </controls:PageBody>
</Page>
