<Page
    x:Class="Daiso.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <muxc:Pivot Padding="16,8,16,0">

        <!-- 요약 -->
        <muxc:PivotItem Header="요약">
            <ScrollViewer>
                <StackPanel Spacing="20" MaxWidth="1100">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="도구 상태"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            VerticalAlignment="Center" />

                        <Button
                            Grid.Column="1"
                            Content="다시 읽기"
                            AutomationProperties.AutomationId="DashboardReloadButton"
                            Command="{x:Bind ViewModel.LoadCommand}" />
                    </Grid>

                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tools}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="420"
                                MinItemHeight="260"
                                MinRowSpacing="16"
                                MinColumnSpacing="16"
                                ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolCardViewModel">
                                <Border
                                    Padding="20"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="10">

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind Badge, Mode=OneWay}" FontSize="20" />
                                            <TextBlock
                                                Text="{x:Bind Title}"
                                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}">
                                            <Run Text="{x:Bind InstalledText, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{x:Bind StateText, Mode=OneWay}" />
                                        </TextBlock>

                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind AccountLabel, Mode=OneWay}"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind Email, Mode=OneWay}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Opacity="0.8"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind ExpiresText, Mode=OneWay}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Opacity="0.8" />
                                        </StackPanel>

                                        <Expander Header="부가 정보" HorizontalAlignment="Stretch">
                                            <ItemsControl ItemsSource="{x:Bind Extras}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock
                                                            Text="{x:Bind}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>

                                        <Button
                                            Content="로그인 하기"
                                            HorizontalAlignment="Left"
                                            Click="OnLoginClick"
                                            DataContext="{x:Bind}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Border
                        Padding="20"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="세션" Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <TextBlock
                                AutomationProperties.AutomationId="SessionSummary"
                                Style="{ThemeResource BodyTextBlockStyle}">
                                <Run Text="총" />
                                <Run Text="{x:Bind ViewModel.SessionCount, Mode=OneWay}" />
                                <Run Text="건 ·" />
                                <Run Text="{x:Bind ViewModel.TotalSizeText, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0">
                                <Run Text="최근" />
                                <Run Text="{x:Bind ViewModel.UsageDayCount}" />
                                <Run Text="일 토큰 사용량" />
                            </TextBlock>

                            <TextBlock
                                Text="{x:Bind ViewModel.RecentUsageText, Mode=OneWay}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </muxc:PivotItem>

        <!-- 사용량 -->
        <muxc:PivotItem Header="사용량">
            <ScrollViewer>
                <StackPanel Spacing="16" MaxWidth="1100">

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox
                            Header="기간"
                            Width="140"
                            AutomationProperties.AutomationId="UsagePeriodCombo"
                            ItemsSource="{x:Bind Usage.Periods}"
                            SelectedIndex="{x:Bind Usage.PeriodIndex, Mode=TwoWay}" />

                        <Button
                            Content="다시 읽기"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="UsageReloadButton"
                            Command="{x:Bind Usage.LoadCommand}" />

                        <TextBlock
                            VerticalAlignment="Bottom"
                            Margin="8,0,0,6"
                            AutomationProperties.AutomationId="UsageStatus"
                            Text="{x:Bind Usage.StatusText, Mode=OneWay}"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <TextBlock
                        AutomationProperties.AutomationId="UsageCost"
                        Text="{x:Bind Usage.EstimatedCostText, Mode=OneWay}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />

                    <Border
                        Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="일별" Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <ItemsControl ItemsSource="{x:Bind Usage.Days}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UsageDayViewModel">
                                        <Grid ColumnSpacing="10" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="270" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{x:Bind DateText}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                VerticalAlignment="Center" />

                                            <Rectangle
                                                Grid.Column="1"
                                                Height="14"
                                                HorizontalAlignment="Left"
                                                RadiusX="3"
                                                RadiusY="3"
                                                Width="{x:Bind BarWidth}"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind TotalText}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="프로젝트별 상위 10" Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <ItemsControl ItemsSource="{x:Bind Usage.TopProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UsageRowViewModel">
                                        <Grid ColumnSpacing="10" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{x:Bind ShortLabel}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind TotalText}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                HorizontalAlignment="Right" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind PercentText}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="모델별" Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <ItemsControl ItemsSource="{x:Bind Usage.ByModel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UsageRowViewModel">
                                        <Grid ColumnSpacing="10" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{x:Bind Label}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind TotalText}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                HorizontalAlignment="Right" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind PercentText}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                HorizontalAlignment="Right" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{x:Bind CostText}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Text="비용은 Settings의 단가표로 계산한 추정치다. 단가가 없는 모델은 0으로 둔다."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Opacity="0.7"
                        TextWrapping="Wrap" />

                </StackPanel>
            </ScrollViewer>
        </muxc:PivotItem>
    </muxc:Pivot>
</Page>
