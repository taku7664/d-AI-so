<Page
    x:Class="Daiso.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Daiso.App.ViewModels">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="1100">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="Dashboard"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    VerticalAlignment="Center" />

                <Button
                    Grid.Column="1"
                    Content="다시 읽기"
                    Command="{x:Bind ViewModel.LoadCommand}" />
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <!-- 도구별 카드 -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tools}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="420"
                        MinItemHeight="260"
                        MinRowSpacing="16"
                        MinColumnSpacing="16"
                        ItemsStretch="Fill" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolCardViewModel">
                        <Border
                            Padding="20"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind Badge, Mode=OneWay}" FontSize="20" />
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Style="{ThemeResource BodyTextBlockStyle}">
                                    <Run Text="{x:Bind InstalledText, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind StateText, Mode=OneWay}" />
                                </TextBlock>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind AccountLabel, Mode=OneWay}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Email, Mode=OneWay}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Opacity="0.8"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind ExpiresText, Mode=OneWay}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Opacity="0.8" />
                                </StackPanel>

                                <Expander Header="부가 정보" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{x:Bind Extras}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock
                                                    Text="{x:Bind}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <Button
                                    Content="로그인 하기"
                                    HorizontalAlignment="Left"
                                    Click="OnLoginClick"
                                    DataContext="{x:Bind}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- 세션·사용량 요약 -->
            <Border
                Padding="20"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="세션" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}">
                        <Run Text="총" />
                        <Run Text="{x:Bind ViewModel.SessionCount, Mode=OneWay}" />
                        <Run Text="건 ·" />
                        <Run Text="{x:Bind ViewModel.TotalSizeText, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0">
                        <Run Text="최근" />
                        <Run Text="{x:Bind ViewModel.UsageDayCount}" />
                        <Run Text="일 토큰 사용량" />
                    </TextBlock>

                    <TextBlock
                        Text="{x:Bind ViewModel.RecentUsageText, Mode=OneWay}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
