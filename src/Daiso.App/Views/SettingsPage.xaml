<Page
    x:Class="Daiso.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Daiso.App.ViewModels"
    xmlns:loc="using:Daiso.App.Strings">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="18" MaxWidth="1000">

            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />

            <TextBlock
                Text="{x:Bind ViewModel.RestartNotice}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.75"
                TextWrapping="Wrap" />

            <!-- 경로 -->
            <Border
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Str Key=Settings_Paths}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <TextBox
                        Header="{loc:Str Key=Settings_SessionHome}"
                        AutomationProperties.AutomationId="SessionHomeBox"
                        Text="{x:Bind ViewModel.SessionHomeOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Opacity="0.7"
                        TextWrapping="Wrap">
                        <Run Text="{loc:Str Key=Common_DefaultPrefix}" />
                        <Run Text="{x:Bind ViewModel.DefaultSessionHome}" />
                    </TextBlock>

                    <TextBox
                        Header="{loc:Str Key=Settings_IndexPath}"
                        AutomationProperties.AutomationId="IndexPathBox"
                        Text="{x:Bind ViewModel.IndexDatabasePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Opacity="0.7"
                        TextWrapping="Wrap">
                        <Run Text="{loc:Str Key=Common_DefaultPrefix}" />
                        <Run Text="{x:Bind ViewModel.DefaultIndexDatabasePath}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 정리 규칙 -->
            <Border
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Str Key=Settings_CleanupDefaults}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox
                            Header="{loc:Str Key=Settings_OlderThanDays}"
                            Width="220"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            AutomationProperties.AutomationId="OlderThanBox"
                            Value="{x:Bind ViewModel.CleanupOlderThanDays, Mode=TwoWay}" />

                        <NumberBox
                            Header="{loc:Str Key=Settings_LargerThanMb}"
                            Width="220"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            AutomationProperties.AutomationId="LargerThanBox"
                            Value="{x:Bind ViewModel.CleanupLargerThanMegabytes, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 단가표 -->
            <Border
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Str Key=Settings_PriceTable}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="{loc:Str Key=Settings_CostNote}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Opacity="0.7" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="{loc:Str Key=Settings_AddModel}"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="AddPriceButton"
                            Command="{x:Bind ViewModel.AddPriceCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Prices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PriceRowViewModel">
                                <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        PlaceholderText="{loc:Str Key=Settings_ModelName}"
                                        Text="{x:Bind Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <NumberBox
                                        Grid.Column="1"
                                        PlaceholderText="{loc:Str Key=Settings_Input}"
                                        Minimum="0"
                                        Value="{x:Bind InputPerMillion, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="2"
                                        PlaceholderText="{loc:Str Key=Settings_Output}"
                                        Minimum="0"
                                        Value="{x:Bind OutputPerMillion, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="3"
                                        PlaceholderText="{loc:Str Key=Settings_CacheWrite}"
                                        Minimum="0"
                                        Value="{x:Bind CacheWritePerMillion, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="4"
                                        PlaceholderText="{loc:Str Key=Settings_CacheRead}"
                                        Minimum="0"
                                        Value="{x:Bind CacheReadPerMillion, Mode=TwoWay}" />

                                    <Button
                                        Grid.Column="5"
                                        Content="{loc:Str Key=Common_Delete}"
                                        Click="OnRemovePriceClick"
                                        DataContext="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 테마·인덱스 -->
            <Border
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Str Key=Settings_DisplayAndIndex}" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <ComboBox
                        Header="{loc:Str Key=Settings_Theme}"
                        Width="200"
                        AutomationProperties.AutomationId="ThemeCombo"
                        ItemsSource="{x:Bind ViewModel.Themes}"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />

                    <Button
                        Content="{loc:Str Key=Settings_RebuildIndex}"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="RebuildIndexButton"
                        Command="{x:Bind ViewModel.RebuildIndexCommand}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    Content="{loc:Str Key=Common_Save}"
                    Style="{ThemeResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="SaveSettingsButton"
                    Command="{x:Bind ViewModel.SaveCommand}" />
                <Button
                    Content="{loc:Str Key=Common_Reload}"
                    AutomationProperties.AutomationId="ReloadSettingsButton"
                    Command="{x:Bind ViewModel.LoadCommand}" />
            </StackPanel>

            <TextBlock
                AutomationProperties.AutomationId="SettingsStatus"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</Page>
