<Page
    x:Class="Daiso.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource ContentMaxWidth}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,0,8">

                <StackPanel Spacing="2">
                    <TextBlock Text="{loc:Str Key=Settings_Title}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{x:Bind ViewModel.RestartNotice}" Style="{StaticResource PageSubtitleText}" />
                </StackPanel>

                <!-- 경로 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{loc:Str Key=Settings_Paths}" Style="{StaticResource SectionTitleText}" />

                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    FontFamily="Consolas"
                                    AutomationProperties.AutomationId="SessionHomeBox"
                                    Text="{x:Bind ViewModel.SessionHomeOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Header>
                                        <TextBlock
                                            Text="{loc:Str Key=Settings_SessionHome}"
                                            FontFamily="{ThemeResource ContentControlThemeFontFamily}" />
                                    </TextBox.Header>
                                </TextBox>

                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Content="{loc:Str Key=Common_PickFolder}"
                                    AutomationProperties.AutomationId="PickSessionHomeButton"
                                    Click="OnPickSessionHomeClick" />
                            </Grid>

                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="{loc:Str Key=Common_DefaultPrefix}" />
                                <Run FontFamily="Consolas" Text="{x:Bind ViewModel.DefaultSessionHome}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    FontFamily="Consolas"
                                    AutomationProperties.AutomationId="IndexPathBox"
                                    Text="{x:Bind ViewModel.IndexDatabasePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Header>
                                        <TextBlock
                                            Text="{loc:Str Key=Settings_IndexPath}"
                                            FontFamily="{ThemeResource ContentControlThemeFontFamily}" />
                                    </TextBox.Header>
                                </TextBox>

                                <!-- 위 칸과 오른쪽 끝을 맞추려고 같은 크기의 자리만 둔다 -->
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Opacity="0"
                                    IsTabStop="False"
                                    IsHitTestVisible="False"
                                    Content="{loc:Str Key=Common_PickFolder}" />
                            </Grid>

                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="{loc:Str Key=Common_DefaultPrefix}" />
                                <Run FontFamily="Consolas" Text="{x:Bind ViewModel.DefaultIndexDatabasePath}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 정리 규칙 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Key=Settings_CleanupDefaults}" Style="{StaticResource SectionTitleText}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <NumberBox
                                Header="{loc:Str Key=Settings_OlderThanDays}"
                                Width="200"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.AutomationId="CleanupDaysBox"
                                Value="{x:Bind ViewModel.CleanupOlderThanDays, Mode=TwoWay}" />

                            <NumberBox
                                Header="{loc:Str Key=Settings_LargerThanMb}"
                                Width="200"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.AutomationId="CleanupSizeBox"
                                Value="{x:Bind ViewModel.CleanupLargerThanMegabytes, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 단가표 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{loc:Str Key=Settings_PriceTable}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{loc:Str Key=Settings_CostNote}" Style="{StaticResource PageSubtitleText}" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="AddPriceButton"
                                Command="{x:Bind ViewModel.AddPriceCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="{loc:Str Key=Settings_AddModel}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource NoticeBorder}" Visibility="{x:Bind ViewModel.HasNoPrices, Mode=OneWay}">
                            <TextBlock Text="{loc:Str Key=Settings_PriceEmpty}" Style="{StaticResource PageSubtitleText}" />
                        </Border>

                        <!-- 열이 많아 카드 안에서 가로로 넘긴다 -->
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Auto"
                            Visibility="{x:Bind ViewModel.HasPrices, Mode=OneWay}">
                            <StackPanel Spacing="8" MinWidth="820">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Str Key=Settings_ModelName}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="1" Text="{loc:Str Key=Settings_Input}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="2" Text="{loc:Str Key=Settings_Output}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="3" Text="{loc:Str Key=Settings_CacheWrite}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="4" Text="{loc:Str Key=Settings_CacheRead}" Style="{StaticResource MutedText}" />
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.Prices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PriceRowViewModel">
                                            <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox
                                                    Grid.Column="0"
                                                    PlaceholderText="{loc:Str Key=Settings_ModelName}"
                                                    Text="{x:Bind Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                <NumberBox
                                                    Grid.Column="1"
                                                    Minimum="0"
                                                    AutomationProperties.Name="{loc:Str Key=Settings_Input}"
                                                    Value="{x:Bind InputPerMillion, Mode=TwoWay}" />
                                                <NumberBox
                                                    Grid.Column="2"
                                                    Minimum="0"
                                                    AutomationProperties.Name="{loc:Str Key=Settings_Output}"
                                                    Value="{x:Bind OutputPerMillion, Mode=TwoWay}" />
                                                <NumberBox
                                                    Grid.Column="3"
                                                    Minimum="0"
                                                    AutomationProperties.Name="{loc:Str Key=Settings_CacheWrite}"
                                                    Value="{x:Bind CacheWritePerMillion, Mode=TwoWay}" />
                                                <NumberBox
                                                    Grid.Column="4"
                                                    Minimum="0"
                                                    AutomationProperties.Name="{loc:Str Key=Settings_CacheRead}"
                                                    Value="{x:Bind CacheReadPerMillion, Mode=TwoWay}" />

                                                <Button
                                                    Grid.Column="5"
                                                    AutomationProperties.Name="{loc:Str Key=Common_Delete}"
                                                    ToolTipService.ToolTip="{loc:Str Key=Common_Delete}"
                                                    Click="OnRemovePriceClick"
                                                    DataContext="{x:Bind}">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 단축키: 알려주지 않으면 아무도 모른다 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Str Key=Settings_Shortcuts}" Style="{StaticResource SectionTitleText}" />

                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Key=Settings_ShortcutNav}" Style="{StaticResource MonoText}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Str Key=Settings_ShortcutNavWhat}" Style="{StaticResource MutedText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Key=Settings_ShortcutSearch}" Style="{StaticResource MonoText}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Str Key=Settings_ShortcutSearchWhat}" Style="{StaticResource MutedText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str Key=Settings_ShortcutEsc}" Style="{StaticResource MonoText}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Str Key=Settings_ShortcutEscWhat}" Style="{StaticResource MutedText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Str Key=Settings_ShortcutRefresh}" Style="{StaticResource MonoText}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Str Key=Settings_ShortcutRefreshWhat}" Style="{StaticResource MutedText}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Str Key=Settings_ShortcutSave}" Style="{StaticResource MonoText}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Str Key=Settings_ShortcutSaveWhat}" Style="{StaticResource MutedText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 표시와 인덱스 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Str Key=Settings_DisplayAndIndex}" Style="{StaticResource SectionTitleText}" />

                        <ComboBox
                            Header="{loc:Str Key=Settings_Theme}"
                            Width="200"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="ThemeCombo"
                            ItemsSource="{x:Bind ViewModel.Themes}"
                            SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />

                        <NumberBox
                            Header="{loc:Str Key=Settings_TerminalFontSize}"
                            Width="200"
                            HorizontalAlignment="Left"
                            Minimum="8"
                            Maximum="28"
                            SpinButtonPlacementMode="Compact"
                            AutomationProperties.AutomationId="TerminalFontSizeBox"
                            Value="{x:Bind ViewModel.TerminalFontSize, Mode=TwoWay}" />

                        <TextBlock
                            Text="{loc:Str Key=Settings_NoWebView2}"
                            Style="{StaticResource MutedText}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Visibility="{x:Bind ViewModel.NoWebViewVisibility}" />

                        <Button
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="RebuildIndexButton"
                            Command="{x:Bind ViewModel.RebuildIndexCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="{loc:Str Key=Settings_RebuildIndex}" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- 정보 · 개인정보 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Str Key=About_Title}" Style="{StaticResource SectionTitleText}" />

                        <TextBlock
                            AutomationProperties.AutomationId="AboutVersion"
                            Text="{x:Bind ViewModel.AppVersion}"
                            Style="{StaticResource MutedText}" />

                        <TextBlock Text="{loc:Str Key=About_Privacy}" Style="{StaticResource PageSubtitleText}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Str Key=About_WhereTitle}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{x:Bind ViewModel.SettingsFilePath}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.DefaultIndexDatabasePath}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.ProfilesPath}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="{loc:Str Key=About_Credits}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 저장 바 (항상 보인다) -->
        <Border
            Grid.Row="1"
            Padding="0,12,0,0"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Content="{loc:Str Key=Common_Save}"
                    Style="{ThemeResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="SaveSettingsButton"
                    Command="{x:Bind ViewModel.SaveCommand}" />

                <Button
                    Grid.Column="1"
                    Content="{loc:Str Key=Settings_Reset}"
                    AutomationProperties.AutomationId="ReloadSettingsButton"
                    Command="{x:Bind ViewModel.LoadCommand}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SettingsStatus"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource MutedText}" />
            </Grid>
        </Border>
    </Grid>
</Page>
