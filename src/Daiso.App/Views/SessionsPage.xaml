<Page
    x:Class="Daiso.App.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 검색 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{loc:Str Key=Sessions_SearchPlaceholder}"
                AutomationProperties.AutomationId="SearchBox"
                KeyDown="OnSearchKeyDown" />

            <Button Grid.Column="1" Content="{loc:Str Key=Common_Search}" AutomationProperties.AutomationId="SearchButton" Command="{x:Bind ViewModel.SearchCommand}" />
            <Button Grid.Column="2" Content="{loc:Str Key=Sessions_ClearSearch}" AutomationProperties.AutomationId="ClearSearchButton" Command="{x:Bind ViewModel.ClearSearchCommand}" />
            <Button Grid.Column="3" Content="{loc:Str Key=Sessions_ReloadList}" AutomationProperties.AutomationId="ReloadButton" Command="{x:Bind ViewModel.LoadCommand}" />
        </Grid>

        <!-- 필터 바 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox
                Header="{loc:Str Key=Common_Tool}"
                Width="120"
                ItemsSource="{x:Bind ViewModel.ToolFilters}"
                SelectedIndex="{x:Bind ViewModel.ToolFilterIndex, Mode=TwoWay}" />

            <ComboBox
                Header="{loc:Str Key=Common_Period}"
                Width="140"
                ItemsSource="{x:Bind ViewModel.PeriodFilters}"
                SelectedIndex="{x:Bind ViewModel.PeriodFilterIndex, Mode=TwoWay}" />

            <NumberBox
                Header="{loc:Str Key=Sessions_MinSize}"
                Width="150"
                Minimum="0"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.MinSizeMegabytes, Mode=TwoWay}" />

            <CheckBox
                Content="{loc:Str Key=Sessions_OrphanOnly}"
                VerticalAlignment="Bottom"
                IsChecked="{x:Bind ViewModel.OrphansOnly, Mode=TwoWay}" />

            <CheckBox
                Content="{loc:Str Key=Sessions_IncludeArchived}"
                VerticalAlignment="Bottom"
                IsChecked="{x:Bind ViewModel.IncludeArchived, Mode=TwoWay}" />

            <Button
                Content="{loc:Str Key=Sessions_ApplyFilter}"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ApplyFiltersCommand}" />
        </StackPanel>

        <!-- 본문 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 프로젝트 트리 또는 검색 결과 -->
            <Border
                Grid.Column="0"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <ListView
                        x:Name="ProjectList"
                        AutomationProperties.AutomationId="ProjectList"
                        ItemsSource="{x:Bind ViewModel.Projects}"
                        SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.ProjectListVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectGroupViewModel">
                                <StackPanel Padding="0,6">
                                    <TextBlock
                                        Text="{x:Bind DisplayName}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Summary}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Opacity="0.75" />
                                    <TextBlock
                                        Text="{x:Bind Path}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Opacity="0.5"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <muxc:TreeView
                        x:Name="SearchTree"
                        SelectionMode="Single"
                        ItemInvoked="OnSearchItemInvoked"
                        Visibility="{x:Bind ViewModel.SearchTreeVisibility, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- 가운데: 세션 목록 -->
            <Border
                Grid.Column="1"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView
                    AutomationProperties.AutomationId="SessionList"
                    ItemsSource="{x:Bind ViewModel.Sessions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                    SelectionChanged="OnSessionSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionRowViewModel">
                            <Grid Padding="0,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                    MinWidth="32" />

                                <TextBlock Grid.Column="1" Text="{x:Bind ToolIcon}" FontSize="16" VerticalAlignment="Top" />

                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Text="{x:Bind FirstPromptText}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Opacity="0.75"
                                        Text="{x:Bind MetaText}" />
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.5">
                                        <Run Text="{x:Bind Session.Id}" />
                                        <Run Text=" " />
                                        <Run Text="{x:Bind Badges}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- 오른쪽: 세션 상세 / 컨텍스트 닥터 -->
            <Border
                Grid.Column="2"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <muxc:Pivot Padding="4">

                    <muxc:PivotItem Header="{loc:Str Key=Sessions_Detail}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Str Key=Sessions_Resume}" AutomationProperties.AutomationId="ResumeButton" Click="OnResumeClick" />
                                <Button Content="{loc:Str Key=Sessions_ExportMarkdown}" AutomationProperties.AutomationId="ExportButton" Click="OnExportClick" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Timeline}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MessageViewModel">
                                            <StackPanel Margin="0,0,0,10">
                                                <StackPanel Visibility="{x:Bind PlainVisibility}">
                                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6">
                                                        <Run Text="{x:Bind RoleText}" />
                                                        <Run Text="·" />
                                                        <Run Text="{x:Bind TimeText}" />
                                                    </TextBlock>
                                                    <TextBlock
                                                        Text="{x:Bind Text}"
                                                        Style="{ThemeResource BodyTextBlockStyle}"
                                                        TextWrapping="Wrap"
                                                        IsTextSelectionEnabled="True" />
                                                </StackPanel>

                                                <Expander
                                                    HorizontalAlignment="Stretch"
                                                    Visibility="{x:Bind CollapsibleVisibility}">
                                                    <Expander.Header>
                                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                                                            <Run Text="{x:Bind RoleText}" />
                                                            <Run Text="·" />
                                                            <Run Text="{x:Bind TimeText}" />
                                                        </TextBlock>
                                                    </Expander.Header>
                                                    <TextBlock
                                                        Text="{x:Bind Text}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        TextWrapping="Wrap"
                                                        IsTextSelectionEnabled="True" />
                                                </Expander>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </muxc:PivotItem>

                    <muxc:PivotItem Header="{loc:Str Key=Sessions_Context}">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox
                                        Width="120"
                                        AutomationProperties.AutomationId="ContextToolCombo"
                                        ItemsSource="{x:Bind Doctor.Tools}"
                                        SelectedIndex="{x:Bind Doctor.ToolIndex, Mode=TwoWay}" />
                                    <Button
                                        Content="{loc:Str Key=Common_Inspect}"
                                        AutomationProperties.AutomationId="InspectButton"
                                        Command="{x:Bind Doctor.InspectCommand}" />
                                </StackPanel>

                                <TextBlock
                                    AutomationProperties.AutomationId="ContextStatus"
                                    Text="{x:Bind Doctor.StatusText, Mode=OneWay}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    AutomationProperties.AutomationId="ContextTotal"
                                    Text="{x:Bind Doctor.TotalCharsText, Mode=OneWay}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                <TextBlock Text="{loc:Str Key=Sessions_FilesInOrder}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ListView
                                    AutomationProperties.AutomationId="ContextFileList"
                                    ItemsSource="{x:Bind Doctor.Files}"
                                    SelectedItem="{x:Bind Doctor.SelectedFile, Mode=TwoWay}"
                                    MaxHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ContextFileViewModel">
                                            <TextBlock
                                                Text="{x:Bind Summary}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock Text="{loc:Str Key=Sessions_SelectedFileContent}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ScrollViewer MaxHeight="200">
                                    <TextBlock
                                        AutomationProperties.AutomationId="ContextPreview"
                                        Text="{x:Bind Doctor.SelectedFileContent, Mode=OneWay}"
                                        FontFamily="Consolas"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                </ScrollViewer>

                                <TextBlock Text="{loc:Str Key=Sessions_Duplicates}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ItemsControl ItemsSource="{x:Bind Doctor.Duplicates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Text="{x:Bind}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{loc:Str Key=Sessions_Conflicts}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ItemsControl ItemsSource="{x:Bind Doctor.Conflicts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Text="{x:Bind}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{loc:Str Key=Common_Extras}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ItemsControl ItemsSource="{x:Bind Doctor.Facts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Text="{x:Bind}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </muxc:PivotItem>
                </muxc:Pivot>
            </Border>
        </Grid>

        <!-- 정리 -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{loc:Str Key=Sessions_SelectOld}" AutomationProperties.AutomationId="SelectOldButton" Click="OnSelectOldClick" />
            <Button Grid.Column="1" Content="{loc:Str Key=Sessions_SelectOrphan}" AutomationProperties.AutomationId="SelectOrphanButton" Click="OnSelectOrphanClick" />
            <Button Grid.Column="2" Content="{loc:Str Key=Sessions_SelectLarge}" AutomationProperties.AutomationId="SelectLargeButton" Click="OnSelectLargeClick" />

            <TextBlock
                Grid.Column="3"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                VerticalAlignment="Center"
                Margin="12,0"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="4" Content="{loc:Str Key=Sessions_SendToRecycleBin}" AutomationProperties.AutomationId="RecycleButton" Click="OnRecycleClick" />
            <Button Grid.Column="5" Content="{loc:Str Key=Common_PermanentDelete}" AutomationProperties.AutomationId="PermanentButton" Click="OnPermanentClick" />
        </Grid>
    </Grid>
</Page>
