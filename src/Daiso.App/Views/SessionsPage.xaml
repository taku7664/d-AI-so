<Page
    x:Class="Daiso.App.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Daiso.App.Strings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Daiso.App.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <!-- 골격은 PageBody 가 정한다: 검색(명령 줄) → 필터 줄 → 목록·상세(본문). 폭은 Wide (UI_REFACTOR_PLAN §6, §8.2) -->
    <controls:PageBody Layout="Wide">
        <controls:PageBody.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFocusSearchInvoked" />
            <KeyboardAccelerator Key="Escape" Invoked="OnClearSearchInvoked" />
        </controls:PageBody.KeyboardAccelerators>

        <controls:PageBody.Commands>
        <StackPanel Spacing="10">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{loc:Str Key=Sessions_SearchPlaceholder}"
                    AutomationProperties.AutomationId="SearchBox"
                    KeyDown="OnSearchKeyDown" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    AutomationProperties.AutomationId="SearchButton"
                    AutomationProperties.Name="{loc:Str Key=Common_Search}"
                    ToolTipService.ToolTip="{loc:Str Key=Common_SearchTip}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SearchCommand}">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="ClearSearchButton"
                    AutomationProperties.Name="{loc:Str Key=Sessions_ClearSearch}"
                    ToolTipService.ToolTip="{loc:Str Key=Sessions_ClearSearchTip}"
                    Command="{x:Bind ViewModel.ClearSearchCommand}">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="ReloadButton"
                    AutomationProperties.Name="{loc:Str Key=Sessions_ReloadList}"
                    ToolTipService.ToolTip="{loc:Str Key=Sessions_ReloadListTip}"
                    Command="{x:Bind ViewModel.LoadCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
        </controls:PageBody.Commands>

        <!-- 필터 줄 (바꾸면 바로 적용). 도구별 거르기는 탭, 나머지 축은 콤보 (UI_REFACTOR_PLAN §8.4) -->
        <controls:PageBody.Filters>
        <StackPanel Spacing="12">
        <muxc:SelectorBar x:Name="ToolTabs" SelectionChanged="OnToolTabChanged" AutomationProperties.AutomationId="ToolTabs">
            <muxc:SelectorBarItem Text="{loc:Str Key=Common_All}" IsSelected="True" AutomationProperties.AutomationId="ToolTabAll" />
            <muxc:SelectorBarItem Text="Codex" AutomationProperties.AutomationId="ToolTabCodex" />
            <muxc:SelectorBarItem Text="Claude" AutomationProperties.AutomationId="ToolTabClaude" />
            <muxc:SelectorBarItem Text="Gemini" AutomationProperties.AutomationId="ToolTabGemini" />
        </muxc:SelectorBar>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <!-- 잠긴 컨트롤은 마우스를 받지 않아 툴팁이 안 뜬다. 검색 중 잠기는 이유는 투명 테두리가 대신 말한다 -->
            <Border Background="Transparent" ToolTipService.ToolTip="{loc:Str Key=Sessions_SearchScopeHint}">
                <ComboBox
                    Header="{loc:Str Key=Sessions_ProjectFilter}"
                    MinWidth="220"
                    MaxWidth="300"
                    IsEnabled="{x:Bind ViewModel.CanPickProject, Mode=OneWay}"
                    AutomationProperties.AutomationId="ProjectCombo"
                    ItemsSource="{x:Bind ViewModel.Projects}"
                    SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectGroupViewModel">
                            <TextBlock Text="{x:Bind ComboLabel}" ToolTipService.ToolTip="{x:Bind Path}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>

            <ComboBox
                Header="{loc:Str Key=Common_Period}"
                Width="130"
                AutomationProperties.AutomationId="PeriodFilterCombo"
                ItemsSource="{x:Bind ViewModel.PeriodFilters}"
                SelectedIndex="{x:Bind ViewModel.PeriodFilterIndex, Mode=TwoWay}" />

            <!-- 자주 안 쓰는 필터는 팝오버로. 좁은 창에서 한 줄이 넘치지 않게 한다 -->
            <muxc:DropDownButton
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="MoreFiltersButton">
                <muxc:DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71C;" FontSize="13" />
                        <TextBlock Text="{loc:Str Key=Sessions_MoreFilters}" />
                    </StackPanel>
                </muxc:DropDownButton.Content>
                <muxc:DropDownButton.Flyout>
                    <Flyout>
                        <StackPanel Spacing="12" MinWidth="240">
                            <NumberBox
                                Header="{loc:Str Key=Sessions_MinSize}"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.AutomationId="MinSizeBox"
                                Value="{x:Bind ViewModel.MinSizeMegabytes, Mode=TwoWay}" />

                            <CheckBox
                                Content="{loc:Str Key=Sessions_OrphanOnly}"
                                AutomationProperties.AutomationId="OrphansOnlyCheck"
                                IsChecked="{x:Bind ViewModel.OrphansOnly, Mode=TwoWay}" />

                            <CheckBox
                                Content="{loc:Str Key=Sessions_IncludeArchived}"
                                AutomationProperties.AutomationId="IncludeArchivedCheck"
                                IsChecked="{x:Bind ViewModel.IncludeArchived, Mode=TwoWay}" />

                            <Button
                                Content="{loc:Str Key=Sessions_ResetFilters}"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="ResetFiltersButton"
                                Command="{x:Bind ViewModel.ResetFiltersCommand}" />
                        </StackPanel>
                    </Flyout>
                </muxc:DropDownButton.Flyout>
            </muxc:DropDownButton>

            <muxc:ProgressRing
                Width="18"
                Height="18"
                VerticalAlignment="Bottom"
                Margin="0,0,0,6"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>
        </StackPanel>
        </controls:PageBody.Filters>

        <!-- 본문: 목록 · 구분선 · 상세. 칸마다 따로 스크롤한다 -->
        <controls:PageBody.Body>
        <Grid ColumnSpacing="14">
            <!-- 목록 칸은 세 2단 화면이 같은 값(ListPaneWidth). 구분선을 끌어 조절하고 설정에 기억한다. 상세는 남은 폭 전부 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ListPaneWidth}" MinWidth="{StaticResource ListPaneMinWidth}" MaxWidth="{StaticResource ListPaneMaxWidth}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 목록 (일반 목록 또는 검색 결과 트리) -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 머리: 제목·건수 왼쪽, 체크 도구 오른쪽(전체 체크 · 골라 체크 · 선택 수 · 휴지통 · 영구 삭제). 아이콘만, 툴팁으로 설명 -->
                    <Grid Grid.Row="0" Margin="12,10,12,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitleText}"
                            Text="{x:Bind ViewModel.ListHeaderText, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedText}"
                            Text="{x:Bind ViewModel.SessionCountText, Mode=OneWay}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <CheckBox
                                MinWidth="0"
                                Padding="0"
                                Margin="0,0,2,0"
                                IsThreeState="False"
                                AutomationProperties.AutomationId="CheckAllBox"
                                AutomationProperties.Name="{loc:Str Key=Sessions_CheckAll}"
                                ToolTipService.ToolTip="{loc:Str Key=Sessions_CheckAllTip}"
                                IsChecked="{x:Bind ViewModel.AllChecked, Mode=OneWay}"
                                Click="OnCheckAllClick" />
                            <muxc:DropDownButton Padding="6" AutomationProperties.AutomationId="SelectMenuButton" AutomationProperties.Name="{loc:Str Key=Sessions_SelectMenu}" ToolTipService.ToolTip="{loc:Str Key=Sessions_SelectMenuTip}">
                                <muxc:DropDownButton.Content>
                                    <FontIcon Glyph="&#xE762;" FontSize="14" />
                                </muxc:DropDownButton.Content>
                                <muxc:DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="{loc:Str Key=Sessions_SelectOld}" AutomationProperties.AutomationId="SelectOldButton" Click="OnSelectOldClick" />
                                        <MenuFlyoutItem Text="{loc:Str Key=Sessions_SelectOrphan}" AutomationProperties.AutomationId="SelectOrphanButton" Click="OnSelectOrphanClick" />
                                        <MenuFlyoutItem Text="{loc:Str Key=Sessions_SelectLarge}" AutomationProperties.AutomationId="SelectLargeButton" Click="OnSelectLargeClick" />
                                    </MenuFlyout>
                                </muxc:DropDownButton.Flyout>
                            </muxc:DropDownButton>
                            <Border Style="{StaticResource PillBorder}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasChecked, Mode=OneWay}">
                                <TextBlock AutomationProperties.AutomationId="CheckedCountText" Text="{x:Bind ViewModel.CheckedText, Mode=OneWay}" FontSize="12" />
                            </Border>
                            <Button
                                Padding="6"
                                Background="Transparent"
                                BorderThickness="0"
                                AutomationProperties.AutomationId="RecycleButton"
                                AutomationProperties.Name="{loc:Str Key=Sessions_SendToRecycleBin}"
                                ToolTipService.ToolTip="{loc:Str Key=Sessions_SendToRecycleBin}"
                                IsEnabled="{x:Bind ViewModel.HasChecked, Mode=OneWay}"
                                Click="OnRecycleClick">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                            <Button
                                Padding="6"
                                Background="Transparent"
                                BorderThickness="0"
                                AutomationProperties.AutomationId="PermanentButton"
                                AutomationProperties.Name="{loc:Str Key=Common_PermanentDelete}"
                                ToolTipService.ToolTip="{loc:Str Key=Sessions_PermanentDeleteTip}"
                                IsEnabled="{x:Bind ViewModel.HasChecked, Mode=OneWay}"
                                Click="OnPermanentClick">
                                <FontIcon Glyph="&#xE107;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <muxc:TreeView
                            x:Name="SearchTree"
                            Padding="8,0,8,8"
                            SelectionMode="Single"
                            ItemInvoked="OnSearchItemInvoked"
                            Visibility="{x:Bind ViewModel.SearchTreeVisibility, Mode=OneWay}" />

                        <ListView
                            AutomationProperties.AutomationId="SessionList"
                            Visibility="{x:Bind ViewModel.ProjectListVisibility, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Sessions}"
                            SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                            SelectionChanged="OnSessionSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionRowViewModel">
                                    <Grid Padding="0,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            MinWidth="28"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind TitleText}"
                                            IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />

                                        <controls:ToolIcon Grid.Column="1" Kind="{x:Bind Session.Tool}" Size="26" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock
                                                Text="{x:Bind TitleText}"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind FirstPromptText}" />
                                            <TextBlock
                                                Style="{StaticResource MutedText}"
                                                Text="{x:Bind MetaText}"
                                                ToolTipService.ToolTip="{x:Bind IdShort}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="3"
                                            Style="{StaticResource PillBorder}"
                                            Visibility="{x:Bind HasBadges}">
                                            <TextBlock Text="{x:Bind Badges}" FontSize="12" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border
                            Style="{StaticResource NoticeBorder}"
                            Margin="16"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind ViewModel.IsListEmpty, Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <!-- 인덱싱 중이면 진행을 알려준다. 첫 실행에는 목록이 비어 있는 게 정상이다 -->
                                <StackPanel Spacing="8" Visibility="{x:Bind Shell.IsIndexing, Mode=OneWay}">
                                    <TextBlock Text="{loc:Str Key=Sessions_Indexing}" Style="{StaticResource PageSubtitleText}" />
                                    <TextBlock
                                        Text="{x:Bind Shell.StatusMessage, Mode=OneWay}"
                                        Style="{StaticResource MutedText}"
                                        TextTrimming="CharacterEllipsis" />
                                    <muxc:ProgressBar
                                        Width="240"
                                        HorizontalAlignment="Left"
                                        Value="{x:Bind Shell.StatusPercent, Mode=OneWay}"
                                        IsIndeterminate="False" />
                                </StackPanel>

                                <TextBlock
                                    Text="{loc:Str Key=Sessions_EmptyList}"
                                    Style="{StaticResource PageSubtitleText}"
                                    Visibility="{x:Bind Shell.IsNotIndexing, Mode=OneWay}" />

                                <Button
                                    Content="{loc:Str Key=Sessions_ReloadList}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="EmptyReloadButton"
                                    Visibility="{x:Bind Shell.IsNotIndexing, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.LoadCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <controls:PaneSplitter Grid.Column="1" SettingsKey="Sessions" />

            <!-- 오른쪽: 상세 · 컨텍스트 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="4,0,4,4">
                <muxc:Pivot Padding="8,4,8,0">

                    <muxc:PivotItem Header="{loc:Str Key=Sessions_Detail}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Style="{ThemeResource AccentButtonStyle}"
                                    AutomationProperties.AutomationId="ResumeButton"
                                    IsEnabled="{x:Bind ViewModel.HasSelectedSession, Mode=OneWay}"
                                    Click="OnResumeClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                                        <TextBlock Text="{loc:Str Key=Sessions_Resume}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Content="{loc:Str Key=Sessions_ExportMarkdown}"
                                    AutomationProperties.AutomationId="ExportButton"
                                    IsEnabled="{x:Bind ViewModel.HasSelectedSession, Mode=OneWay}"
                                    Click="OnExportClick" />

                            </StackPanel>

                            <CheckBox
                                Grid.Row="1"
                                Content="{loc:Str Key=Sessions_ShowToolCalls}"
                                AutomationProperties.AutomationId="ShowToolCallsCheck"
                                IsChecked="{x:Bind ViewModel.ShowToolCalls, Mode=TwoWay}" />

                            <Border
                                Grid.Row="2"
                                Style="{StaticResource NoticeBorder}"
                                VerticalAlignment="Top"
                                Visibility="{x:Bind ViewModel.NoSelection, Mode=OneWay}">
                                <TextBlock Text="{loc:Str Key=Sessions_PickHint}" Style="{StaticResource PageSubtitleText}" />
                            </Border>

                            <StackPanel
                                Grid.Row="2"
                                Spacing="10"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Visibility="{x:Bind ViewModel.IsTimelineLoading, Mode=OneWay}">
                                <muxc:ProgressRing Width="18" Height="18" IsActive="True" />
                                <TextBlock
                                    Text="{loc:Str Key=Sessions_TimelineLoading}"
                                    Style="{StaticResource PageSubtitleText}"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <Border
                                Grid.Row="2"
                                Style="{StaticResource NoticeBorder}"
                                VerticalAlignment="Top"
                                Visibility="{x:Bind ViewModel.IsTimelineEmpty, Mode=OneWay}">
                                <TextBlock Text="{loc:Str Key=Sessions_TimelineEmpty}" Style="{StaticResource PageSubtitleText}" />
                            </Border>

                            <ScrollViewer
                                Grid.Row="2"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{x:Bind ViewModel.HasTimeline, Mode=OneWay}">
                                <StackPanel Spacing="10">
                                    <Border
                                        Style="{StaticResource NoticeBorder}"
                                        Visibility="{x:Bind ViewModel.IsTimelineTruncated, Mode=OneWay}">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.TimelineTruncatedText}"
                                            Style="{StaticResource PageSubtitleText}" />
                                    </Border>

                                <!-- 보이는 것만 그린다. 메시지 2000개를 한 번에 만들면 세션 하나 여는 데 몇 초가 걸린다 -->
                                <ItemsRepeater
                                    AutomationProperties.AutomationId="TimelineList"
                                    ItemsSource="{x:Bind ViewModel.Timeline, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="0" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MessageViewModel">
                                            <Grid Margin="0,0,0,12" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Rectangle
                                                    Grid.Column="0"
                                                    Width="3"
                                                    RadiusX="1.5"
                                                    RadiusY="1.5"
                                                    VerticalAlignment="Stretch"
                                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind UserBarVisibility}" />

                                                <StackPanel Grid.Column="1">
                                                <StackPanel Visibility="{x:Bind PlainVisibility}" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Style="{StaticResource PillBorder}">
                                                            <TextBlock
                                                                Text="{x:Bind RoleText}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock
                                                            Text="{x:Bind TimeText}"
                                                            Style="{StaticResource MutedText}"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Text="{x:Bind DisplayText, Mode=OneWay}"
                                                        Style="{ThemeResource BodyTextBlockStyle}"
                                                        TextWrapping="Wrap"
                                                        IsTextSelectionEnabled="True" />
                                                    <HyperlinkButton
                                                        Content="{x:Bind MoreText, Mode=OneWay}"
                                                        Visibility="{x:Bind IsTruncated}"
                                                        Command="{x:Bind ToggleExpandedCommand}"
                                                        Padding="0"
                                                        FontSize="12" />
                                                </StackPanel>

                                                <Expander
                                                    HorizontalAlignment="Stretch"
                                                    Visibility="{x:Bind CollapsibleVisibility}">
                                                    <Expander.Header>
                                                        <TextBlock Style="{StaticResource MutedText}">
                                                            <Run Text="{x:Bind RoleText}" />
                                                            <Run Text="·" />
                                                            <Run Text="{x:Bind TimeText}" />
                                                        </TextBlock>
                                                    </Expander.Header>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock
                                                            Text="{x:Bind DisplayText, Mode=OneWay}"
                                                            Style="{StaticResource MonoText}"
                                                            TextTrimming="None"
                                                            TextWrapping="Wrap"
                                                            IsTextSelectionEnabled="True" />
                                                        <HyperlinkButton
                                                            Content="{x:Bind MoreText, Mode=OneWay}"
                                                            Visibility="{x:Bind IsTruncated}"
                                                            Command="{x:Bind ToggleExpandedCommand}"
                                                            Padding="0"
                                                            FontSize="12" />
                                                    </StackPanel>
                                                </Expander>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </muxc:PivotItem>

                    <muxc:PivotItem Header="{loc:Str Key=Sessions_Context}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox
                                        Width="120"
                                        AutomationProperties.AutomationId="ContextToolCombo"
                                        AutomationProperties.Name="{loc:Str Key=Common_Tool}"
                                        ItemsSource="{x:Bind Doctor.Tools}"
                                        SelectedIndex="{x:Bind Doctor.ToolIndex, Mode=TwoWay}" />
                                    <Button
                                        Content="{loc:Str Key=Common_Inspect}"
                                        AutomationProperties.AutomationId="InspectButton"
                                        Command="{x:Bind Doctor.InspectCommand}" />
                                    <muxc:ProgressRing
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind Doctor.IsBusy, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock
                                    AutomationProperties.AutomationId="ContextStatus"
                                    Text="{x:Bind Doctor.StatusText, Mode=OneWay}"
                                    Style="{StaticResource PageSubtitleText}" />

                                <TextBlock
                                    AutomationProperties.AutomationId="ContextTotal"
                                    Text="{x:Bind Doctor.TotalCharsText, Mode=OneWay}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

                                <TextBlock Text="{loc:Str Key=Sessions_FilesInOrder}" Style="{StaticResource SectionTitleText}" />
                                <ListView
                                    AutomationProperties.AutomationId="ContextFileList"
                                    ItemsSource="{x:Bind Doctor.Files}"
                                    SelectedItem="{x:Bind Doctor.SelectedFile, Mode=TwoWay}"
                                    MaxHeight="200">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ContextFileViewModel">
                                            <Grid
                                                ColumnSpacing="8"
                                                Padding="0,4"
                                                Opacity="{x:Bind Dim}"
                                                ToolTipService.ToolTip="{x:Bind Summary}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon
                                                    Grid.Column="0"
                                                    Glyph="{x:Bind StateGlyph}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind PathText}"
                                                    Style="{StaticResource MonoText}" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind CharsText}"
                                                    Style="{StaticResource NumberText}"
                                                    FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock Text="{loc:Str Key=Sessions_SelectedFileContent}" Style="{StaticResource SectionTitleText}" />
                                <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Auto">
                                    <TextBlock
                                        AutomationProperties.AutomationId="ContextPreview"
                                        Text="{x:Bind Doctor.SelectedFileContent, Mode=OneWay}"
                                        Style="{StaticResource MonoText}"
                                        TextTrimming="None"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                </ScrollViewer>

                                <TextBlock Text="{loc:Str Key=Sessions_Duplicates}" Style="{StaticResource SectionTitleText}" />
                                <ItemsControl ItemsSource="{x:Bind Doctor.Duplicates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Text="{x:Bind}"
                                                Style="{StaticResource MutedText}"
                                                TextTrimming="None"
                                                TextWrapping="Wrap"
                                                Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{loc:Str Key=Sessions_Conflicts}" Style="{StaticResource SectionTitleText}" />
                                <ItemsControl ItemsSource="{x:Bind Doctor.Conflicts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Text="{x:Bind}"
                                                Style="{StaticResource MutedText}"
                                                TextTrimming="None"
                                                TextWrapping="Wrap"
                                                Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{loc:Str Key=Common_Extras}" Style="{StaticResource SectionTitleText}" />
                                <ItemsControl ItemsSource="{x:Bind Doctor.Facts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Text="{x:Bind}"
                                                Style="{StaticResource MutedText}"
                                                TextTrimming="None"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </muxc:PivotItem>
                </muxc:Pivot>
            </Border>
        </Grid>
        </controls:PageBody.Body>
    </controls:PageBody>
</Page>
