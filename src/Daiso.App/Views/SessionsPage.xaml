<Page
    x:Class="Daiso.App.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Daiso.App.ViewModels">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 검색 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="세션 본문 검색 (2글자 이상)"
                AutomationProperties.AutomationId="SearchBox"
                KeyDown="OnSearchKeyDown" />

            <Button Grid.Column="1" Content="검색" AutomationProperties.AutomationId="SearchButton" Command="{x:Bind ViewModel.SearchCommand}" />
            <Button Grid.Column="2" Content="지우기" AutomationProperties.AutomationId="ClearSearchButton" Command="{x:Bind ViewModel.ClearSearchCommand}" />
            <Button Grid.Column="3" Content="목록 새로 읽기" AutomationProperties.AutomationId="ReloadButton" Command="{x:Bind ViewModel.LoadCommand}" />
        </Grid>

        <!-- 필터 바 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox
                Header="도구"
                Width="120"
                ItemsSource="{x:Bind ViewModel.ToolFilters}"
                SelectedIndex="{x:Bind ViewModel.ToolFilterIndex, Mode=TwoWay}" />

            <ComboBox
                Header="기간"
                Width="140"
                ItemsSource="{x:Bind ViewModel.PeriodFilters}"
                SelectedIndex="{x:Bind ViewModel.PeriodFilterIndex, Mode=TwoWay}" />

            <NumberBox
                Header="최소 크기 (MB)"
                Width="150"
                Minimum="0"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.MinSizeMegabytes, Mode=TwoWay}" />

            <CheckBox
                Content="고아만"
                VerticalAlignment="Bottom"
                IsChecked="{x:Bind ViewModel.OrphansOnly, Mode=TwoWay}" />

            <CheckBox
                Content="아카이브 포함"
                VerticalAlignment="Bottom"
                IsChecked="{x:Bind ViewModel.IncludeArchived, Mode=TwoWay}" />

            <Button
                Content="필터 적용"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ApplyFiltersCommand}" />
        </StackPanel>

        <!-- 본문 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 프로젝트 트리 또는 검색 결과 -->
            <Border
                Grid.Column="0"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <ListView
                        x:Name="ProjectList"
                        AutomationProperties.AutomationId="ProjectList"
                        ItemsSource="{x:Bind ViewModel.Projects}"
                        SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.ProjectListVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectGroupViewModel">
                                <StackPanel Padding="0,6">
                                    <TextBlock
                                        Text="{x:Bind DisplayName}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Summary}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Opacity="0.75" />
                                    <TextBlock
                                        Text="{x:Bind Path}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Opacity="0.5"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <muxc:TreeView
                        x:Name="SearchTree"
                        SelectionMode="Single"
                        ItemInvoked="OnSearchItemInvoked"
                        Visibility="{x:Bind ViewModel.SearchTreeVisibility, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- 가운데: 세션 목록 -->
            <Border
                Grid.Column="1"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView
                    AutomationProperties.AutomationId="SessionList"
                    ItemsSource="{x:Bind ViewModel.Sessions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                    SelectionChanged="OnSessionSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionRowViewModel">
                            <Grid Padding="0,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                    MinWidth="32" />

                                <TextBlock Grid.Column="1" Text="{x:Bind ToolIcon}" FontSize="16" VerticalAlignment="Top" />

                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Text="{x:Bind FirstPromptText}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.75">
                                        <Run Text="{x:Bind ToolName}" />
                                        <Run Text="·" />
                                        <Run Text="{x:Bind ModifiedText}" />
                                        <Run Text="·" />
                                        <Run Text="{x:Bind SizeText}" />
                                        <Run Text="· 사용자" />
                                        <Run Text="{x:Bind Session.UserMessageCount}" />
                                        <Run Text="· 어시스턴트" />
                                        <Run Text="{x:Bind Session.AssistantMessageCount}" />
                                    </TextBlock>
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.5">
                                        <Run Text="{x:Bind Session.Id}" />
                                        <Run Text=" " />
                                        <Run Text="{x:Bind Badges}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- 오른쪽: 상세 -->
            <Border
                Grid.Column="2"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid Padding="12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="세션 상세"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="이어서 열기" AutomationProperties.AutomationId="ResumeButton" Click="OnResumeClick" />
                        <Button Content="Markdown 내보내기" AutomationProperties.AutomationId="ExportButton" Click="OnExportClick" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Timeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MessageViewModel">
                                    <StackPanel Margin="0,0,0,10">
                                        <StackPanel Visibility="{x:Bind PlainVisibility}">
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6">
                                                <Run Text="{x:Bind RoleText}" />
                                                <Run Text="·" />
                                                <Run Text="{x:Bind TimeText}" />
                                            </TextBlock>
                                            <TextBlock
                                                Text="{x:Bind Text}"
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True" />
                                        </StackPanel>

                                        <Expander
                                            HorizontalAlignment="Stretch"
                                            Visibility="{x:Bind CollapsibleVisibility}">
                                            <Expander.Header>
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                                                    <Run Text="{x:Bind RoleText}" />
                                                    <Run Text="·" />
                                                    <Run Text="{x:Bind TimeText}" />
                                                </TextBlock>
                                            </Expander.Header>
                                            <TextBlock
                                                Text="{x:Bind Text}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True" />
                                        </Expander>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 정리 -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="오래된 것 선택" AutomationProperties.AutomationId="SelectOldButton" Click="OnSelectOldClick" />
            <Button Grid.Column="1" Content="고아 선택" AutomationProperties.AutomationId="SelectOrphanButton" Click="OnSelectOrphanClick" />
            <Button Grid.Column="2" Content="큰 것 선택" AutomationProperties.AutomationId="SelectLargeButton" Click="OnSelectLargeClick" />

            <TextBlock
                Grid.Column="3"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                VerticalAlignment="Center"
                Margin="12,0"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="4" Content="휴지통으로 보내기" AutomationProperties.AutomationId="RecycleButton" Click="OnRecycleClick" />
            <Button Grid.Column="5" Content="영구 삭제" AutomationProperties.AutomationId="PermanentButton" Click="OnPermanentClick" />
        </Grid>
    </Grid>
</Page>
