{
  "compilerOptions": {
    "target": "ES2023",
    // electron.d.ts 가 DOM 타입을 쓴다. 메인 코드에서 DOM 을 쓰지는 않는다
    "lib": ["ES2023", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "rootDir": "src",
    "outDir": "out",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src"]
}
